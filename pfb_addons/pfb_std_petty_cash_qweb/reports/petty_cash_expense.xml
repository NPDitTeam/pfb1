<odoo>
    <!-- Header -->
    <template id="external_all_layout_standard">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style"
             style="margin-bottom: 0px !important;">
            <style>
                table, td, th {
                border: none !important;
                }
                .table-border{
                border: 1px solid #000000 !important;
                border-collapse: collapse;
                }

                .column140{
                color: #090909;
                width:140px;
                }
                .column100 {
                color: #090909;
                width:100px;
                }
                .column260{
                color: #090909;
                width:260px;
                padding-left: 20px;
                }
                .column550{
                width:550px;
                }
                .column410{
                color: #090909;
                width:475px;
                }
                .column130{
                color: #090909;
                width:130px;
                font-size:16px;
                }
                .column120 {
                color: #090909;
                width:120px;
                }
                .column320{
                width:320px;
                }
                .column290 {
                color: #090909;
                width:290px;
                }
                .column50 {
                color: #090909;
                width:50px;
                }
                .column60 {
                color: #090909;
                width:60px;
                }
                .column59 {
                color: #090909;
                width:59px;
                }
                .column70 {
                color: #090909;
                width:70px;
                }
                .column80 {
                color: #090909;
                width:80px;
                }
                .column370{
                width:370px;
                }
                .column330{
                width:330px;
                }
                .column350{
                width:350px;
                }
                .watermark1 {
                position: fixed;
                top:493px;
                left: 15px;
                }
                .column170{
                color: #090909;
                width:170px;
                }
                .column190{
                color: #090909;
                width:190px;
                }
                .column180{
                width:180px;
                }
                .column50{
                width:50px;
                }
                .header_text {
                font-size:24px;
                }

                .header2 {
                border-left:2px solid white;
                }

                .header3 {
                display: block;
                width: 80px;
                border:2px solid black;
                font-size:24px;
                }
            </style>
            <table class="table table-sm" style="margin-bottom: 0px !important;">
                <tr>
                    <td class="column320 header2 text-left" style="font-size:22px;">
                        <br/>
                        <strong>
                            <span style="font-size:30px;" t-field="company.partner_id.name"/>
                        </strong>
                        <br/>
                        สรุปรายการเบิกชดเชยเงินสดย่อย
                    </td>
                </tr>
            </table>

        </div>
        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>

        <div t-attf-class="footer  o_company_#{company.id}_layout">
            <style>
                table, td, th {
                border: none !important;
                }
                .table-border tr td{
                border: 1px solid #000000 !important;
                border-collapse: collapse;
                }
                .column70 {
                width:70px;
                }
                .column370 {
                width:370px;
                }
                .column320 {
                width:320px;
                }
                .column120 {
                width:120px;
                }
                .no_border{
                border-bottom: 2px solid white;
                }
                .no_border tr{
                border-top: 2px solid white;
                border-bottom: 2px solid white;
                }
                .no_border td{
                border-left: 2px solid white;
                border-right: 2px solid white;
                }
            </style>
            <table width="100%" style="font-size:20px;">
                <tr>
                    <td width="20%" align="center">
                        <br/>
                        <br/>
                        <b>____________________________</b>
                        <br/>
                        <b>Prepared By/Date</b>
                        <br/>
                        <!--                        <t t-esc="o_value['current_date']"/>-->
                    </td>
                    <td width="5%" style="color:white">_</td>
                    <td width="20%" align="center">
                        <br/>
                        <br/>
                        <b>____________________________</b>
                        <br/>
                        <b>Checked By/Date</b>
                    </td>
                    <td width="5%" style="color:white">_</td>
                    <td width="20%" align="center">
                        <br/>
                        <br/>
                        <b>____________________________</b>
                        <br/>
                        <b>Approved By/Date</b>
                    </td>
                    <td width="5%" style="color:white">_</td>
                    <td width="20%" align="center">
                        <br/>
                        <br/>
                        <b>____________________________</b>
                        <br/>
                        <b>Approved By/Date</b>
                    </td>
                    <td width="5%" style="color:white">_</td>
                </tr>
            </table>
            <table class="table table-sm  o_main_table">
                <tr>
                    <td class="text-left">
                    </td>
                    <td class="text-right">
                        <div t-if="report_type == 'pdf'" class="text-right" style="vertical-align: bottom;">
                            หน้าที่ :
                            <span class="page"/>
                            /
                            <span class="topage"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="external_all_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <t t-call="pfb_std_petty_cash_qweb.external_all_layout_standard">
            <t t-raw="0"/>
        </t>
    </template>

    <template id="report_po">
        <t t-call="web.html_container">
            <t t-call="pfb_std_petty_cash_qweb.external_all_layout">
                <style>
                    table, td, th {
                    table-layout: fixed;
                    width: 100%;
                    }

                    .table thead tr {
                    border: 1px solid black;

                    }
                    .table tbody td {
                    border: 1px solid black;
                    }
                    .table-bordered {
                    border: 1px solid black;
                    }
                    .table-border {
                    border: 1px solid black !important;
                    border-collapse: collapse;
                    }


                    .column30{
                    width:30px;
                    }
                    .column35{
                    width:35px;
                    }

                    .column140{
                    color: #090909;
                    width:140px;
                    }
                    .column100 {
                    color: #090909;
                    width:100px;
                    }
                    .column200{
                    color: #090909;
                    width:200px;
                    }
                    .column260{
                    color: #090909;
                    width:260px;
                    padding-left: 20px;
                    }

                    .column130{
                    color: #090909;
                    width:130px;
                    font-size:16px;
                    }
                    .column120 {
                    color: #090909;
                    width:120px;
                    }

                    .column50 {
                    color: #090909;
                    width:50px;
                    }
                    .column60 {
                    color: #090909;
                    width:60px;
                    }
                    .column65 {
                    color: #090909;
                    width:65px;
                    }
                    .column70 {
                    color: #090909;
                    width:70px;
                    }
                    .column80 {
                    color: #090909;
                    width:80px;
                    }

                    .watermark1 {
                    position: fixed;
                    top: 298px;
                    }
                    .column170{
                    color: #090909;
                    width:170px;
                    }
                    .column190{
                    color: #090909;
                    width:190px;
                    }
                    .column180{
                    width:180px;
                    }
                    .column50{
                    width:50px;
                    }
                    .header_text {
                    font-size:16px;
                    }
                    .header {
                    border: 1px solid #000000;
                    padding: 2px;
                    border-radius: 15px;
                    }
                    .header2 {
                    border-left:2px solid white;
                    }
                    .header3 {
                    text-align: center;
                    border: 1px solid black !important;
                    height: 25px;
                    }
                    .line_ids {
                    border: 1px solid black !important;
                    font-size: 20px !important;
                    }
                    .line_ids_right {
                    border-right: 1px solid white !important;}

                </style>
                <div class="page">
                    <br/>
                    <br/>
                    <table class="table_asset table table-sm table-condensed">
                        <thead style="font-size:22px; !important;">
                            <tr style="border: 1px solid black !important;">
                                <td class="column60 text-center header3" style="vertical-align: middle;">
                                    <span>Petty Cash</span>
                                </td>
                                <td class="column60 text-center header3" style="vertical-align: middle;">
                                    <span>Date</span>
                                </td>
                                <td class="column60 text-center header3" style="vertical-align: middle;">
                                    <span>Voucher No.</span>
                                </td>
                                <td class="column200 text-center header3" style="vertical-align: middle;">
                                    <span>Description</span>
                                </td>
                                <td class="column60 text-center header3" style="vertical-align: middle;">
                                    <span>Amount</span>
                                </td>
                                <td class="column60 text-center header3" style="vertical-align: middle;">
                                    <span>Withholding tax</span>
                                </td>
                                <td class="column60 text-center header3" style="vertical-align: middle;">
                                    <span>Payment Amount</span>
                                </td>
                                <td class="column35 text-center header3" style="vertical-align: middle;">
                                    <span>State</span>
                                </td>
                            </tr>
                        </thead>
                        <tbody name="line_body" class="line_body">
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td class="text-center line_ids" style="vertical-align: top;">
                                        <span t-esc="o.petty_cash_id.petty_name"/>
                                    </td>
                                    <td class="text-left line_ids" style="vertical-align: top;">
                                        <t t-set="year" t-value="(int((o.date).strftime('%Y')))+543"/>
                                        <t t-set="date"
                                           t-value="'%s/%s' %((o.date).strftime('%d/%m'),year)"/>
                                        <t t-esc="order_date"/>
                                        <span t-esc="date"/>
                                    </td>
                                    <td class="text-left line_ids" style="vertical-align: top;">
                                        <span t-esc="o.expense_name"/>
                                    </td>
                                    <td class="text-left line_ids" style="vertical-align: middle;">
                                        <t t-foreach="o.expense_line" t-as="line">
                                            <span t-esc="line.name"/>
                                            <br/>
                                        </t>
                                    </td>
                                    <td class="text-right line_ids" style="vertical-align: top;">
                                        <span t-esc="'{0:,.2f}'.format(o.amount_untaxed)"/>
                                    </td>
                                    <td class="text-right line_ids" style="vertical-align: top;">
                                        <span t-esc="'{0:,.2f}'.format(o.amount_wht)"/>
                                    </td>
                                    <td class="text-right line_ids" style="vertical-align: top;">
                                        <span t-esc="'{0:,.2f}'.format(o.amount_payment)"/>
                                    </td>
                                    <td class="text-left line_ids" style="vertical-align: top;">
                                        <span t-esc="o.state"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <t t-set="sum_total3" t-value="0"/>
                                <t t-set="sum_total2" t-value="0"/>
                                <t t-set="sum_total" t-value="0"/>
                                <t t-foreach="docs" t-as="line">
                                    <t t-set="sum_total" t-value="sum_total + line.amount_untaxed"/>
                                    <t t-set="sum_total2" t-value="sum_total2 + line.amount_wht"/>
                                    <t t-set="sum_total3" t-value="sum_total3 + line.amount_payment"/>
                                </t>
                                <td class="text-right line_ids" style="vertical-align: middle;" colspan="4">
                                    Total
                                </td>
                                <td class="text-right line_ids" style="vertical-align: middle;">
                                    <span t-esc="'{0:,.2f}'.format(sum_total)"/>
                                </td>
                                <td class="text-right line_ids" style="vertical-align: middle;">
                                    <span t-esc="'{0:,.2f}'.format(sum_total2)"/>
                                </td>
                                <td class="text-right line_ids" style="vertical-align: middle;">
                                    <span t-esc="'{0:,.2f}'.format(sum_total3)"/>
                                </td>
                                <td class="text-left line_ids" style="vertical-align: middle;">

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
