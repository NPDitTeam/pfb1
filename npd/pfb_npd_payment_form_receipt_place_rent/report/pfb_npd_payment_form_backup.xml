            <tr>
                <td colspan="3" class="line-distance">
                    <p>
                        ชำระเงินโดย
                    </p>

                    <!-- ตรวจสอบ "เงินสด" -->
                    <p class="flex-item2">
                        <input type="checkbox"
                               t-att-checked="doc.payment_method_one_id and doc.payment_method_one_id.type == 'cash' or (doc.is_payment_multi and 'cash' in [payment.payment_method_id.type for payment in doc.paid_ids])"
                               class="mr-1"/>
                        <span>เงินสด</span>
                    </p>

                    <!-- ตรวจสอบ "โอนเงิน" -->
                    <p class="flex-item2">
                        <input type="checkbox"
                               t-att-checked="doc.payment_method_one_id and doc.payment_method_one_id.type == 'bank' and not doc.is_payment_multi or (doc.is_payment_multi and 'bank' in [payment.payment_method_id.type for payment in doc.paid_ids])"
                               class="mr-1"/>
                        <span class="mr-1">โอนเงิน</span>


                        <!-- กรณีใช้ paid_ids -->
                        <t t-if="doc.is_payment_multi and 'bank' in [payment.payment_method_id.type for payment in doc.paid_ids]">
                          <span t-esc="doc.company_id.name"/>
                            <t t-foreach="[payment for payment in doc.paid_ids if payment.payment_method_id.type == 'bank']"
                               t-as="payment">
                                <br/>
                                <span style="padding-left: 65px;">ธนาคาร:</span>
                                <t t-set="bank_info" t-value="payment.payment_method_id.name"/>
                                <t t-set="bank_name">
                                    <t t-if="bank_info and bank_info.find('SCB') != -1">ธนาคารไทยพาณิชย์</t>
                                    <t t-if="bank_info and bank_info.find('K') != -1">ธนาคารกสิกรไทย</t>
                                    <t t-if="bank_info and bank_info.find('BBL') != -1">ธนาคารกรุงเทพ</t>
                                    <t t-if="bank_info and bank_info.find('KTB') != -1">ธนาคารกรุงไทย</t>
                                    <t t-if="bank_info and bank_info.find('BAY') != -1">ธนาคารกรุงศรีอยุธยา</t>
                                    <t t-if="not (bank_info and (bank_info.find('SCB') != -1 or bank_info.find('K') != -1 or bank_info.find('BBL') != -1 or bank_info.find('KTB') != -1 or bank_info.find('BAY') != -1))">
                                        ธนาคารอื่น
                                    </t>
                                </t>
                                <span t-esc="bank_name" style="padding; 2px;"/>
                                <span class="ml-1">เลขที่บัญชี:</span>
                                <span class="ml-1" t-esc="payment.account_id.name[-13:]"/>
                            </t>
                        </t>
                        <!-- กรณีมีข้อมูลใน payment_method_one_id -->
                        <t t-elif="doc.payment_method_one_id and doc.payment_method_one_id.type == 'bank' and not doc.is_payment_multi">
                            <t t-set="bank_info" t-value="doc.payment_method_one_id.name"/>
                            <t t-set="bank_name">
                                <t t-if="bank_info and bank_info.find('SCB') != -1">ธนาคารไทยพาณิชย์</t>
                                <t t-if="bank_info and bank_info.find('K') != -1">ธนาคารกสิกรไทย</t>
                                <t t-if="bank_info and bank_info.find('BBL') != -1">ธนาคารกรุงเทพ</t>
                                <t t-if="bank_info and bank_info.find('KTB') != -1">ธนาคารกรุงไทย</t>
                                <t t-if="bank_info and bank_info.find('BAY') != -1">ธนาคารกรุงศรีอยุธยา</t>
                                <t t-if="not (bank_info and (bank_info.find('SCB') != -1 or bank_info.find('K') != -1 or bank_info.find('BBL') != -1 or bank_info.find('KTB') != -1 or bank_info.find('BAY') != -1))">
                                    ธนาคารอื่น
                                </t>
                            </t>
                            <span class="ml-1" t-esc="bank_name"/>
                            <span class="ml-1">เลขที่บัญชี</span>
                            <span class="ml-1" t-esc="doc.payment_method_one_id.account_id.name[-13:]"/>
                        </t>


                    </p>

