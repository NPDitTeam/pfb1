                    <span style="float: left;">ภาษีมูลค่าเพิ่ม7%</span>
                    <span style="float: right;">
                        <t t-set="total_vat" t-value="sum(group[1] for i in doc.reconciled_invoice_ids for group in i.amount_by_group)"/>
                        <t t-esc="'{0:,.2f}'.format(total_vat)"/>
                    </span>
                </td>
            </tr>
            <tr>
                <td colspan="3" class="text-left"/>
