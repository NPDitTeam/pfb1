                        <t t-set="total_untaxed_amount" t-value="sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids)"/>
                        <t t-if="doc.partner_id.company_type == 'company'">
                          <t t-esc="'{0:,.2f}'.format(total_untaxed_amount * 5 / 100)"/>
                        </t>
                        <t t-else="">
                          0.00
                        </t>

                    </span>
                </td>
            </tr>
            <tr>
                <td class="text-center">ตัวอักษร :</td>
                <td colspan="2" class="text-center"><strong>
                  <t t-set="total_untaxed_amount" t-value="sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids)"/>
                  <t t-if="doc.partner_id.company_type == 'company'">
                    (<span t-esc="doc.get_baht_text_form_receipt_place_rent()"/>)
                  </t>
                  <t t-else="">
                    ( <t t-esc="doc.currency_id.with_context({'lang': 'th_TH'}).amount_to_text(total_untaxed_amount)"/>)
                  </t>

                  </strong></td>
                <td style="border-top: hidden;" colspan="2">
                    <span style="float: left;">จำนวนเงินทั้งสิ้น</span>
                    <span style="float: right;">
                      <t t-if="doc.partner_id.company_type == 'company'">
                        <t t-set="total_untaxed_amount" t-value="sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids)"/>
                        <t t-esc="'{0:,.2f}'.format(doc.total_amount - total_untaxed_amount * 5 / 100)"/>
                      </t>
                      <t t-else="">
                        <t t-set="total_untaxed_amount" t-value="sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids)"/>
