            </tr>
            <tr>
              <t t-if="doc.partner_id.company_type == 'company'">
                <td colspan="1" class="text-left" style="border-right: hidden;">ภาษีหัก ณ ที่จ่าย 5% (ค่าเช่า)</td>
                <td colspan="2" class="text-right">
                    <t t-set="total_untaxed_amount" t-value="sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids)"/>
                    <t t-esc="'{0:,.2f}'.format(total_untaxed_amount * 5 / 100)"/> บาท
                </td>
              </t>
              <t t-else="">
                <td colspan="1" class="text-left" style="border-right: hidden;"></td>
                <td colspan="2" class="text-right"></td>
              </t>

