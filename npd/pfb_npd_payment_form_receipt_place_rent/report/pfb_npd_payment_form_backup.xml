                               class="mr-1"/>
                        <span class="mr-1">เช็ค</span>

                        <!-- กรณีดึงข้อมูลจาก paid_ids -->
                        <t t-if="doc.is_payment_multi and 'cheque' in [payment.payment_method_id.type for payment in doc.paid_ids]">
                            <t t-set="count" t-value="0"/>
                            <t t-foreach="[payment for payment in doc.paid_ids if payment.payment_method_id.type == 'cheque']"
                               t-as="payment">
                                <t t-if="count == 0">
                                    <span class="ml-1" style="padding-left: 5px;">
                                        ธนาคาร: <span t-esc="payment.cheque_id.bank_id.name"/>
                                    </span>
                                    <span class="ml-1">
                                        สาขา: <span t-esc="payment.cheque_id.bank_id.branch_name"/>
                                    </span>
                                    <span class="ml-1">
                                        เลขที่เช็ค: <span class="ml-1" t-esc="payment.cheque_id.name"/>
                                    </span>
                                    <t t-set="count" t-value="1"/>
                                </t>
                                <t t-else="">
                                    <br/>
                                    <span class="ml-1" style="padding-left: 52px;">
                                        ธนาคาร: <span t-esc="payment.cheque_id.bank_id.name"/>
                                    </span>
                                    <span class="ml-1">
                                        สาขา: <span t-esc="payment.cheque_id.bank_id.branch_name"/>
                                    </span>
                                    <span class="ml-1">
                                        เลขที่เช็ค: <span class="ml-1" t-esc="payment.cheque_id.name"/>
                                    </span>
                                </t>

                            </t>
                        </t>
                        <!-- กรณีดึงข้อมูลจาก payment_method_one_id -->
                        <t t-elif="doc.payment_method_one_id and doc.payment_method_one_id.type == 'cheque' and not doc.is_payment_multi">
