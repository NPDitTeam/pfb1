<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ir.sequence = เลขที่ใบส่งมอบสินค้า
        Prefix = RDO-%(y)s%(month)s%(day)s -> RDO- + รหัสวันที่ yymmdd (เช่น RDO-260714)
        output = RDO-260714 + เลขรัน padding 4 = RDO-2607140001
    -->
    <record id="seq_npd_delivery_note" model="ir.sequence">
        <field name="name">เลขที่ใบส่งมอบสินค้า</field>
        <field name="code">npd.delivery.note</field>
        <field name="prefix">RDO-%(y)s%(month)s%(day)s</field>
        <field name="padding">4</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
