<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--        กำหนดค่ากระดาษ-->
    <record id="paperformat_pfb_npd_sale_form_delivery_note" model="report.paperformat">
        <field name="name">A4 Delivery Note</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">60</field> <!-- ระยะขอบด้านบน -->
        <field name="margin_bottom">110</field> <!-- ระยะขอบด้านล่างตั้งค่าเป็น 5 หน่วย -->
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">60</field>
    </record>

    <report
            id="action_delivery_note"
            string="ใบส่งมอบสินค้า"
            name="pfb_npd_sale_form_delivery_note.report_pfb_npd_sale_form_delivery_note"
            model="sale.order"
            report_type="qweb-pdf"
            print_report_name="'Delivery - %s' %(object.name)"
            paperformat="pfb_npd_sale_form_delivery_note.paperformat_pfb_npd_sale_form_delivery_note"
    />

    <!--    หัวข้อรายงาน-->
    <template id="report_header">
        <style>
            .mt-1 {
            margin-top: 1rem;
            }
            .mb-1 {
            margin-bottom: 1rem;
            }
            .ml-45 {
            margin-left: 50px;
            }.ml-2 {
            margin-left: 10px;
            }
        </style><br/>
        <div class="row">
            <div class="col-2 mr-1" style="margin-top: 14px;">
                <img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-7" style="margin-top: 15px;">
                <table style="width: 100%;" class="ml-45">
                    <tr>
                        <td><strong class="ml-2" style="font-size: 22px;">ใบส่งมอบสินค้า</strong></td>
                    </tr>
                    <tr>
                        <td><strong class="ml-2" style="font-size: 16px;"><span
                                t-esc="doc.company_id.name"/></strong></td>
                    </tr>
                    <tr>
                        <td style="padding-left: 10px;font-size: 14px;line-height: 1.0;">
                            <span t-field="doc.branch_id.address" style="line-height: 1.0;font-size: 13px;margin: 0;"/><br/>
                            เลขประจำตัวผู้เสียภาษี <span t-esc="doc.company_id.vat"></span>
                                    <span t-if="doc.branch_id.telephone == '00000'">(สำนักงานใหญ่)</span>
                        </td>
                    </tr>
                </table>
            </div>        <!-- โลโก้บริษัท -->
            <div class="col-3" style="margin-top: 15px;">
                <table style="width: 100%;">

                    <tr>
                        <td class="text-center">
                            <strong style="font-size: 13px;">เลขที่ <span t-esc="doc.delivery_note_no"/></strong>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-center">
                            <strong style="font-size: 13px;">วันที่ <span t-esc="doc.date_order.strftime('%d') + ' ' + {1: 'มกราคม', 2: 'กุมภาพันธ์', 3: 'มีนาคม', 4: 'เมษายน', 5: 'พฤษภาคม', 6: 'มิถุนายน', 7: 'กรกฎาคม', 8: 'สิงหาคม', 9: 'กันยายน', 10: 'ตุลาคม', 11: 'พฤศจิกายน', 12: 'ธันวาคม'}[int(doc.date_order.strftime('%m'))] + ' ' + str(int(doc.date_order.strftime('%Y')) + 543)"/></strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <strong style="font-size: 13px;">สัญญา <span t-esc="doc.rental_contract_full"/></strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <strong style="font-size: 13px;">ใบกำกับการเช่า <span t-esc="doc.name"/></strong>
                        </td>
                    </tr>

                </table>
            </div>
        </div>
    </template>


    <template id="report_day">
        <style>
            .rounded-square {
                border: 1px solid #000;
                border-radius: 10px;
                padding: 10px;
                font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
            }
            .text-left {
                text-align: left;
            }


            .text-right {
                text-align: right;
            }

            .mt-1 {
                margin-top: 1rem;
            }

            .mb-1 {
                margin-bottom: 1rem;
            }

            .mr-1 {
                margin-right: 1rem;
            }
        </style>
        <div class="row">
            <div class="mb-1 rounded-square" style="display: block; width:900px;">
                <div class="col-26">
                    <table width="100%">
                        <tr>
                            <td class="text-left">
                                <strong class="ml-1">
                                    <span style="font-size: 13px;">เริ่มเช่าวันที่</span>
                                    <span style="font-size: 13px;" t-esc="doc.start_rent_date.strftime('%d') + ' ' + {1: 'มกราคม', 2: 'กุมภาพันธ์', 3: 'มีนาคม', 4: 'เมษายน', 5: 'พฤษภาคม', 6: 'มิถุนายน', 7: 'กรกฎาคม', 8: 'สิงหาคม', 9: 'กันยายน', 10: 'ตุลาคม', 11: 'พฤศจิกายน', 12: 'ธันวาคม'}[int(doc.start_rent_date.strftime('%m'))] + ' ' + str(int(doc.start_rent_date.strftime('%Y')) + 543)"/>
                                    <span style="font-size: 13px;" class="ml-1">ถึง</span>
                                    <span style="font-size: 13px;"  t-esc="doc.end_rent_date.strftime('%d') + ' ' + {1: 'มกราคม', 2: 'กุมภาพันธ์', 3: 'มีนาคม', 4: 'เมษายน', 5: 'พฤษภาคม', 6: 'มิถุนายน', 7: 'กรกฎาคม', 8: 'สิงหาคม', 9: 'กันยายน', 10: 'ตุลาคม', 11: 'พฤศจิกายน', 12: 'ธันวาคม'}[int(doc.end_rent_date.strftime('%m'))] + ' ' + str(int(doc.end_rent_date.strftime('%Y')) + 543)"/>
                                </strong>
                            </td>
                            <td class="text-right" style="font-size: 13px;">
                                <strong class="mr-1">รวม</strong>
                                <strong class="mr-1"><span t-esc="doc.pfb_date_of_rent"/></strong>
                                <strong>วัน</strong>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>

    <!--    รายละเอียด-->
    <template id="report_detail">
        <style>
            .table2t {
            width: 100%;
            border-collapse: collapse;
            }

            .table-right td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: right; /* จัดตำแหน่งเนื้อหาทางขวา */
            }

            .table-right h2 {
            margin: 0;
            text-align: right; /* จัดตำแหน่งหัวข้อทางขวา */
            }
            .preserve-whitespace
            {
            white-space: pre; /* Preserve leading and other white spaces */
            }
            .mt-1 {
            margin-top: 1rem; /* ระยะห่างด้านบน */
            }
            .mb-1 {
            margin-bottom: 1rem; /* ระยะห่างด้านล่าง */
            }
            .mr-1 {
            margin-right: 1rem; /* ระยะห่างด้านขวา */
            }
            .ml-1 {
            margin-left: 1em /* ระยะห่างด้านซ้าย */
            }
            .space{
            margin-left: 1em; /* ช่องว่างด้านซ้ายเทียบเท่ากับขนาดของ 5 ตัวอักษร */
            }
            .space2{
            margin-left: 2.4em; /* ช่องว่างด้านซ้ายเทียบเท่ากับขนาดของ 5 ตัวอักษร */
            }
            .space2-1{
            margin-left: 2.6em; /* ช่องว่างด้านซ้ายเทียบเท่ากับขนาดของ 5 ตัวอักษร */
            }
            .space3{
            margin-left: 5.2em; /* ช่องว่างด้านซ้ายเทียบเท่ากับขนาดของ 5 ตัวอักษร */
            }
            .m-1 {
            margin: 1rem; /* ระยะห่างในทุกทิศทาง */
            }
        </style>
        <!--         ส่วนของข้อมูล-->
        <div class="row" style="mt-1">
            <table class="width :100%">
                <tr>
                    <!--                        ชื่อผู้เช่า-->
                    <strong class="space2" style="font-size: 13px;">ผู้เช่า :</strong>
                </tr>
                <tr>
                    <td style="font-size: 13px;"><span class="ml-1" t-esc="doc.partner_id.name"/></td>
                </tr>
            </table>
        </div>
        <div class="row" style="mt-1">
            <table style="width :100%">
                <tr style="font-size: 13px;">
                    <td style="font-size: 13px;">
                        <strong class="space2-1">ที่อยู่ :</strong>
                        <span class="ml-1" t-esc="doc.partner_id.street"/>
                        <span class="ml-1" t-esc="doc.partner_id.street2"/>
                        <span class="ml-1" t-esc="doc.partner_id.city"/>
                        <span class="ml-1" t-esc="doc.partner_id.state_id.name"/>
                        <span class="ml-1" t-esc="doc.partner_id.zip"/>
                        <tb class="ml-1">[<span t-esc="doc.partner_id.phone"/>]</tb>
                    </td>
                </tr>
            </table>
        </div>
        <div class="row">
            <table style="width :100%">
                <tr>
                    <td style="font-size: 13px;">
                        <tb class="space3">ผู้ติดต่อ :</tb>
                        <tb class="ml-1"><span t-esc="doc.partner_id.name"/></tb>
                    </td>
                </tr>
            </table>
        </div>
        <div class="row">
            <table style="width :100%">
                <tr>
                    <td style="ml-1 font-size: 13px;">
                        <strong class="space" style="font-size: 13px;">หน้างาน :</strong>
                        <span class="ml-1" style="font-size: 13px;" t-esc="doc.on_site"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!--    ตาราง-->
    <template id="report_table">
        <style>
            .table2{
            width: 100%;
            height: 140px;
            }
            .page-break {
                page-break-before: always;
            }
            .empty-row td {
                height: 22px;
            }
        </style>
        <t t-set="chunk_size" t-value="21"/>
        <t t-set="order_lines" t-value="doc.order_line"/>
        <t t-set="total_lines" t-value="len(order_lines)"/>
        <t t-set="num_chunks" t-value="max(1, (total_lines + chunk_size - 1) // chunk_size)"/>
        <t t-foreach="range(num_chunks)" t-as="group_index">
            <t t-set="start" t-value="group_index * chunk_size"/>
            <t t-set="end" t-value="start + chunk_size"/>
            <t t-set="group" t-value="order_lines[start:end]"/>
            <t t-set="empty_count" t-value="chunk_size - len(group)"/>
            <table width="100%" style="mt-1">
                <thead>
                    <tr style="border-bottom: 1px solid black !important; font-size: 13px;">
                        <th width="3%" class="text-center border_report" style="font-size: 13px;">ลำดับ</th>
                        <th width="20%" class="text-center border_report" style="font-size: 13px;">รายการสินค้า</th>
                        <th width="7%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">น้ำหนักสินค้า</th>
                        <th width="6%" class="text-right border_report" style="font-size: 13px;">จำนวน</th>
                        <th width="12%" class="text-right border_report" style="padding: 0 6px;font-size: 13px;">ค่าปรับเงินประกัน<br/>หลังหักค่าเสื่อมแล้ว</th>
                        <th width="9%" class="text-right border_report" style="padding: 0 6px;font-size: 13px;">ค่าซ่อมแซม<br/>(B/ชิ้น)</th>
                        <th width="9%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">ค่าเช่า<br/>ต่อหน่วย</th>
                        <th width="11%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">รวมเป็นเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="group" t-as="l">
                        <tr>
                            <td class="text-center" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="start + l_index + 1"/></td>
                            <td class="text-left" style="font-size: 13px;border-bottom:hidden;">
                                <span t-esc="l.product_template_id.name"/></td>
                            <td class="text-right" style="font-size: 13px; border-bottom: hidden;">
                                <span t-esc="'{0:,.2f}'.format(l.second_uom_qty * l.pfb_quantity)"/>
                            </td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.0f}'.format(l.pfb_quantity)"/></td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.2f}'.format(l.pfb_insurance_price or 0)"/></td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;">ตามจริง</td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.2f}'.format((l.price_unit_no_vat or 0))"/></td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.2f}'.format((l.price_subtotal or 0))"/></td>
                        </tr>
                    </t>
                    <t t-foreach="range(empty_count)" t-as="empty_i">
                        <tr class="empty-row">
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <t t-if="group_index + 1 &lt; num_chunks">
                <div class="page-break"/>
            </t>
        </t>
    </template>

    <!--    ลายเซ็น -->
    <template id="report_signature">
        <div style="display: block; width: calc(100% - 20px); position: fixed; left: 10px; right: 10px; top: 900px;">
            <style>
                .mt-1 {
                margin-top: 1rem;
                }
                .mr-68 {
                margin-right: 4em;
                }
                .rounded-square {
                border: 1px solid #000;
                border-radius: 5px;
                padding: 5px 20px;
                width: 100%;
                font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
                }
                .vertical {
                float: left;
                border-right: 2px solid darkcyan;
                padding-right: 0.5rem;
                margin-right: 0.5rem;
                }
                .mt-2 {
                margin-top: 20px;
                }
                .mb-1 {
                margin-bottom: 1rem;
                }
                .mb-2 {
                margin-bottom: 10px;
                }
                .mr-99 {
                margin-right: 20px;
                }
                /* ข้อความเงื่อนไขการส่งมอบ */
                .note-terms td {
                font-size: 13px;
                line-height: 1.4;
                padding: 0 0 3px 0;
                vertical-align: top;
                }
                /* ช่องลงชื่อ */
                .sign-line {
                text-align: center;
                border-bottom: 1px dotted #000;
                width: 240px;
                margin: 0 auto 4px auto;
                height: 40px;
                }
                .sign-label {
                font-size: 15px;
                }
                /* ชื่อที่พิมพ์อยู่บนเส้นประ (ชิดล่างของช่องเซ็น) */
                .sign-name {
                display: block;
                font-size: 14px;
                padding-top: 20px;
                }
            </style>
            <t t-if="doc.contact_type == 'sale'">
                  <strong class="text-left" style="font-size: 13px;">
                    เจ้าหน้าที่ฝ่ายขาย:<span style="margin-left:10px;"></span><t t-esc="doc.sales_contact.name"/>
                </strong>

                </t>
            <div style="border-bottom: 1px solid black" class="mb-1"/>
            <div class="row">
                <div class="col-6">
                    <div class="rounded-square" style="height: 145px; position: relative;">
                        <p class="text-left" style="font-size: 13px; margin: 0; max-height: 95px; overflow: hidden;">
                            หมายเหตุ
                            <span class="ml-1" t-raw="doc.note.replace('&lt;p&gt;', '').replace('&lt;/p&gt;', '')"/>
                        </p>
                        <div style="position: absolute; bottom: 5px; left: 20px; right: 20px;">
                            <p style="border-bottom: 1px solid black; margin: 0 0 4px 0;"/>
                            <p class="text-left" style="font-size: 13px; margin: 0;">
                                <strong class="mr-1">ค่าเช่า :</strong>เงินโอน(<span
                                    t-esc="'{0:,.2f}'.format(doc.amount_total)"/>)<span> | </span>
                                <strong class="mr-1">ค่าประกัน :</strong>เงินโอน(<span
                                    t-esc="'{0:,.2f}'.format(doc.pfb_amount)"/>)</p>

                            <p class="text-left" style="font-size: 13px; margin: 0;">
                                <t t-set="sum_weight" t-value="sum([line.second_uom_qty * line.pfb_quantity for line in doc.order_line])"/>
                                <strong class="mr-1">น้ำหนักรวมสินค้ารวมสุทธิ :</strong> <span t-esc="'{0:,.2f}'.format(sum_weight)"/> กก. </p>

                        </div>

                    </div>
                </div>
                <div class="col-6" style="margin-left: -30px;">
                    <table width="100%">
                        <tr>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong>ค่าเช่าสินค้าก่อนภาษี</strong></td>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_untaxed)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong>ภาษีมูลค่าเพิ่ม 7 %</strong></td>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_tax)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong>ค่าเช่าสินค้าสุทธิ</strong></td>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_total)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong>ค่าประกันสินค้า</strong></td>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong><span t-esc="'{0:,.2f}'.format(doc.pfb_amount)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong>ค่าเช่าต่อวันรวม(vat)</strong></td>
                            <t t-set="rent_days" t-value="(doc.end_rent_date - doc.start_rent_date).days or 1"/>
                            <td class="text-right" style="font-size: 14px; padding: 4px 5px;"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_total / rent_days)"/></strong></td>
                        </tr>


                    </table>
                </div>
            </div>
            <div class="rounded-square">
                <div class="row">
                    <div class="col-3">
                        <p class="text-left"><strong style="font-size: 13px;"> ค่าเช่าเเละค่าประกันสุทธิ :</strong></p>
                    </div>
                    <div class="col-6">
                        <p class="text-right mr-99" style="font-size: 13px;">(<span t-esc="doc.get_total_baht_text()"/>)
                            <span> | </span>
                        </p>
                    </div>
                    <div class="col-3">
                        <p class="text-right">
                            <strong style="font-size: 14px;"><b><span
                                    t-esc="'{0:,.2f}'.format(doc.pfb_amount + doc.amount_total)"/></b></strong></p>
                    </div>
                </div>
            </div>
            <!-- เงื่อนไขการส่งมอบ (ใต้กล่องค่าเช่าและค่าประกันสุทธิ) -->
            <div class="mt-1" style="font-size: 13px;">
                <strong>เงื่อนไข:</strong>
                <table class="note-terms" style="width: 100%; margin-top: 3px; margin-left: 40px;">
                    <tr>
                        <td style="width: 20px;">1.</td>
                        <td>"ผู้ตรวจรับสินค้า" ตามใบส่งมอบสินค้านี้ หมายถึง ผู้มีหน้าที่ในการตรวจนับและรับมอบสินค้า</td>
                    </tr>
                    <tr>
                        <td>2.</td>
                        <td>ผู้เช่าได้ทำการตรวจสอบคุณภาพและตรวจนับรายการสินค้าตามรายการข้างต้นและยินยอมรับมอบสินค้าดังกล่าวไว้ในความครอบครองนับแต่วันที่ได้ลงนามเป็นต้นไป</td>
                    </tr>
                    <tr>
