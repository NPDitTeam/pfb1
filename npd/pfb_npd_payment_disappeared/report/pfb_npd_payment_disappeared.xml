            <tr>
                <td colspan="2">
                    <p style="color : white">.</p>
                    <p style="color : white">.</p>
                    <p style="color : white">.</p>
                    <p style="color : white">.</p>
                    <p class="flex-item">จำนวนเงิน(ตัวอักษร)</p>
                    <p style="border-bottom: 1px solid black"/>
                    <p class="text-center">(<span t-esc="doc.get_baht_text_disappeared_receipt()"/>)</p>
                </td>
                <td colspan="2" style="border-right: hidden;">
                    <p style="color : white;  font-size: 1px;">.</p>
                    <p>รวมเป็นเงิน</p>
                    <p>ส่วนลด</p>
                    <p>ค่าสินค้าหลังหักส่วนลด</p>
                    <p>ค่าภาษีมูลค่าเพิ่ม 7%</p>
                    <p>รวมค่าสินค้าก่อนภาษีมูลค่าเพิ่ม</p>
                    <p>จำนวนเงินทั้งสิ้น</p>
                </td>
                <td colspan="1" style="border-left: hidden;" class="text-right">
