                    <t t-set="db_name" t-value="request.session.db"/>

                    <t t-if="db_name == 'NPD_Bangkok_New'">
                        <p class="text-center" style="margin: 5px 0;">บริษัท นภดล กรุงเทพ จํากัด</p>
                        <p class="text-center" style="margin: 5px 0;">NOPPADOL BANGKOK CO.,LTD</p>
                    </t>
                    <t t-elif="db_name == 'NPD_S_Group_New_V2'">
