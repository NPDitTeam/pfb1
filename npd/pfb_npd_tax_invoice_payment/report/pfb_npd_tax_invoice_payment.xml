<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--        กำหนดค่ากระดาษ-->
    <record id="paperformat_pfb_npd_tax_invoice_payment" model="report.paperformat">
        <field name="name">A4 Sample</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field> <!-- ระยะขอบด้านบนตั้งค่าเป็น 1 หน่วย -->
        <field name="margin_bottom">5</field> <!-- ระยะขอบด้านล่างตั้งค่าเป็น 5 หน่วย -->
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="dpi">95</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <report
            id="action_tax_bill"
            string="ใบกำกับภาษี/ใบเสร็จรับเงิน(การชำระ)"
            name="pfb_npd_tax_invoice_payment.report_pfb_npd_tax_invoice_payment"
            model="account.payment"
            report_type="qweb-pdf"
            print_report_name="'Sale - %s' %(object.name)"
            paperformat="pfb_npd_tax_invoice_payment.paperformat_pfb_npd_tax_invoice_payment"
    />

<!--    หัวข้อรายการ-->
    <template id="report_header">
        <style>
            .flex-item6{
                margin-left: 26px;
            }
        </style>
        <div class="row">
            <div class="col-2">
                <!-- โลโก้บริษัท -->
                <br/><img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-6">
                <table width="100%" class="flex-item6">
                    <tr>
                        <td style="font-size: 15px;"><br/><strong><span t-esc="doc.company_id.name"/></strong></td>
                    </tr>
                    <tr>
                        <td style="font-size: 14px;">
<!--                            <span t-esc="doc.company_id.street"/>-->
<!--                            <span t-esc="doc.company_id.street2"/>-->
<!--                            <span t-esc="doc.company_id.city"/>-->
<!--                            จังหวัด<span t-esc="doc.company_id.state_id.name"/>-->
<!--                            <span class="ml-1" t-esc="doc.partner_id.zip"/>-->
                             <span t-field="doc.branch_id.address" />
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size: 14px;">
<!--                            <span>โทร. / แฟกช์</span>-->
<!--                            <span class="ml-1" t-esc="doc.company_id.fax"/>-->
<!--                            <span class="ml-1">มือถือ</span>-->
<!--                            <span class="ml-1" t-esc="doc.company_id.phone"/>-->
                            เลขประจำตัวผู้เสียภาษี
                        <span t-esc="doc.company_id.vat"/>
                            <span t-if="user.branch_id.telephone == '00000'">(สำนักงานใหญ่)</span>
                        </td>
                    </tr>
                    <tr>
                    <td style="font-size: 14px;">
<!--                        เลขประจำตัวผู้เสียภาษี-->
<!--                        <span t-esc="doc.company_id.vat"/>-->
                    </td>
                </tr>
                </table>
            </div>
            <div class="col-5">
                <table width="100%">
                    <tr>
                         <br/><td class="text-center" style="font-size: 16px;"><strong>ใบกำกับภาษี/ใบเสร็จรับเงิน</strong></td>
                    </tr>
                    <tr>
                         <td class="text-center" style="font-size: 16px;"><strong>Tax invoice/receipt</strong>
                         </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

<!--    รายละเอียด-->
    <template id="report_detail">
        <style>
            .invoice-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }.invoice-table, .invoice-table th, .invoice-table td {
                border: 1px solid black;
                font-size: 13px;
            }.invoice-table th, .invoice-table td {
                padding: 5px;
                vertical-align: top;
                font-size: 13px;
            }.flex-item{
               margin-left: 20px;
            }.flex-item2{
                margin-left: 25px;
            }.spacing{
                margin-right: 25px;
            }.spacing2{
                margin-left: 60px;
            }.mt-1{
                margin-top: 5px;
            }.spacing3{
                margin-left: 70px;
            }.spacing4{
                margin-left: 75px;
        </style>
        <table class="invoice-table">
            <tr>
                <div style="display: flex; justify-content: space-between;">
                    <td colspan="2">
                        <p>
                            <strong><span class="mr-1">ชื่อลูกค้า:</span></strong>
                            <span class="ml-1" t-esc="doc.partner_id.name"/>
                        </p>
                        <p>
                            <strong class="spacing"><span>ที่อยู่:</span></strong>
                            <span class="ml-1" t-esc="doc.partner_id.street"/>
                            <span class="ml-1" t-esc="doc.partner_id.street2"/>
                            <span class="ml-1" t-esc="doc.partner_id.city"/>
                            <span class="ml-1" t-esc="doc.partner_id.state_id.name"/>
                            <span class="ml-1" t-esc="doc.partner_id.zip"/>
                        </p>
                        <p class="spacing2">
                            <span>เลขประจำตัวผู้เสียภาษี</span>
                            <span class="ml-1" t-esc="doc.partner_id.vat"/>
                        </p>
                    </td>
<!--                    <td colspan="1" style="border-left: hidden; border-right: hidden;" class="text-right">-->
<!--                        <p style="font-size: 16px;">-->
<!--                            <strong style="font-size: 14px;"><span>เลขที่:</span></strong>-->
<!--                        </p>-->
<!--                        <p>-->
<!--                            <span>วันที่:</span>-->
<!--                        </p>-->
<!--                    </td>-->
                    <td colspan="3" style="border-left: hidden;" class="text-left">
                        <p style="font-size: 14px;" class="spacing3 "><strong>
                            <span class="mr-1">
                               เลขที่ :
                            </span>
                            <span t-esc="doc.name"/>
                        </strong>
                        </p>
                        <p class="spacing4">
                            <span class="mr-1">
                                วันที่ :
                            </span>
                            <span t-esc="doc.date.strftime('%d-%m-%Y')"/>
                        </p>
                    </td>

<!--                    <td colspan="2" style="border-left: hidden;" class="text-left">-->
<!--                        <p style="font-size: 14px;">-->
<!--                            <span t-esc="doc.name"/></p>-->
<!--                        <p>-->
<!--                            <span t-esc="doc.date.strftime('%d-%m-%Y')"/>-->
<!--                        </p>-->
<!--                    </td>-->
                </div>
            </tr>
                <tr>
                    <th width="15%" class="text-center">ลำดับ<br>No.</br></th>
                    <th width="50%" class="text-center">รายการสินค้า<br>DESCRIPTION</br></th>
                    <th colspan="3" class="text-center">จำนวนเงิน<br>Amount</br></th>
                </tr>
                 <t t-set="c" t-value="0"/>
                     <tr>
                         <td width="15%" class="text-center" style="border-bottom:hidden;">1</td>
                        <td width="50%" class="text-left"  style="border-bottom:hidden;">ค่าเช่าเครื่องมือก่อสร้าง</td>
                            <td colspan="3" class="text-right" style="border-bottom:hidden;"><span t-esc="'{0:,.2f}'.format(doc.amount)"/></td>
                        <t t-set="c" t-value="c+1"/>
                     </tr>
                <!--        ทำให้ช่องตารางว่าง-->
                <t t-set="number" t-value="range(1,abs((23-c)))"/>
                <t t-foreach="number" t-as="n">
                    <tr>
                        <td width="15%" style="border-top:hidden; color : white">.</td>
                        <td width="50%" style="border-top:hidden;"/>
                        <td colspan="3" style="border-top:hidden;"/>
                    </tr>
                </t>

            <tr>
                <td colspan="2">
                    <p style="color : white">.</p>
                    <p style="color : white">.</p>
                    <p style="color : white">.</p>
                    <p style="color : white">.</p>
                    <p class="flex-item">จำนวนเงิน(ตัวอักษร)</p>
                    <p style="border-bottom: 1px solid black"/>
                    <p class="text-center">(<span t-esc="doc.get_baht_text_amount()"/>)</p>
                </td>
                <td colspan="2" style="border-right: hidden;">
                    <p style="color : white;  font-size: 1px;">.</p>
                    <p>รวมเป็นเงิน</p>
                    <p>ส่วนลด</p>
                    <p>ค่าสินค้าหลังหักส่วนลด</p>
                    <p>ค่าภาษีมูลค่าเพิ่ม 7%</p>
                    <p>รวมค่าสินค้าก่อนภาษีมูลค่าเพิ่ม</p>
                    <p>จำนวนเงินทั้งสิ้น</p>
                </td>
                <td colspan="1" style="border-left: hidden;" class="text-right">
                    <p style="color : white; font-size: 1px;">.</p>
                    <t t-set="total_amount_untaxed" t-value="sum(doc.invoice_ids.mapped(lambda l: sum(l.invoice_id.mapped('amount_untaxed'))))"/>
                    <t t-set="net_amount"           t-value="sum(doc.invoice_ids.mapped(lambda l: sum(l.invoice_id.mapped('wht_amt_net'))))"/>

                    <p class="text-right"><span t-esc="'{0:,.2f}'.format(net_amount)"/></p>
                    <p class="text-right"><span>0.00</span></p>
                    <p class="text-right"><span t-esc="'{0:,.2f}'.format(net_amount)"/></p>
                    <p class="text-right"><span t-esc="'{0:,.2f}'.format(net_amount-total_amount_untaxed)"/></p>
                    <p class="text-right"><span t-esc="'{0:,.2f}'.format(total_amount_untaxed)"/></p>
                    <p class="text-right"><span t-esc="'{0:,.2f}'.format(net_amount)"/></p>

                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <p class="flex-item">
                        ชำระเงินโดย
                    </p>
                    <p class="flex-item2">
                        <input type="checkbox" t-att-checked="doc.payment_method_one_id.type == 'cash'" class="mr-1"/>
                        <span>เงินสด</span>
                    </p>
                    <p class="flex-item2">
                            <!-- เช็คบ็อกซ์สำหรับธนาคาร -->
                        <input type="checkbox" t-att-checked="doc.payment_method_one_id.type == 'bank'" class="mr-1"/>
                        <span class="mr-1">โอนเงิน</span>

                        <!-- ตรวจสอบและแสดงชื่อธนาคารตามรหัส -->
                        <t t-if="doc.payment_method_one_id.type == 'bank'">
                            <t t-set="bank_info" t-value="doc.payment_method_one_id.name"/>
                            <t t-set="bank_name">
                                <t t-if="bank_info.find('SCB') != -1">ธนาคารไทยพาณิชย์</t>
                                <t t-if="bank_info.find('K') != -1">ธนาคารกสิกรไทย</t>
                                <t t-if="bank_info.find('BBL') != -1">ธนาคารกรุงเทพ</t>
                                <t t-if="bank_info.find('KTB') != -1">ธนาคารกรุงไทย</t>
                                <t t-if="bank_info.find('BAY') != -1">ธนาคารกรุงศรีอยุธยา</t>
                                <t t-if="not (bank_info.find('SCB') != -1 or bank_info.find('K') != -1 or bank_info.find('BBL') != -1 or bank_info.find('KTB') != -1 or bank_info.find('BAY') != -1)">ธนาคารอื่น</t>
                            </t>
                            <span class="ml-1" t-esc="bank_name"/>

                            <!-- แสดงเลขที่บัญชี -->
                            <span class="ml-1">เลขที่บัญชี</span>
                            <span class="ml-1" t-esc="doc.payment_method_one_id.account_id.name[-13:]"/>
                        </t>
                    </p>
                    <p class="flex-item2">
                        <input type="checkbox" t-att-checked="doc.payment_method_one_id.type == 'cheque'" class="mr-1"/>
                        <span class="mr-1">เช็ค</span>
    <!--                    เงื่อนไขการแสดงเลขที่เช็ค -->
                         <t t-if="doc.payment_method_one_id.type == 'cheque' and doc.cheque_one_id.name">
                             <span class="ml-1">
                                ธนาคาร: <span t-esc="doc.cheque_id.bank_id.name"/>
                             </span>
                             <span class="ml-1">
                                 สาขา: <span t-esc="doc.cheque_id.bank_id.branch_name"/>
                             </span>
                             <span class="ml-1">
                                 เลขที่เช็ค: <span class="ml-1" t-esc="doc.cheque_id.name"/>
                             </span>
                         </t>
                    </p>
                    <p class="flex-item">ผู้รับเงิน/Collector.......................................................................วันที่/Date....................................................</p>
                </td>
                <td colspan="3">
                    <p class="text-center">บริษัท นภดล เอส กรุ๊ป จํากัด</p>
                    <p class="text-center">NOPPADOL BANGKOK CO.,LTD</p>
                    <p class="text-center" style="color : white">.</p>
                    <p class="text-center" style="color : white">.</p>
                    <p class="text-center">ผุ้มีอำนาจลงนาม/Authorized Signature</p>
<!--                    ข้อ 16-->
<!--                    <t t-set="grand_total" t-value="sum(doc.invoice_ids.mapped(lambda l: sum(l.invoice_id.invoice_line_ids.mapped('price_subtotal'))))"/>-->
<!--                    <span>ไม่รวมภาษี: <t t-esc="grand_total"/></span>-->
                </td>
            </tr>
        </table>
    </template>


    <template id="report_pfb_npd_tax_invoice_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <table width="100%" >
                        <tr>
                            <td>
                                <t t-call="pfb_npd_tax_invoice_payment.report_header"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <t t-call="pfb_npd_tax_invoice_payment.report_detail"/>
                            </td>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

</odoo>