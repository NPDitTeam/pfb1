<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="assets_common" name="l10n_ch_isr_report" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css" href="pfb_npd_payment_damaged/static/report.css"/>
        </xpath>
    </template>

    <record id="paperformat_payment_damaged_test" model="report.paperformat">
        <field name="name">A5 Custom</field>
        <field name="default" eval="False"/>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <report
            id="action_pfb_npd_payment_damaged"
            string="ใบเสร็จรับเงิน(ค่าปรับชำรุด)"
            name="pfb_npd_payment_damaged.damaged_payment_npd_pfb"
            model="account.payment"
            report_type="qweb-pdf"
            print_report_name="'ใบเสร็จรับเงิน(ค่าปรับชำรุด) - %s' % (object.name)"
            paperformat="pfb_npd_payment_damaged.paperformat_payment_damaged_test"
    />

    <template id="so_form_header">
        <style>
            .font_weight {
            font-weight: 800;
            }
            .address-line {
            font-size: 14px;
            margin-top: -3px;
            }
            .phone-line {
            font-size: 13px;
            margin-top: -5px;
            }
            .number-line {
            font-size: 13px;
            margin-top: -5px;
            }
            .tax-id {
            font-size: 14px;
            margin-top: -10px;
            display: block;
            }
            .header-container {
            display: flex;
            align-items: flex-start;
            }
            .company-info {
            margin-left: 40px;
            }
            .document-info {
            margin-top: 15px;
            <!--                margin-left: -20px;-->
            }
            .text-date {
            font-size: 14px;
            margin-top: -10px
            }
            .date-info {
            margin-top: -10px;
            }
        </style>
        <div class="row line-distance">
            <div class="col-1">
                <img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-1"/>
            <div class="col-7 company-info">
                <b>
                    <h5><strong><span t-esc="doc.company_id.name"/></strong></h5>
                </b>
                <p>
                    <span t-field="doc.branch_id.address" style="line-height: 1.5;font-size: 14px;"/>
                </p>
                <!--                <p class="address-line">-->
                <!--                    <span t-esc="doc.company_id.street"></span>-->
                <!--                    <span t-esc="doc.company_id.street2"></span>-->
                <!--                    <span t-esc="doc.company_id.city"></span>-->
                <!--                    จังหวัด<span t-esc="doc.company_id.state_id.name"></span>-->
                <!--                    <span t-esc="doc.company_id.zip"></span>-->
                <!--                </p>-->
                <p class="phone-line">
                    โทรศัพท์ / แฟกซ์ <span t-esc="doc.company_id.fax"></span> โทร. <span
                        t-esc="doc.company_id.phone"></span>
                </p>
                <p class="number-line">
                    เลขประจำตัวผู้เสียภาษี <span t-esc="doc.company_id.vat"></span>
                    <span t-if="doc.company_id.branch == '00000'">(สำนักงานใหญ่)</span>
                </p>
            </div>
            <!--            <div class="col-1"></div>-->
            <div class="col-4">
                <table width="100%">
                    <tr style="">
                        <td style="display:block;width: 150px;text-align: center;padding-top: 5px;">
                            <p class="text-center document-info"><h4><strong>ใบเสร็จรับเงิน</strong></h4></p>
                            <p class="text-center"><h5><strong>Receipt</strong></h5></p>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row" style="margin-bottom: 5px;"></div>
    </template>

    <template id="so_form_title">
        <style>
            .container-table {
            width: 19.5cm;
            height: 11.5cm;
            <!--                border: 1px solid black;-->
            padding: 5px;
            box-sizing: border-box;
            font-size: 13px;
            }
            .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            font-size: 13px;
            }
            .invoice-table, .invoice-table th, .invoice-table td {
            border: 1px solid black;
            font-size: 13px;
            }
            .invoice-table th, .invoice-table td {
            padding: 5px;
            <!--                text-align: right;-->
            vertical-align: top;
            font-size: 13px;
            }
            .bold {
            font-weight: bold;
            font-size: 13px;
            }
            .text-right {
            text-align: right;
            font-size: 13px;
            }
            .text-center {
            text-align: center;
            font-size: 13px;
            }
            .preserve-whitespace {
            white-space: pre;
            }
            .customer-info {
            margin-top: -5px;
            }
            .purchase-info {
            margin-top: -5px;
            }
            .line-distance {
            line-height: 1.5;
            }
        </style>

        <table class="container-table invoice-table line-distance">
            <tr>
                <div style="display: flex; justify-content: space-between;">
                    <td colspan="2">
                        <p>
                            <span class="text-left">ชื่อลูกค้า :</span>
                            <span class="text-left"><span t-esc="doc.partner_id.name"/></span>
                        </p>
                        <p class="customer-info">
                            <span class="preserve-whitespace"> ที่อยู่ :</span>
                            <span t-esc="doc.partner_id.street"/>
                            <span t-esc="doc.partner_id.street2"/>
                            <span t-esc="doc.partner_id.city"/>
                            <span t-esc="doc.partner_id.state_id.name"/>
                            <span t-esc="doc.partner_id.zip"/>
                        </p>
                        <p class="customer-info">
                            <span class="preserve-whitespace"> เลขประจำตัวผู้เสียภาษี</span>
                            <span t-esc="doc.partner_id.vat"/>
                            <span t-if="doc.partner_id.branch == '00000'">(สำนักงานใหญ่)</span>
                            <!--                            <span t-else="doc.partner_id.branch"/> สาขา <span t-esc="doc.partner_id.branch"/>-->
                            <!--                            <t t-if="len(doc.partner_id.branch) == 5">(สำนักงานใหญ่)</t>-->
                            <!--                            <t t-else="" t-esc="doc.partner_id.branch"/>-->
                        </p>
                    </td>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <td colspan="2">
                        <p>
                            <span class="text-left">เลขที่ / NO.</span>
                            <span t-esc="doc.name"/>
                        </p>
                        <p class="customer-info">
                            <span class="text-left">วันที่ / DATE</span>
                            <span t-esc="doc.date.strftime('%d') + ' ' + {1: 'ม.ค.', 2: 'ก.พ.', 3: 'มี.ค.', 4: 'เม.ย.', 5: 'พ.ค.', 6: 'มิ.ย.', 7: 'ก.ค.', 8: 'ส.ค.', 9: 'ก.ย.', 10: 'ต.ค.', 11: 'พ.ย.', 12: 'ธ.ค.'}[int(doc.date.strftime('%m'))] + ' ' + str(int(doc.date.strftime('%Y')) + 543)[-2:]"/>
                        </p>
                    </td>
                </div>
            </tr>
            <tr>
                <th class="text-center" width="15%">ลำดับ<br>NO.</br></th>
                <th class="text-center" width="55%">รายการ<br>DESCRIPTION</br></th>
                <th colspan="2" class="text-center">จำนวนเงิน<br>AMOUNT</br></th>
            </tr>
            <!--            <t t-set="cont_record" t-value="0"/>-->
            <!--            <t t-foreach="doc.reconciled_invoice_ids" t-as="i">-->
            <!--                <t t-foreach="i.line_ids" t-as="l">-->
            <!--                    <t t-if="l.product_id">-->
            <!--                        <t t-set="cont_record" t-value="cont_record + 1"/>-->
            <!--                        <tr>-->
            <!--                            <td class="text-center">-->
            <!--                                <span t-esc="cont_record"/>-->
            <!--                            </td>-->
            <!--                            <td><span t-esc="l.product_id.name"/></td>-->
            <!--                            <td colspan="2" class="text-right"><span t-esc="'{0:,.2f}'.format(l.total_amount)"/></td>-->
            <!--                        </tr>-->
            <!--                    </t>-->
            <!--                </t>-->
            <!--            </t>-->
            <tr>
                <td class="text-center">1</td>
                <!--                    <td class="text-center">-->
                <!--                        <span t-esc="cont_record"/>-->
                <!--                    </td>-->
                <t t-set="first" t-value="True"/>
                <t t-foreach="doc.reconciled_invoice_ids" t-as="i">
                    <t t-if="first">
                        <td>ค่าปรับชำรุด - ใบกำกับการเช่า เลขที่ <span t-esc="i.invoice_origin"/></td>
                        <t t-set="first" t-value="False"/>
                    </t>
                </t>
                <td colspan="2" class="text-right"><span t-esc="'{0:,.2f}'.format(doc.total_amount)"/></td>
            </tr>
            <tr>
                <td colspan="2" class="text-left">หมายเหตุ : ในการชำระเงินด้วยเช็คใบเสร็จรับเงินจะสมบูรณ์ต่อเมื่อบริษัทฯ
                    ได้รับเงินตามเช็คเรียบร้อยแล้ว</td>
                <td colspan="2" style="border-bottom: hidden;">
                    <!--                    <br/>-->
                    <!--                    <br/><br/>-->
                    <!--                    <span style="float: left;">ภาษีมูลค่าเพิ่ม7%</span>-->
                    <!--                    <span style="float: right;">-->
                    <!--                        <t t-set="total_vat" t-value="sum(group[1] for i in doc.reconciled_invoice_ids for group in i.amount_by_group)"/>-->
                    <!--                        <t t-esc="'{0:,.2f}'.format(total_vat)"/>-->
                    <!--                    </span>-->
                </td>
            </tr>
            <tr>
                <td class="text-center">จำนวนเงิน(ตัวอักษร)</td>
                <td colspan="1" class="text-center"><strong>(<span t-esc="doc.get_baht_text_damaged_receipt()"/>
                    )</strong></td>
                <td style="border-top: hidden;" colspan="2">
                    <span style="float: left;">จำนวนเงินทั้งสิ้น</span>
                    <span style="float: right;" t-esc="'{0:,.2f}'.format(doc.total_amount)"/>
                    <!--                    <span style="float: left;">รวมค่าปรับ(ก่อนภาษีมูลค่าเพิ่ม)</span>-->
                    <!--                    <span style="float: right;">-->
                    <!--&lt;!&ndash;                        <t t-esc="'{0:,.2f}'.format(sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids))"/>&ndash;&gt;-->
                    <!--                        <t t-set="total_untaxed_amount" t-value="sum(i.amount_untaxed_signed for i in doc.reconciled_invoice_ids)"/>-->
                    <!--                        <t t-esc="'{0:,.2f}'.format(total_untaxed_amount)"/>-->
                    <!--                    </span>-->
                </td>
            </tr>
            <tr>
                <td colspan="2" class="line-distance">
                    <p>
                        ชำระเงินโดย
                    </p>

                    <!-- ตรวจสอบ "เงินสด" -->
                    <p class="flex-item2">
                        <input type="checkbox"
                               t-att-checked="doc.payment_method_one_id and doc.payment_method_one_id.type == 'cash' or (doc.is_payment_multi and 'cash' in [payment.payment_method_id.type for payment in doc.paid_ids])"
                               class="mr-1"/>
                        <span>เงินสด</span>
                    </p>

                    <!-- ตรวจสอบ "โอนเงิน" -->
                    <p class="flex-item2">
                        <input type="checkbox"
                               t-att-checked="doc.payment_method_one_id and doc.payment_method_one_id.type == 'bank' and not doc.is_payment_multi or (doc.is_payment_multi and 'bank' in [payment.payment_method_id.type for payment in doc.paid_ids])"
                               class="mr-1"/>
                        <span class="mr-1">โอนเงิน</span>


                        <!-- กรณีใช้ paid_ids -->
                        <t t-if="doc.is_payment_multi and 'bank' in [payment.payment_method_id.type for payment in doc.paid_ids]">
                            <span t-esc="doc.company_id.name"/>
                            <t t-foreach="[payment for payment in doc.paid_ids if payment.payment_method_id.type == 'bank']"
                               t-as="payment">
                                <br/>
                                <span style="padding-left: 65px;">ธนาคาร:</span>
                                <t t-set="bank_info" t-value="payment.payment_method_id.name"/>
                                <t t-set="bank_name">
                                    <t t-if="bank_info and bank_info.find('SCB') != -1">ธนาคารไทยพาณิชย์</t>
                                    <t t-if="bank_info and bank_info.find('K') != -1">ธนาคารกสิกรไทย</t>
                                    <t t-if="bank_info and bank_info.find('BBL') != -1">ธนาคารกรุงเทพ</t>
                                    <t t-if="bank_info and bank_info.find('KTB') != -1">ธนาคารกรุงไทย</t>
                                    <t t-if="bank_info and bank_info.find('BAY') != -1">ธนาคารกรุงศรีอยุธยา</t>
                                    <t t-if="not (bank_info and (bank_info.find('SCB') != -1 or bank_info.find('K') != -1 or bank_info.find('BBL') != -1 or bank_info.find('KTB') != -1 or bank_info.find('BAY') != -1))">
                                        ธนาคารอื่น
                                    </t>
                                </t>
                                <span t-esc="bank_name" style="padding; 2px;"/>
                                <span class="ml-1">เลขที่บัญชี:</span>
                                <span class="ml-1" t-esc="payment.account_id.name[-13:]"/>
                            </t>
                        </t>
                        <!-- กรณีมีข้อมูลใน payment_method_one_id -->
                        <t t-elif="doc.payment_method_one_id and doc.payment_method_one_id.type == 'bank' and not doc.is_payment_multi">
                            <t t-set="bank_info" t-value="doc.payment_method_one_id.name"/>
                            <t t-set="bank_name">
                                <t t-if="bank_info and bank_info.find('SCB') != -1">ธนาคารไทยพาณิชย์</t>
                                <t t-if="bank_info and bank_info.find('K') != -1">ธนาคารกสิกรไทย</t>
                                <t t-if="bank_info and bank_info.find('BBL') != -1">ธนาคารกรุงเทพ</t>
                                <t t-if="bank_info and bank_info.find('KTB') != -1">ธนาคารกรุงไทย</t>
                                <t t-if="bank_info and bank_info.find('BAY') != -1">ธนาคารกรุงศรีอยุธยา</t>
                                <t t-if="not (bank_info and (bank_info.find('SCB') != -1 or bank_info.find('K') != -1 or bank_info.find('BBL') != -1 or bank_info.find('KTB') != -1 or bank_info.find('BAY') != -1))">
                                    ธนาคารอื่น
                                </t>
                            </t>
                            <span class="ml-1" t-esc="bank_name"/>
                            <span class="ml-1">เลขที่บัญชี</span>
                            <span class="ml-1" t-esc="doc.payment_method_one_id.account_id.name[-13:]"/>
                        </t>


                    </p>


                    <!-- ตรวจสอบ "เช็ค" -->
                    <p class="flex-item2">
                        <input type="checkbox"
                               t-att-checked="doc.payment_method_one_id and doc.payment_method_one_id.type == 'cheque' or (doc.is_payment_multi and 'cheque' in [payment.payment_method_id.type for payment in doc.paid_ids])"
                               class="mr-1"/>
                        <span class="mr-1">เช็ค</span>

                        <!-- กรณีดึงข้อมูลจาก paid_ids -->
                        <t t-if="doc.is_payment_multi and 'cheque' in [payment.payment_method_id.type for payment in doc.paid_ids]">
                            <t t-set="count" t-value="0"/>
                            <t t-foreach="[payment for payment in doc.paid_ids if payment.payment_method_id.type == 'cheque']"
                               t-as="payment">
                                <t t-if="count == 0">
                                    <span class="ml-1" style="padding-left: 15px;">
                                        ธนาคาร: <span t-esc="payment.cheque_id.bank_id.name"/>
                                    </span>
                                    <span class="ml-1">
                                        สาขา: <span t-esc="payment.cheque_id.bank_id.branch_name"/>
                                    </span>
                                    <span class="ml-1">
                                        เลขที่เช็ค: <span class="ml-1" t-esc="payment.cheque_id.name"/>
                                    </span>
                                    <t t-set="count" t-value="1"/>
                                </t>
                                <t t-else="">
                                    <br/>
                                    <span class="ml-1" style="padding-left: 62px;">
                                        ธนาคาร: <span t-esc="payment.cheque_id.bank_id.name"/>
                                    </span>
                                    <span class="ml-1">
                                        สาขา: <span t-esc="payment.cheque_id.bank_id.branch_name"/>
                                    </span>
                                    <span class="ml-1">
                                        เลขที่เช็ค: <span class="ml-1" t-esc="payment.cheque_id.name"/>
                                    </span>
                                </t>
                            </t>
                        </t>
                        <!-- กรณีดึงข้อมูลจาก payment_method_one_id -->
                        <t t-elif="doc.payment_method_one_id and doc.payment_method_one_id.type == 'cheque' and not doc.is_payment_multi">
                            <span class="ml-1">
                                ธนาคาร: <span t-esc="doc.cheque_one_id.bank_id.name"/>
                            </span>
                            <span class="ml-1">
                                สาขา: <span t-esc="doc.cheque_one_id.bank_id.branch_name"/>
                            </span>
                            <span class="ml-1">
                                เลขที่เช็ค: <span class="ml-1" t-esc="doc.cheque_one_id.name"/>
                            </span>
                        </t>


                    </p>

                    <!-- ตรวจสอบ "อื่น" -->
                    <p class="flex-item2">
                        <input type="checkbox"
                               t-att-checked="doc.payment_method_one_id and doc.payment_method_one_id.type == 'other' and not doc.is_payment_multi or (doc.is_payment_multi and 'other' in [payment.payment_method_id.type for payment in doc.paid_ids])"
                               class="mr-1"/>
                        <span class="ml-1">อื่นๆ</span>

                        <!-- กรณีใช้ paid_ids -->
                        <t t-if="doc.is_payment_multi and 'other' in [payment.payment_method_id.type for payment in doc.paid_ids]">
                            <t t-set="count" t-value="0"/>
                            <t t-foreach="[payment for payment in doc.paid_ids if payment.payment_method_id.type == 'other']"
                               t-as="payment">
                                <t t-if="count == 0">
                                    <span style="padding-left: 30px;" t-esc="payment.payment_method_id.name"/>
                                    <t t-set="count" t-value="1"/>
                                </t>
                                <t t-else="">
                                    <br/>
                                    <span style="padding-left: 30px;" t-esc="payment.payment_method_id.name"/>
                                </t>
                            </t>
                        </t>
                        <!-- กรณีมีข้อมูลใน payment_method_one_id -->
                        <t t-elif="doc.payment_method_one_id and doc.payment_method_one_id.type == 'other' and not doc.is_payment_multi">
                            <span style="padding-left: 30px;" t-esc="doc.payment_method_one_id.name"/>
                        </t>


                    </p>


                </td>
                <td colspan="2" style="border-left: hidden;">
                    <p>
                        <div class="row" style="margin-bottom: 80px;"/>
                    </p>
                    <p class="text-center">
                        <span t-esc="doc.create_uid.name"/>
                        ..............................................................................
                    </p>
                    <p class="text-center">
                        <span>ผู้รับเงิน / COLLECTOR</span>
                    </p>
                </td>
            </tr>

        </table>
    </template>

    <template id="damaged_payment_npd_pfb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="plus" t-value="0"/>
                    <table width="100%" border="1">
                        <tr>
                            <td>
                                <!--                                Header-->
                                <t t-call="pfb_npd_payment_damaged.so_form_header"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <!--                                Title-->
                                <t t-call="pfb_npd_payment_damaged.so_form_title"/>
                            </td>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

</odoo>