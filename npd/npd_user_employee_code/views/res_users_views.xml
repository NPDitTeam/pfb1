<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_employee_code" model="ir.ui.view">
        <field name="name">res.users.form.inherit.employee.code</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/group[last()]" position="after">
                <group>
                    <field name="employee_code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
