                    <!--                        </td>-->
                    <!--                    </tr>-->
                </table>
            </div>
            <div class="col-2">
                <table class="width :100%">
                    <tr>
                        <td class="text-center" style="font-size: 16px;"><strong>ใบเสร็จรับเงิน</strong></td>
                    </tr>
                    <tr>
                        <td class="text-center" style="font-size: 16px;">
                            <strong>RECEIPT</strong>
                        </td>
                    </tr>
