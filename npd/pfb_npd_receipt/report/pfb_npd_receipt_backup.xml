<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--        กำหนดค่ากระดาษ-->
    <record id="paperformat_pfb_npd_receipt" model="report.paperformat">
        <field name="name">A5 Sample</field>
        <field name="default" eval="False"/>
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field> <!-- ระยะขอบด้านบนตั้งค่าเป็น 1 หน่วย -->
        <field name="margin_bottom">5</field> <!-- ระยะขอบด้านล่างตั้งค่าเป็น 5 หน่วย -->
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <!-- กำหนดขนาดตัวอักษรเป็น 12 -->
        <!--        <field name="font_size">12</field>-->
    </record>

    <report
            id="action_pfb_npd_receipt"
            string="ใบเสร็จรับเงิน(ค่าประกัน)"
            name="pfb_npd_receipt.report_pfb_npd_receipt"
