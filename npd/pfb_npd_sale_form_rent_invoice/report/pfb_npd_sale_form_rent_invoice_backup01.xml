    <template id="report_header">
        <style>
            .mt-1 {
            margin-top: 1rem;
            }
            .mb-1 {
            margin-bottom: 1rem;
            }
            .ml-45 {
            margin-left: 50px;
            }.ml-2 {
            margin-left: 10px;
            }
        </style><br/>
        <div class="row">
            <div class="col-2 mr-1" style="margin-top: 14px;">
                <img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-7" style="margin-top: 15px;">
                <table style="width: 100%;" class="ml-45">
                    <tr>
                        <td><strong class="ml-2" style="font-size: 22px;">ใบกำกับการเช่า</strong></td>
                    </tr>
                    <tr>
                        <td><strong class="ml-2" style="font-size: 13px;"><span
                                t-esc="doc.company_id.name"/></strong></td>
                    </tr>
                    <tr>
                        <td style="padding-left: 10px;font-size: 14px">
                            <span t-field="doc.branch_id.address" style="line-height: 1.3;font-size: 13px;"/><br/>
