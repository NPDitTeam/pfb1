                                    <span t-if="doc.branch_id.telephone == '00000'">(สำนักงานใหญ่)</span>
                        </td>
                    </tr>
                </table>
            </div>        <!-- โลโก้บริษัท -->
            <div class="col-3" style="margin-top: 15px;">
                <table style="width: 100%;">
                    <tr>
                        <td class="text-center"><strong style="font-size: 18px;">เลขที่ใบเช่า</strong></td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <strong style="font-size: 13px;"><span t-esc="doc.name"/></strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <strong style="font-size: 13px;">อ้างอิงใบกำกับการเช่า</strong>
