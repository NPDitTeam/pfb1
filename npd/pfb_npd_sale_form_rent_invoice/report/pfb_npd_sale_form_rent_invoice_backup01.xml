    <template id="report_table">
        <style>
            .table2{
            width: 100%;
            height: 140px;
            }
        </style>
        <table width="100%" style="mt-1">
            <thead>
                <tr style="border-bottom: 1px solid black !important; font-size: 13px;">
                    <th width="3%" class="text-center border_report" style="font-size: 13px;">ลำดับ</th>
                    <th width="15%" class="text-center border_report" style="font-size: 13px;">รายการสินค้า</th>
                    <th width="7%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">น้ำหนักสินค้า</th>
                    <th width="12%" class="text-center border_report" style="padding: 0 6px;font-size: 13px;">ค่าปรับ/เงินประกัน<br/>ราคาสินค้า(ชิ้น)</th>
                    <th width="9%" class="text-center border_report" style="padding: 0 6px;font-size: 13px;">ค่าซ่อมแซม<br/>(B/ชิ้น)</th>
                    <th width="9%" class="text-center border_report" style="padding: 0 4px;font-size: 13px;">ค่าเช่า<br/>รายวัน(บาท)</th>
                    <th width="11%" class="text-center border_report" style="padding: 0 4px;font-size: 13px;">รวมค่าเช่า<br/>รายวัน</th>
                    <th width="10%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">ราคาต่อหน่วย</th>
                    <th width="6%" class="text-right border_report" style="font-size: 13px;">จำนวน</th>
                    <th width="12%" class="text-right border_report" style="font-size: 13px;">รวมเป็นเงิน</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="c" t-value="0"/>
                <t t-foreach="doc.order_line" t-as="l">
                    <tr>
                        <td class="text-center" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="l_index + 1"/></td>
                        <td class="text-left" style="font-size: 13px;border-bottom:hidden;">
<!--                            [<span t-esc="l.product_template_id.default_code"/>] -->
                            <span t-esc="l.product_template_id.name"/></td>
                        <td class="text-right" style="font-size: 13px; border-bottom: hidden;">
                            <span t-esc="'{0:,.2f}'.format(l.second_uom_qty * l.pfb_quantity)"/>
                        </td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="'{0:,.2f}'.format(l.pfb_insurance_price or 0)"/></td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;">ตามจริง</td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="'{0:,.2f}'.format(l.price_unit or 0)"/></td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="'{0:,.2f}'.format((l.price_subtotal or 0) * 1.07)"/></td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="'{0:,.2f}'.format(l.price_unit)"/></td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="'{0:,.0f}'.format(l.pfb_quantity)"/></td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                t-esc="'{0:,.2f}'.format((l.price_subtotal or 0) * 1.07)"/></td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

