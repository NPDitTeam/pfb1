<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--        กำหนดค่ากระดาษ-->
    <record id="paperformat_pfb_npd_sale_form_rent_invoice" model="report.paperformat">
        <field name="name">A4 Sample</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">60</field> <!-- ระยะขอบด้านบน -->
        <field name="margin_bottom">110</field> <!-- ระยะขอบด้านล่างตั้งค่าเป็น 5 หน่วย -->
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">60</field>
        <!-- กำหนดขนาดตัวอักษรเป็น 12 -->
        <!--        <field name="font_size">12</field>-->
    </record>

    <report
            id="action_rent_invoice"
            string="ใบกำกับการเช่า"
            name="pfb_npd_sale_form_rent_invoice.report_pfb_npd_sale_form_rent_invoice"
            model="sale.order"
            report_type="qweb-pdf"
            print_report_name="'Sale - %s' %(object.name)"
            paperformat="pfb_npd_sale_form_rent_invoice.paperformat_pfb_npd_sale_form_rent_invoice"
    />

