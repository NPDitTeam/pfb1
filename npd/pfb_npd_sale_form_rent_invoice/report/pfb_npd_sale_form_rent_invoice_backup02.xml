    <!--    ตาราง-->
    <template id="report_table">
        <style>
            .table2{
            width: 100%;
            height: 140px;
            }
            .page-break {
                page-break-before: always;
            }
            .empty-row td {
                height: 22px;
            }
        </style>
        <t t-set="chunk_size" t-value="21"/>
        <t t-set="order_lines" t-value="doc.order_line"/>
        <t t-set="total_lines" t-value="len(order_lines)"/>
        <t t-set="num_chunks" t-value="max(1, (total_lines + chunk_size - 1) // chunk_size)"/>
        <t t-foreach="range(num_chunks)" t-as="group_index">
            <t t-set="start" t-value="group_index * chunk_size"/>
            <t t-set="end" t-value="start + chunk_size"/>
            <t t-set="group" t-value="order_lines[start:end]"/>
            <t t-set="empty_count" t-value="chunk_size - len(group)"/>
            <table width="100%" style="mt-1">
                <thead>
                    <tr style="border-bottom: 1px solid black !important; font-size: 13px;">
                        <th width="3%" class="text-center border_report" style="font-size: 13px;">ลำดับ</th>
                        <th width="20%" class="text-center border_report" style="font-size: 13px;">รายการสินค้า</th>
                        <th width="7%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">น้ำหนักสินค้า</th>
                        <th width="6%" class="text-right border_report" style="font-size: 13px;">จำนวน</th>
                        <th width="12%" class="text-right border_report" style="padding: 0 6px;font-size: 13px;">ค่าปรับเงินประกัน<br/>หลังหักค่าเสื่อมแล้ว</th>
                        <th width="9%" class="text-right border_report" style="padding: 0 6px;font-size: 13px;">ค่าซ่อมแซม<br/>(B/ชิ้น)</th>
                        <th width="9%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">ค่าเช่า<br/>ต่อหน่วย</th>
                        <th width="11%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">รวมเป็นเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="group" t-as="l">
                        <tr>
                            <td class="text-center" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="start + l_index + 1"/></td>
                            <td class="text-left" style="font-size: 13px;border-bottom:hidden;">
                                <span t-esc="l.product_template_id.name"/></td>
                            <td class="text-right" style="font-size: 13px; border-bottom: hidden;">
                                <span t-esc="'{0:,.2f}'.format(l.second_uom_qty * l.pfb_quantity)"/>
                            </td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.0f}'.format(l.pfb_quantity)"/></td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.2f}'.format(l.pfb_insurance_price or 0)"/></td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;">ตามจริง</td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.2f}'.format((l.price_unit_no_vat or 0))"/></td>
                            <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span
                                    t-esc="'{0:,.2f}'.format((l.price_subtotal or 0))"/></td>
                        </tr>
                    </t>
                    <t t-foreach="range(empty_count)" t-as="empty_i">
                        <tr class="empty-row">
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                            <td style="font-size: 13px;border-bottom:hidden;">&#160;</td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <t t-if="group_index + 1 &lt; num_chunks">
                <div class="page-break"/>
            </t>
        </t>
    </template>

