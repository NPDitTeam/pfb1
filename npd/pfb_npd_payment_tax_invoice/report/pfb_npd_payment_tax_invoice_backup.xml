<!--                    โทรศัพท์ / แฟกซ์ <span t-esc="doc.company_id.fax"></span> โทร. <span t-esc="doc.company_id.phone"></span>-->
<!--                </p>-->
<!--                <p class="number-line">-->
<!--                    เลขประจำตัวผู้เสียภาษี <span t-esc="doc.company_id.vat"></span>-->
<!--                    <span t-if="doc.company_id.branch == '00000'">(สำนักงานใหญ่)</span>-->
<!--                </p>-->
            </div>
<!--            <div class="col-1"></div>-->
            <div class="col-4">
                <table width="100%">
                    <tr style="">
                        <td style="display:block;width: 150px;text-align: center;padding-top: 5px;">
                            <p class="text-center document-info"><h4><strong>ใบกำกับภาษี</strong></h4></p>
                            <p class="text-center"><h5><strong>Tax Invoice</strong></h5></p>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row" style="margin-bottom: 5px;"></div>
