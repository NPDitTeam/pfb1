    <template id="so_form_title">
        <style>
            .container-table {
                width: 19.5cm;
                height: 11.5cm;
<!--                border: 1px solid black;-->
                padding: 5px;
                box-sizing: border-box;
                font-size: 13px;
            }
            .invoice-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
                font-size: 13px;
            }
            .invoice-table, .invoice-table th, .invoice-table td {
                border: 1px solid black;
                font-size: 13px;
            }
            .invoice-table th, .invoice-table td {
                padding: 5px;
<!--                text-align: right;-->
                vertical-align: top;
                font-size: 13px;
            }
            .bold {
                font-weight: bold;
                font-size: 13px;
            }
            .text-right {
                text-align: right;
                font-size: 13px;
            }
            .text-center {
                text-align: center;
                font-size: 13px;
            }
            .preserve-whitespace {
                white-space: pre;
            }
            .customer-info {
                margin-top: -5px;
            }
            .purchase-info {
                margin-top: -5px;
            }
        </style>

        <table class="container-table invoice-table line-distance">
