<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="assets_common" name="l10n_ch_isr_report" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css" href="pfb_npd_payment_tax_invoice/static/report.css"/>
        </xpath>
    </template>

    <record id="paperformat_payment_tax_invoice_test" model="report.paperformat">
        <field name="name">A5 Custom</field>
        <field name="default" eval="False" />
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <report
            id="action_pfb_npd_payment_tax_invoice"
            string="ใบกำกับภาษี"
            name="pfb_npd_payment_tax_invoice.tax_invoice_payment_npd_pfb"
            model="account.payment"
            report_type="qweb-pdf"
            print_report_name="'ใบกำกับภาษี - %s' % (object.name)"
            paperformat="pfb_npd_payment_tax_invoice.paperformat_payment_tax_invoice_test"
    />

