    <template id="so_form_detail_top">
    <style>
        .preserve-whitespace {
            white-space: pre;
        }
        .line-distance {
            line-height: 1;
            font-size: 16px !important;
        }
        .small-font {
            font-size: 16px !important;
        }
        .border_report {
            border-bottom: 1px solid black !important;
            border-top: 1px solid black !important
        }
        .page-break {
            page-break-before: always;
        }
    </style>

    <t t-set="order_lines" t-value="doc.order_line"/>
    <t t-set="chunk_size" t-value="11"/>
    <t t-set="chunks" t-value="[order_lines[i:i + chunk_size] for i in range(0, len(order_lines), chunk_size)]"/>

    <t t-foreach="chunks" t-as="group" t-index="group_index">
        <table width="100%" class="table mt-1 mb-3">
            <thead>
                <tr style="border-bottom: 1px solid black !important;">
                    <th width="1%" class="text-left small-font number-col border_report">No.</th>
                    <th width="13%" class="text-center small-font pass-col border_report">รหัส</th>
                    <th width="24%" class="text-left small-font list-col border_report preserve-whitespace">รายการสินค้า</th>
                    <th width="9%" class="text-right small-font weight-col border_report">น้ำหนัก [กิโลกรัม]</th>
                    <th width="9%" class="text-right small-font rent-col border_report">ค่าเช่า [ชุด,ชิ้น]</th>
                    <th width="9%" class="text-right small-font quantity-col border_report">จำนวน [ชุด,ชิ้น]</th>
                    <th width="13%" class="text-right small-font rent-total-col border_report"><strong>รวมค่าเช่า</strong></th>
                    <th width="10%" class="text-right small-font guarantee-col border_report">ค่าประกัน [ชุด,ชิ้น]</th>
                    <th width="14%" class="text-right small-font guarantee-total-col border_report"><strong>รวมประกัน</strong></th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="group" t-as="l" t-index="l_index">
                    <t t-set="multi" t-value="multi + l.pfb_quantity"/>
                    <t t-set="ply" t-value="ply + l.product_uom_qty"/>
                    <t t-set="wei" t-value="wei + l.second_uom_qty"/>
                    <tr>
                        <td class="text-right line-distance number-col"><span t-esc="group_index * chunk_size + l_index + 1"/></td>
                        <td class="text-right line-distance pass-col"><span t-esc="l.name.split(' ')[0]"/></td>
                        <td class="text-left line-distance list-col"><span t-esc="l.name.split(' ', 1)[1]"/></td>
                        <td class="text-right line-distance weight-col">
                            <span t-esc="'{0:,.2f}'.format(l.second_uom_qty * l.pfb_quantity)"/>
                        </td>
                        <td class="text-right line-distance rent-col"><span t-esc="'{0:,.2f}'.format(l.price_unit_no_vat)"/></td>
                        <td class="text-right line-distance quantity-col"><span t-esc="'{0:,.0f}'.format(l.pfb_quantity)"/></td>
                        <td class="text-right line-distance rent-total-col"><span t-esc="'{0:,.2f}'.format((l.price_subtotal or 0) * 1.07)"/></td>
                        <td class="text-right line-distance guarantee-col"><span t-esc="'{0:,.2f}'.format(l.pfb_insurance_price)"/></td>
                        <td class="text-right line-distance guarantee-total-col"><span t-esc="'{0:,.2f}'.format(l.pfb_quantity * l.pfb_insurance_price)"/></td>
                    </tr>
                </t>
            </tbody>
        </table>

        <!-- เพิ่มการแบ่งหน้า ถ้าไม่ใช่กลุ่มสุดท้าย -->
        <t t-if="group_index + 1 &lt; len(chunks)">

            <div class="page-break"/>
        </t>
    </t>
</template>


