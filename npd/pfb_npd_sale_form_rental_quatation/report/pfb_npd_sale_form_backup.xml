    <template id="form_sale_npd_pfb">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-set="order_lines" t-value="doc.order_line"/>
            <t t-set="chunk_size" t-value="11"/>
            <t t-set="chunks" t-value="[order_lines[i:i + chunk_size] for i in range(0, len(order_lines), chunk_size)]"/>

            <t t-foreach="chunks" t-as="group" t-index="group_index">
                <div class="page">
                    <t t-call="web.basic_layout">
                        <!-- Header -->
                        <t t-call="pfb_npd_sale_form_rental_quatation.so_form_header"/>

                        <!-- Title (optionally show every page) -->
                        <t t-call="pfb_npd_sale_form_rental_quatation.so_form_title"/>

                        <!-- Detail Table -->
                        <table width="100%" class="table mt-1 mb-3">
                            <thead>
                                <tr style="border-bottom: 1px solid black !important;">
                                    <th width="1%" class="text-left small-font number-col border_report">No.</th>
<!--                                    <th width="9%" class="text-center small-font pass-col border_report">รหัส</th>-->
                                    <th width="23%" class="text-left small-font list-col border_report">รายการสินค้า</th>
                                    <th width="7%" class="text-right small-font weight-col border_report">น้ำหนัก</th>

                                    <th width="6%" class="text-right small-font quantity-col border_report">จำนวน</th>

                                    <th width="16%" class="text-center small-font guarantee-col border_report"> ค่าปรับ/เงินประกัน<br/>ราคาสินค้า(ชิ้น)</th>
                                    <th width="9%" class="text-center small-font guarantee-col border_report">ค่าซ่อมแซม<br/>(B/ชิ้น)</th>
                                    <th width="9%" class="text-center small-font rent-col border_report">ค่าเช่า<br/>ต่อหน่วย</th>
                                    <th width="11%" class="text-center small-font rent-total-col border_report">รวมค่าเช่า<br/>รายวัน</th>
                                    <th width="11%" class="text-right small-font guarantee-total-col border_report">รวมประกัน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="group" t-as="l" t-index="l_index">
                                    <tr>
                                        <td class="text-right"><span t-esc="group_index * chunk_size + l_index + 1"/></td>
<!--                                        <td class="text-right"><span t-esc="l.name.split(' ')[0]"/></td>-->
                                        <td class="text-left"><span t-esc="l.product_template_id.name"/></td>

                                        <td class="text-right"><span t-esc="'{0:,.2f}'.format((l.second_uom_qty or 0) * (l.pfb_quantity or 0))"/></td>
                                        <td class="text-right"><span t-esc="'{0:,.0f}'.format(l.pfb_quantity or 0)"/></td>

                                        <td class="text-right"><span t-esc="'{0:,.2f}'.format(l.pfb_insurance_price or 0)"/></td>
                                         <td class="text-right">ตามจริง</td>
                                        <td class="text-right"><span t-esc="'{0:,.2f}'.format(l.price_unit_no_vat or 0)"/></td>
                                        <td class="text-right"><span t-esc="'{0:,.2f}'.format(l.price_subtotal or 0)"/></td>
                                        <td class="text-right"><span t-esc="'{0:,.2f}'.format((l.pfb_quantity or 0) * (l.pfb_insurance_price or 0))"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Footer แสดงทุกหน้า -->
                        <t t-call="pfb_npd_sale_form_rental_quatation.so_form_footer"/>
                    </t>
                </div>

                <!-- Page break ถ้าไม่ใช่หน้าสุดท้าย -->
                <t t-if="group_index + 1 &lt; len(chunks)">
                    <div class="page-break"/>
                </t>
            </t>
        </t>
    </t>
</template>




