<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- ปุ่ม: ดึงส่วนลดค่าเช่าจากใบคืน → บวกเข้า target_amount_total -->
            <xpath expr="//header" position="inside">
                <button name="action_pull_return_rent_discount"
                        string="ดึงส่วนลดค่าเช่าจากใบคืน"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', ('move_type', '!=', 'out_refund'), ('state', '!=', 'draft')]}"
                        confirm="ระบบจะรวมส่วนลดค่าเช่า (rent_discount) จากใบคืนที่อนุมัติแล้ว แล้วปรับยอดเป้าหมาย (Target Total) ของใบลดหนี้นี้ให้รวมส่วนลดดังกล่าว ต้องการดำเนินการหรือไม่?"/>
            </xpath>

            <field name="payment_reference" position="after">
                <field name="pfb_so_type"/>
<!--                <field name="pfb_date_of_rent"/>-->
                <field name="pfb_objective_id"/>
            </field>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="pfb_so_rent_ok" invisible="1"/>

               <field name="move_state_parent" invisible="1"/>
    <field name="move_type_parent" invisible="1"/>

 <field name="pfb_date_of_rent" force_save="1"
                       attrs="{
                           'invisible': [('pfb_so_rent_ok', '=', 0)],
                           'readonly': [('move_type_parent', '!=', 'out_refund'), ('move_state_parent', '!=', 'draft')]
                       }"/>
<!--                <field name="pfb_date_of_rent" force_save="1" attrs="{'invisible': [('pfb_so_rent_ok', '=', 0)]}" readonly='1'/>-->

<!--<field name="pfb_quantity" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)],}" readonly='1' force_save="1"/>-->

                <field name="pfb_quantity"  force_save="1"
                       attrs="{'invisible': [('pfb_so_rent_ok', '=',0)],
                       'readonly': [('move_type_parent', '!=', 'out_refund'), ('move_state_parent', '!=', 'draft')]}" />

            </xpath>
<!--            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']" position="after">-->
<!--                <field name="pfb_insurance_price" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}" readonly='1' force_save="1"/>-->
<!--            </xpath>-->
             <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='price_unit']" position="before">
                  <field name="discount_type_selection"/>
            </xpath>
            <!-- เพิ่ม total_rental_discount หลัง amount_untaxed -->
        <xpath expr="//field[@name='amount_untaxed']" position="after">
            <field name="total_rental_discount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
            <field name="npd_return_rent_discount_pulled" widget="monetary"
                   options="{'currency_field': 'currency_id'}" readonly="1"
                   attrs="{'invisible': [('npd_return_rent_discount_pulled', '=', 0)]}"/>

        </xpath>

        </field>
    </record>
</odoo>
