<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="assets_common" name="office_rent_billing_sheet_assets" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css" href="pfb_npd_office_rent_billing_sheet/static/report.css"/>
        </xpath>
    </template>

    <!--        กำหนดค่ากระดาษ-->
    <record id="paperformat_office_rent_billing_sheet" model="report.paperformat">
        <field name="name">A4 Office Rent Invoice (account.move)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <!-- ===== ปุ่มพิมพ์ในหน้าใบแจ้งหนี้ account.move (เมนู "พิมพ์") ===== -->
    <report
            id="action_office_rent_billing_sheet"
            string="ใบแจ้งหนี้ค่าเช่าพื้นที่สำนักงาน"
            name="pfb_npd_office_rent_billing_sheet.report_office_rent_billing_sheet"
            model="account.move"
            report_type="qweb-pdf"
            print_report_name="'Office Rent Invoice - %s' %(object.name)"
            paperformat="pfb_npd_office_rent_billing_sheet.paperformat_office_rent_billing_sheet"
    />

    <!--    หัวข้อรายงาน -->
    <template id="report_header">
        <style>
            .mt-1 {
            margin-top: 1rem;
            }
            .mb-1 {
            margin-bottom: 1rem;
            }
            .ml-45 {
            margin-left: 40px;
            }.ml-3 {
            margin-left: 45px;
            }.text-left {
            text-align: left;
            }
            .text-right {
            text-align: right;
            }.col-7_report, .col-2_report, .col-1_report{
            padding-left: 0;
            }.text_bold{ font-weight: 600;}
        </style>
        <div class="row">
            <div class="col-2">
                <img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-7">
                <table width="100%" class="ml-45">
                    <tr>
                        <td><strong class="a" style="font-size: 19px;"><span t-esc="doc.company_id.name"/></strong></td>
                    </tr>
                    <tr>
                        <td>
                            <span class="b" t-field="user.branch_id.address" style="line-height: 1.5;font-size: 14px;"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="b" style="font-size: 14px;">
                            <t t-if="env.cr.dbname == 'NPD_S_Group_New_V2'">
                            </t>
                            <t t-else="">
                                เลขประจำตัวผู้เสียภาษี <span t-esc="doc.company_id.vat"/>
                            </t>
                            <span t-if="user.branch_id.telephone == '00000'">(สำนักงานใหญ่)</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-3">
                <table width=" 100%">
                    <tr>
                        <td class="text-center" style="white-space: nowrap; line-height: 1.8; padding-top: 12px;">
                            <strong class="a" style="font-size: 15px;">ใบแจ้งหนี้ค่าเช่าพื้นที่สำนักงาน</strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center" style="line-height: 1.8;">
                            <strong class="c" style="font-size: 14px;">INVOICE / BILLING NOTE</strong>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <p class="c" style="font-size: 15px ;color : white">.</p>
        <div class="row">
            <div class="col-2_report">
                <table width="100%">
                    <tr>
                        <td class="text-right text_bold b" style="font-size: 14px; padding-left: 25px;padding-right: 0;">
                            <span>ชื่อลูกค้า :</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right text_bold b" style="font-size: 14px; padding-left: 25px;padding-right: 0;">
                            <span>ที่อยู่ :</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size: 10px ;color : white">.</td>
                    </tr>
                    <tr>
                        <td class="text-right text_bold b" style="font-size: 14px; padding-left: 25px;padding-right: 0;">
                            <span>เบอร์โทรศัพท์ :</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right text_bold b" style="font-size: 14px; padding-left: 25px;padding-right: 0;">
                            <span>เลขที่ผู้เสียภาษี :</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-7_report">
                <table width="100%">
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0; padding-right: 150px;"><span
                                class="ml-1" t-esc="doc.partner_id.name"/></td>
                    </tr>
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0; padding-right: 150px;">
                            <span class="ml-1" t-esc="doc.partner_id.street"/>
                            <span class="ml-1" t-esc="doc.partner_id.street2"/>
                            <span class="ml-1" t-esc="doc.partner_id.city"/>
                            <span class="ml-1" t-esc="doc.partner_id.state_id.name"/>
                            <span class="ml-1" t-esc="doc.partner_id.zip"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size: 10px ;color : white">.</td>
                    </tr>
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0px; padding-right: 150px;">
                            <span class="ml-1" t-esc="doc.partner_id.phone"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0px; padding-right: 150px;">
                            <span class="ml-1" t-esc="doc.partner_id.vat"/>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-1_report">
                <table width="100%">
                    <tr>
                        <td class="text-right text_bold b"
                            style="font-size: 14px;padding-left: 10px; padding-right: 0px;">
                            <span>เลขที่ :</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right text_bold b"
                            style="font-size: 14px;padding-left: 10px; padding-right: 0px;">
                            <span>วันที่ :</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right text_bold b"
                            style="font-size: 14px;padding-left: 10px; padding-right: 0px;">
                            <span>วันที่กำหนดจ่าย :</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-2_report">
                <table width="100%">
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0px;">
                            <span class="ml-1" t-esc="doc.name"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0px;">
                            <span class="ml-1" t-esc="doc.invoice_date.strftime('%d-%m-%Y') if doc.invoice_date else ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-left b" style="font-size: 14px; padding-left: 0px;">
                            <span class="ml-1" t-esc="doc.invoice_date_due.strftime('%d-%m-%Y') if doc.invoice_date_due else ''"/>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <p style="color : white; font-size: 18px;">.</p>
        <!-- ===== ตารางรายการ: ดึงรายการจากใบแจ้งหนี้ (invoice_line_ids) ที่กำลังพิมพ์ ===== -->
        <table width="100%" class="table" style="margin-top: 18px;">
            <thead>
                <tr class="b" style="border-bottom: 1px solid black !important;">
                    <th width="6%" class="text-center border_report" style="font-size: 14px;">ลำดับ</th>
                    <th width="46%" class="text-left  border_report" style="font-size: 14px;">รายการ</th>
                    <th width="16%" class="text-right border_report" style="font-size: 14px;">ค่าเช่าต่อวัน</th>
                    <th width="12%" class="text-right border_report" style="font-size: 14px;">จำนวนวัน</th>
                    <th width="20%" class="text-right border_report" style="font-size: 14px;">จำนวนเงิน</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="lines" t-value="doc.get_office_rent_lines()"/>
                <t t-set="line_count" t-value="len(lines)"/>
                <t t-foreach="lines" t-as="l">
                    <tr class="b">
                        <td class="text-center" style="font-size: 14px;border-bottom:hidden;height:26px;"><span t-esc="l_index + 1"/></td>
                        <td class="text-left" style="font-size: 14px;border-bottom:hidden;height:26px;"><span t-esc="l.name or l.product_id.name"/></td>
                        <td class="text-right" style="font-size: 14px;border-bottom:hidden;height:26px;">
                            <span t-if="l.pfb_date_of_rent" t-esc="'{0:,.2f}'.format(l.price_unit or 0)"/>
                        </td>
                        <td class="text-right" style="font-size: 14px;border-bottom:hidden;height:26px;"><span
                                t-esc="'{0:,.2f}'.format(l.pfb_quantity or 0)"/></td>
                        <td class="text-right" style="font-size: 14px;border-bottom:hidden;height:26px;"><span
                                t-esc="'{0:,.2f}'.format(l.price_unit_no_vat or 0)"/></td>
                    </tr>
                </t>
                <!-- เติมแถวว่างให้ครบ 10 แถว (ล็อกพื้นที่ตรงกลาง) -->
                <t t-foreach="range(max(0, 10 - line_count))" t-as="empty_i">
                    <tr class="b">
                        <td style="font-size: 14px;border-bottom:hidden;height:26px;">&#160;</td>
                        <td style="font-size: 14px;border-bottom:hidden;height:26px;">&#160;</td>
                        <td style="font-size: 14px;border-bottom:hidden;height:26px;">&#160;</td>
                        <td style="font-size: 14px;border-bottom:hidden;height:26px;">&#160;</td>
                        <td style="font-size: 14px;border-bottom:hidden;height:26px;">&#160;</td>
                    </tr>
                </t>
            </tbody>
        </table>
        <p style="color : white; font-size: 20px;">.</p>
    </template>


