<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_npd_adjust_decimal_wizard_form" model="ir.ui.view">
        <field name="name">npd.adjust.decimal.wizard.form</field>
        <field name="model">npd.adjust.decimal.wizard</field>
        <field name="arch" type="xml">
            <form string="แก้ไขยอดทศนิยม">
                <sheet>
                    <div class="oe_title">
                        <h2>ปรับยอดทศนิยม</h2>
                    </div>
                    <group>
                        <group string="ข้อมูลเอกสาร">
                            <field name="move_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="current_total" readonly="1"
                                   widget="monetary"/>
                        </group>
                        <group string="เลือกค่าปรับ">
                            <field name="adjustment_choice" widget="radio"/>
                            <field name="custom_adjustment"
                                   attrs="{'invisible': [('adjustment_choice', '!=', 'custom')],
                                           'required': [('adjustment_choice', '=', 'custom')]}"/>
                        </group>
                    </group>
                    <group string="ผลลัพธ์"
                           attrs="{'invisible': [('adjustment_choice', '=', 'reset')]}">
                        <field name="delta" readonly="1" digits="[16,2]"/>
                        <field name="new_total" readonly="1" widget="monetary"/>
                    </group>
                    <div class="alert alert-info" role="alert"
                         attrs="{'invisible': [('adjustment_choice', '!=', 'reset')]}">
                        <strong>รีเซ็ตยอดเดิม</strong> — จะลบ target_amount_total
                        ที่เคยตั้งไว้ → ยอดจะกลับไปใช้สูตรปกติ (Method A หรือ
                        per-line tax sum) หลังกด "ปรับยอด"
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="ปรับยอด"
                            class="btn-primary"/>
                    <button string="ยกเลิก"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npd_adjust_decimal_wizard" model="ir.actions.act_window">
        <field name="name">แก้ไขยอดทศนิยม</field>
        <field name="res_model">npd.adjust.decimal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
