<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the account.move form view -->
        <record id="account_move_form_view_inherited_check_print" model="ir.ui.view">
            <field name="name">account.move</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='operating_unit_id']" position="after">

                                <field name="document_type" widget="selection" options="{'horizontal': True}"/>
                                <field name="reason_code_id" widget="selection" options="{'horizontal': True}"/>
				<field name="debt_payment_type"
                                       widget="selection"
                                       options="{'horizontal': True}"
                                       placeholder="เลือกประเภทการรับชำระหนี้"
                                       readonly="1"/>
                    <!-- Add update button -->
                    <!-- Add update button -->


                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_update_fields"
                            string="อัพเดท"
                            type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '=', 'posted')]}"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
