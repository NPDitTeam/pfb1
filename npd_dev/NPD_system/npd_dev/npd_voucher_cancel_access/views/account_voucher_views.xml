<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ซ่อนปุ่ม Cancel ใน Purchase Receipt (คืนเงินประกันค่าเช่า) -->
    <record id="view_purchase_receipt_cancel_access" model="ir.ui.view">
        <field name="name">account.voucher.purchase.cancel.access</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_purchase_receipt_form"/>
        <field name="arch" type="xml">
            <!-- ซ่อนปุ่ม Cancel (draft,proforma) -->
            <xpath expr="//header/button[@name='cancel_voucher'][@states='draft,proforma']" position="attributes">
                <attribute name="groups">npd_voucher_cancel_access.group_cancel_voucher</attribute>
            </xpath>
            
            <!-- ซ่อนปุ่ม Cancel (posted) -->
            <xpath expr="//header/button[@name='cancel_voucher'][@states='posted']" position="attributes">
                <attribute name="groups">npd_voucher_cancel_access.group_cancel_voucher</attribute>
            </xpath>
        </field>
    </record>

    <!-- ซ่อนปุ่ม Cancel ใน Sale Receipt -->
    <record id="view_sale_receipt_cancel_access" model="ir.ui.view">
        <field name="name">account.voucher.sale.cancel.access</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher_npd.view_sale_receipt_form"/>
        <field name="arch" type="xml">
            <!-- ซ่อนปุ่ม Cancel Receipt (draft,proforma) -->
            <xpath expr="//header/button[@name='cancel_voucher'][@states='draft,proforma']" position="attributes">
                <attribute name="groups">npd_voucher_cancel_access.group_cancel_voucher</attribute>
            </xpath>
            
            <!-- ซ่อนปุ่ม Cancel Receipt (posted) -->
            <xpath expr="//header/button[@name='cancel_voucher'][@states='posted']" position="attributes">
                <attribute name="groups">npd_voucher_cancel_access.group_cancel_voucher</attribute>
            </xpath>
        </field>
    </record>

</odoo>
