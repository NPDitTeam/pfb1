<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_customer_channel_tree" model="ir.ui.view">
            <field name="name">customer.channel.tree</field>
            <field name="model">customer.channel</field>
            <field name="arch" type="xml">
                <tree string="ช่องทางลูกค้า" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_customer_channel" model="ir.actions.act_window">
            <field name="name">ช่องทางลูกค้า</field>
            <field name="res_model">customer.channel</field>
            <field name="view_mode">tree</field>
        </record>

        <!-- Menu under Sales > Configuration -->
        <menuitem id="menu_customer_channel"
            name="ช่องทางลูกค้า"
            parent="sale.menu_sale_config"
            action="action_customer_channel"
            sequence="50"/>
    </data>
</odoo>
