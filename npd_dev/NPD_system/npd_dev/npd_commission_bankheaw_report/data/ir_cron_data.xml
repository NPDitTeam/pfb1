<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled Action: Auto fetch ALL commission data every 3 hours -->
        <record id="ir_cron_fetch_sales_commission" model="ir.cron">
            <field name="name">รายงานค่าคอมบ้านเขียว: ดึงข้อมูลทั้งหมดอัตโนมัติ</field>
            <field name="model_id" ref="model_npd_sales_commission_report"/>
            <field name="state">code</field>
            <field name="code">model.fetch_all_commission_data()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>

    </data>
</odoo>
