<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_score_dashboard_tree" model="ir.ui.view">
            <field name="name">score.dashboard.tree</field>
            <field name="model">score.dashboard</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="token"/>
                    <field name="service"/>
                    <field name="score"/>
                    <field name="phone_number"/>
                    <field name="price"/>
                    <field name="status"/>
                    <field name="branch"/>
                    <field name="customer_name"/>
<!--                    <field name="end_date" invisible="1"/>-->
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_score_dashboard_form" model="ir.ui.view">
            <field name="name">score.dashboard.form</field>
            <field name="model">score.dashboard</field>
            <field name="arch" type="xml">
                <form string="Score Dashboard">
                    <header>
                        <button name="action_fetch_score_data" type="object" string="Fetch from API" class="btn-primary"/>
                        <field name="status" widget="statusbar" statusbar_visible="used,unused"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="token" readonly="1"/>
                                <field name="service"/>
                                <field name="score"/>
                                <field name="phone_number"/>
                            </group>
                            <group>
                                <field name="price"/>
                                <field name="status"/>
                                <field name="branch"/>
                            </group>
                        </group>
                        <group>
                            <field name="customer_name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_score_dashboard" model="ir.actions.act_window">
            <field name="name">Score Dashboard</field>
            <field name="res_model">score.dashboard</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_score_dashboard_root" name="Score Dashboard" parent="menu_membership_root" action="action_score_dashboard" sequence="4"/>
    </data>
</odoo>
