<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_approval_wizard" model="ir.ui.view">
        <field name="name">account.move.approval.wizard.form</field>
        <field name="model">account.move.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="พิจารณาอนุมัติ">
                <separator string="ข้อมูลการขออนุมัติ"/>
                <group col="4">
                    <group colspan="2">
                        <field name="move_id" invisible="1"/>
                        <field name="requester_id" string="ผู้ขออนุมัติ"/>
                    </group>
                    <group colspan="2">
                    </group>
                    <group colspan="4">
                        <field name="request_note" string="หมายเหตุการขออนุมัติ" readonly="1" nolabel="0"/>
                    </group>
                </group>

                <separator string="การพิจารณา"/>
                <group>
                    <field name="action" widget="radio"/>
                    <field name="approver_id" options="{'no_create': True}"/>
                    <field name="approval_note" placeholder="ระบุเหตุผลในการพิจารณา..."/>
                </group>

                <footer>
                    <button string="ยืนยัน" type="object" name="action_process" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_approval_wizard" model="ir.actions.act_window">
        <field name="name">พิจารณาอนุมัติ</field>
        <field name="res_model">account.move.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>