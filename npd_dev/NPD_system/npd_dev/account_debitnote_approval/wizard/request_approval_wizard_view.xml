<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_request_approval_wizard" model="ir.ui.view">
        <field name="name">account.move.request.approval.wizard.form</field>
        <field name="model">account.move.request.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งอนุมัติ">
                <group>
                    <field name="approver_id" options="{'no_create': True}"/>
                    <field name="request_note" placeholder="ระบุเหตุผลในการขออนุมัติ..."/>
                </group>
                <footer>
                    <button string="ส่งอนุมัติ" type="object" name="action_send_approval" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_request_approval_wizard" model="ir.actions.act_window">
        <field name="name">ส่งอนุมัติ</field>
        <field name="res_model">account.move.request.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>