<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_all_receivable_wizard" model="ir.ui.view">
            <field name="name">all.receivable.wizard.form</field>
            <field name="model">all.receivable.wizard</field>
            <field name="arch" type="xml">
                <form string="🔍 รายงานลูกหนี้ทั้งหมด">
                    <sheet>
                        <div class="oe_title">
                            <h2>กำหนดเงื่อนไขในการดึงข้อมูล</h2>
                        </div>
                        <group>
                            <group string="📅 ช่วงเวลา">
                                <field name="date_from" placeholder="เว้นว่างเพื่อดูทั้งหมด"/>
                                <field name="date_to" placeholder="เว้นว่างเพื่อดูทั้งหมด"/>
                            </group>
                            <group string="🏢 ตัวกรอง">
                                <field name="branch_ids"
                                       widget="many2many_tags"
                                       placeholder="เลือกสาขา (เว้นว่างเพื่อดูทุกสาขา)"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> <strong>หมายเหตุ:</strong>
                                <ul>
                                    <li>ดึงข้อมูลจากใบแจ้งหนี้ (account.move) ที่ค้างชำระ</li>
                                    <li>แสดงเฉพาะใบแจ้งหนี้ที่มีสถานะ Posted และค้างชำระ</li>
                                    <li>เว้นว่างช่องวันที่เพื่อดูข้อมูลทั้งหมด</li>
                                    <li>เว้นว่างสาขาเพื่อดูข้อมูลทุกสาขา</li>
                                </ul>
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate_report"
                                type="object"
                                string="🔍 ค้นหารายงาน"
                                class="btn-primary"/>
                        <button string="ยกเลิก"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_all_receivable_wizard" model="ir.actions.act_window">
            <field name="name">ลูกหนี้ทั้งหมด</field>
            <field name="res_model">all.receivable.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_all_receivable_wizard"/>
        </record>

        <!-- เมนูสำหรับเรียก Wizard - ต่อจากเมนู รายงานใบแจ้งหนี้ค้างชำระ(สาขา) -->
        <menuitem id="menu_all_receivable_wizard"
                  name="ลูกหนี้ทั้งหมด"
                  parent="stock_report_dashboard.menu_stock_dashboard_root"
                  action="action_all_receivable_wizard"
                  sequence="15"/>
    </data>
</odoo>
