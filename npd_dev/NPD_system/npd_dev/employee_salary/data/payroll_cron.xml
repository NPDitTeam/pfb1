<?xml version="1.0" encoding="utf-8"?>
<!--
    หมายเหตุสำหรับผู้ดูแลระบบ:
    หากต้องการเปลี่ยน "เวลา" ที่ cron นี้รันทุกวัน (เช่น อยากให้รันตี 2)
    >>> ห้ามแก้ที่ไฟล์นี้ <<< เพราะ noupdate="1" + ใช้ได้แค่ตอน install ใหม่เท่านั้น

    ให้ไปแก้ที่ Odoo UI:
        Settings → Technical → Automation → Scheduled Actions
        ค้นหา: "ทำเงินเดือน Auto (รายวัน)"
        แก้ field "Next Execution Date" เป็นวัน+เวลาที่ต้องการ (เช่น 2026-05-12 02:00:00)
        Save → Odoo จะรันเวลานี้ทุกวันต่อจากนั้น
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_payroll" model="ir.cron">
            <field name="name">ทำเงินเดือน Auto (รายวัน)</field>
            <field name="model_id" ref="model_payroll_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_payroll()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
