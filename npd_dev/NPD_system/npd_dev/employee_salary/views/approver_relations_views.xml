<odoo>
    <data>
        <record id="action_approver_relations" model="ir.actions.act_window">
            <field name="name">กำหนดผู้อนุมัติ</field>
            <field name="res_model">approver.relations</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_approver_relations_sub"
                  name="กำหนดผู้อนุมัติ"
                  parent="main_employee_salary_menu"
                  action="action_approver_relations"
                  sequence="20"/>

        <record id="view_approver_relations_form" model="ir.ui.view">
            <field name="name">approver.relations.form</field>
            <field name="model">approver.relations</field>
            <field name="arch" type="xml">
                <form string="Approver Relation">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="user_id" string="ชื่อ-นามสกุล"/>
                                <field name="department_id" string="แผนก" readonly="1"/>
                                <field name="employee_code" string="รหัสพนักงาน" readonly="1"/>
                            </group>
                            <group>
                                <field name="position_id"/>
                                <field name="approver_user_id"/>
                                <field name="approver_employee_code" string="รหัสพนักงานผู้อนุมัติ" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_approver_relations_tree" model="ir.ui.view">
            <field name="name">approver.relations.tree</field>
            <field name="model">approver.relations</field>
            <field name="arch" type="xml">
                <tree string="Approver Relations">
                    <field name="user_id"/>
                    <field name="employee_code"/>
                    <field name="department_id"/>
                    <field name="position_id"/>
                    <field name="approver_user_id"/>
                </tree>
            </field>
        </record>

        <record id="view_approver_relations_search" model="ir.ui.view">
            <field name="name">approver.relations.search</field>
            <field name="model">approver.relations</field>
            <field name="arch" type="xml">
                <search string="Search Approver Relations">
                    <field name="user_id"/>
                    <field name="employee_code"/>
                    <field name="position_id"/>
                    <field name="department_id"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
