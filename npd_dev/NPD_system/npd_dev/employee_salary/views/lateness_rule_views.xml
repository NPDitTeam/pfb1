<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payroll_lateness_rule_tree" model="ir.ui.view">
        <field name="name">payroll.lateness.rule.tree</field>
        <field name="model">payroll.lateness.rule</field>
        <field name="arch" type="xml">
            <tree string="กำหนดสูตรคิดสาย" editable="bottom">
                <field name="effective_date" string="เริ่มใช้ตั้งแต่วันที่"/>
                <field name="branch_ids" string="ใช้กับสาขา" widget="many2many_tags"
                       options="{'no_create': True}"
                       placeholder="เว้นว่าง = ทุกสาขา"/>
                <field name="mode" string="รูปแบบ"/>
                <field name="grace_minutes" string="ผ่อนผัน (นาที)"
                       attrs="{'invisible': [('mode', '!=', 'grace')]}"/>
                <field name="deadline_hour" string="เข้างานไม่เกิน" widget="float_time"
                       attrs="{'invisible': [('mode', '!=', 'deadline')]}"/>
                <field name="note" string="หมายเหตุ"/>
                <button name="action_delete_rule" type="object"
                        icon="fa-trash" title="ลบสูตรนี้"
                        confirm="ลบสูตรนี้ใช่ไหม? วันที่ที่เคยอยู่ในช่วงของสูตรนี้ จะกลับไปใช้สูตรก่อนหน้า (ถ้าไม่มีสูตรก่อนหน้า = กลับไปใช้สูตรเดิม 15 นาที)"/>
            </tree>
        </field>
    </record>

    <record id="view_payroll_lateness_rule_form" model="ir.ui.view">
        <field name="name">payroll.lateness.rule.form</field>
        <field name="model">payroll.lateness.rule</field>
        <field name="arch" type="xml">
            <form string="กำหนดสูตรคิดสาย">
                <header>
                    <button name="action_delete_rule" type="object"
                            string="ลบสูตรนี้" class="btn-secondary"
                            attrs="{'invisible': [('id', '=', False)]}"
                            confirm="ลบสูตรนี้ใช่ไหม? วันที่ที่เคยอยู่ในช่วงของสูตรนี้ จะกลับไปใช้สูตรก่อนหน้า"/>
                </header>
                <group>
                    <field name="id" invisible="1"/>
                    <field name="effective_date"/>
                    <field name="branch_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="เว้นว่าง = ใช้กับทุกสาขา"/>
                    <field name="mode" widget="radio"/>
                    <field name="grace_minutes"
                           attrs="{'invisible': [('mode', '!=', 'grace')],
                                   'required': [('mode', '=', 'grace')]}"/>
                    <field name="deadline_hour" widget="float_time"
                           attrs="{'invisible': [('mode', '!=', 'deadline')],
                                   'required': [('mode', '=', 'deadline')]}"/>
                    <field name="note"/>
                </group>
                <div class="text-muted">
                    เกินที่ผ่อนผันแล้วจะนับสายตั้งแต่นาทีแรก (รวมนาทีที่ผ่อนผันด้วย) เหมือนสูตรเดิม
                    <br/>
                    "ใช้กับสาขา" เว้นว่าง = ทุกสาขา — ถ้าวันเริ่มใช้เดียวกันมีทั้งสูตรทุกสาขา
                    และสูตรที่ระบุสาขา สาขาที่ระบุจะชนะเฉพาะสาขาของตัวเอง
                </div>
            </form>
        </field>
    </record>

    <record id="action_payroll_lateness_rule" model="ir.actions.act_window">
        <field name="name">กำหนดสูตรคิดสาย</field>
        <field name="res_model">payroll.lateness.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่ได้ตั้งสูตร — ระบบใช้สูตรเดิม ผ่อนผัน 15 นาที
            </p>
            <p>
                กด "สร้าง" เพื่อตั้งสูตรใหม่ แล้วระบุวันเริ่มใช้
                วันก่อนหน้านั้นจะยังคิดด้วยสูตรเดิม ไม่กระทบยอดที่คำนวณไปแล้ว
            </p>
        </field>
    </record>

</odoo>
