<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Tree View -->
        <!-- ============================================================ -->
        <record id="view_medical_expense_tree" model="ir.ui.view">
            <field name="name">medical.expense.tree</field>
            <field name="model">medical.expense</field>
            <field name="arch" type="xml">
                <tree string="ค่ารักษาพยาบาล"
                      decoration-warning="state == 'รออนุมัติ'"
                      decoration-success="state == 'อนุมัติ'"
                      decoration-danger="state == 'ไม่อนุมัติ'"
                      decoration-muted="state == 'ยกเลิก'">
                    <field name="employee_id"/>
                    <field name="employee_code"/>
                    <field name="username"/>
                    <field name="branch_id"/>
                    <field name="company"/>
                    <field name="department"/>
                    <field name="position"/>
                    <field name="work_date"/>
                    <field name="amount" sum="รวมจำนวนเงิน"/>
                    <field name="annual_limit"/>
                    <field name="remaining_amount"/>
                    <field name="bank_name"/>
                    <field name="bank_account_number"/>
                    <field name="attachment_count" string="ไฟล์แนบ"/>
                    <field name="voucher_number"/>
                    <field name="user_note"/>
                    <field name="state"/>
                    <field name="created_at"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Form View -->
        <!-- ============================================================ -->
        <record id="view_medical_expense_form" model="ir.ui.view">
            <field name="name">medical.expense.form</field>
            <field name="model">medical.expense</field>
            <field name="arch" type="xml">
                <form string="ค่ารักษาพยาบาล">
                    <header>
                        <button name="action_approve"
                                string="อนุมัติส่งเข้าการรับ"
                                type="object"
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'รออนุมัติ')]}"
                                confirm="อนุมัติคำขอนี้ และสร้างใบการรับในระบบบัญชีของบริษัทพนักงาน?"/>
                        <button name="action_revert_approval"
                                string="ถอยกลับการอนุมัติ"
                                type="object"
                                class="btn-secondary"
                                attrs="{'invisible': [('state', '!=', 'อนุมัติ')]}"
                                confirm="ถอยกลับเป็นรออนุมัติ และยกเลิกใบการรับที่สร้างไว้?"/>
                        <button name="action_reject"
                                string="ไม่อนุมัติ"
                                type="object"
                                class="btn-danger"
                                attrs="{'invisible': [('state', '!=', 'รออนุมัติ')]}"
                                confirm="ยืนยันการไม่อนุมัติค่ารักษาพยาบาลนี้?"/>
                        <button name="action_cancel"
                                string="ยกเลิก"
                                type="object"
                                class="btn-warning"
                                attrs="{'invisible': [('state', 'in', ['ยกเลิก'])]}"
                                confirm="ยืนยันการยกเลิกค่ารักษาพยาบาลนี้?"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="รออนุมัติ,อนุมัติ,ไม่อนุมัติ"/>
                    </header>
                    <sheet>
                        <div class="oe_title"
                             attrs="{'invisible': [('username', 'in', [False, ''])]}">
                            <h1>
                                <field name="username" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="ข้อมูลพนักงาน">
                                <field name="employee_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       attrs="{'readonly': ['|', ('state', '!=', 'รออนุมัติ'), ('php_id', '!=', 0)]}"/>
                                <field name="employee_code"/>
                                <field name="branch_id" readonly="1"/>
                                <field name="company" readonly="1"/>
                                <field name="department" readonly="1"/>
                                <field name="position" readonly="1"/>
                            </group>
                            <group string="รายละเอียดคำขอ">
                                <field name="work_date"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"/>
                                <field name="amount"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"/>
                                <field name="created_at"/>
                            </group>
                        </group>
                        <group string="บัญชีที่โอนเข้า">
                            <group>
                                <field name="bank_name"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"/>
                                <field name="bank_account_number"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"/>
                            </group>
                            <group>
                                <field name="bank_account_name"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"/>
                            </group>
                        </group>
                        <group string="วงเงินค่ารักษาพยาบาลประจำปี">
                            <group>
                                <field name="expense_year"/>
                                <field name="annual_limit"/>
                                <field name="annual_opening_amount"/>
                                <field name="annual_approved_amount"/>
                            </group>
                            <group>
                                <field name="annual_pending_amount"/>
                                <field name="remaining_amount"/>
                                <button name="action_open_annual_limit"
                                        string="ตั้งวงเงินต่อปี"
                                        type="object"
                                        class="btn-link"
                                        icon="fa-cog"/>
                            </group>
                        </group>
                        <group>
                            <group string="หมายเหตุ">
                                <!-- ใบที่มาจากแอป (php_id ไม่ใช่ 0) แก้ไม่ได้ ต้องตรงกับที่พนักงานเห็น
                                     ส่วนใบที่ HR เพิ่มเองในระบบ พิมพ์ได้ ถ้ากรอกบัญชีธนาคารครบ
                                     ระบบจะสร้างข้อความมาตรฐานทับให้เอง -->
                                <field name="user_note"
                                       nolabel="1"
                                       attrs="{'readonly': ['|', ('php_id', '!=', 0), ('state', '!=', 'รออนุมัติ')]}"
                                       placeholder="กรอกหมายเหตุ หรือปล่อยว่างไว้ ระบบจะสร้างจากจำนวนเงิน + บัญชีธนาคารให้"/>
                            </group>
                            <group string="ไฟล์แนบเพิ่มเติม (ฝั่ง Odoo)">
                                <field name="attachment_ids"
                                       widget="many2many_binary"
                                       nolabel="1"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"/>
                            </group>
                        </group>
                        <!-- ตารางรายการไฟล์แนบซ่อนไว้ — ตัวไฟล์จริงดูได้ที่กล่องเอกสารแนบ
                             ยังต้องคงฟิลด์ไว้ในฟอร์ม เพราะระบบใช้อ้างอิงตอนโหลดไฟล์จากแอป -->
                        <field name="attachment_line_ids" invisible="1"/>
                        <group string="ใบการรับในระบบบัญชี"
                               attrs="{'invisible': [('voucher_number', 'in', [False, ''])]}">
                            <group>
                                <field name="voucher_number"/>
                                <field name="voucher_db"/>
                            </group>
                            <group>
                                <field name="voucher_partner"/>
                                <field name="voucher_created_at"/>
                                <button name="action_open_voucher"
                                        string="เปิดใบการรับ"
                                        type="object"
                                        class="btn-link"
                                        icon="fa-external-link"/>
                            </group>
                        </group>
                        <group string="การอนุมัติ">
                            <group>
                                <field name="reason"
                                       attrs="{'readonly': [('state', '!=', 'รออนุมัติ')]}"
                                       placeholder="กรอกเหตุผล (จำเป็นสำหรับกรณีไม่อนุมัติ)"/>
                            </group>
                            <group>
                                <field name="approved_at"/>
                            </group>
                        </group>
                        <group>
                            <field name="php_id" invisible="1"/>
                            <field name="file_path" invisible="1"/>
                            <field name="voucher_ref_id" invisible="1"/>
                        </group>
                    </sheet>
                    <!-- กล่องเอกสารแนบ + บันทึกโน้ต — ใบเสร็จจากแอปจะมาโชว์เป็นรูปตัวอย่างที่นี่ -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Search View -->
        <!-- ============================================================ -->
        <record id="view_medical_expense_search" model="ir.ui.view">
            <field name="name">medical.expense.search</field>
            <field name="model">medical.expense</field>
            <field name="arch" type="xml">
                <search string="ค้นหาค่ารักษาพยาบาล">
                    <field name="employee_id"/>
                    <field name="username"/>
                    <field name="employee_code"/>
                    <field name="branch_id"/>
                    <field name="company"/>
                    <field name="department"/>
                    <field name="bank_account_number"/>
                    <field name="voucher_number"/>
                    <separator/>
                    <filter string="ส่งเข้าการรับแล้ว" name="has_voucher"
                            domain="[('voucher_number', '!=', False)]"/>
                    <filter string="รออนุมัติ" name="pending" domain="[('state', '=', 'รออนุมัติ')]"/>
                    <filter string="อนุมัติแล้ว" name="approved" domain="[('state', '=', 'อนุมัติ')]"/>
                    <filter string="ไม่อนุมัติ" name="rejected" domain="[('state', '=', 'ไม่อนุมัติ')]"/>
                    <filter string="ยกเลิก" name="cancelled" domain="[('state', '=', 'ยกเลิก')]"/>
                    <separator/>
                    <group expand="0" string="จัดกลุ่มตาม">
                        <filter string="พนักงาน" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="สถานะ" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="สาขา" name="group_branch" context="{'group_by': 'branch_id'}"/>
                        <filter string="บริษัท (สังกัด)" name="group_company" context="{'group_by': 'company'}"/>
                        <filter string="แผนก" name="group_department" context="{'group_by': 'department'}"/>
                        <filter string="วันที่ทำงาน" name="group_work_date" context="{'group_by': 'work_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action -->
        <!-- ============================================================ -->
        <record id="action_medical_expense" model="ir.actions.act_window">
            <field name="name">ค่ารักษาพยาบาล</field>
            <field name="res_model">medical.expense</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_medical_expense_search"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ยังไม่มีรายการค่ารักษาพยาบาล
                </p>
                <p>
                    รายการค่ารักษาพยาบาลถูกดึงจากแอปอัตโนมัติ — กด "ซิงค์ข้อมูลจาก PHP" เพื่อดึงรายการล่าสุด
                </p>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Server Action: ดึงรายการจาก PHP API -->
        <!-- ============================================================ -->
        <record id="action_sync_medical_expense_from_api" model="ir.actions.server">
            <field name="name">ซิงค์ข้อมูลค่ารักษาพยาบาลจาก PHP</field>
            <field name="model_id" ref="model_medical_expense"/>
            <field name="binding_model_id" ref="model_medical_expense"/>
            <field name="state">code</field>
            <field name="code">action = model.sync_and_open_view()</field>
        </record>

        <!-- ============================================================ -->
        <!-- Wizard: ไม่อนุมัติ (popup ถามเหตุผล) -->
        <!-- ============================================================ -->
        <record id="view_medical_expense_reject_wizard_form" model="ir.ui.view">
            <field name="name">medical.expense.reject.wizard.form</field>
            <field name="model">medical.expense.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="ไม่อนุมัติค่ารักษาพยาบาล">
                    <group>
                        <field name="expense_id" invisible="1"/>
                        <field name="reason" placeholder="กรอกเหตุผลในการไม่อนุมัติ..."/>
                    </group>
                    <footer>
                        <button name="action_confirm_reject"
                                string="ยืนยันไม่อนุมัติ"
                                type="object"
                                class="btn-danger"/>
                        <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
