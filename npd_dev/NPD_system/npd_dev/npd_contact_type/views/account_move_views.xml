<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add contact_type and sales_contact_id field to Invoice Form View -->
    <record id="view_move_form_inherit_contact_type" model="ir.ui.view">
        <field name="name">account.move.form.inherit.contact.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- เพิ่ม field contact_type และ sales_contact_id ใน Invoice Form -->
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="contact_type" string="การติดต่อของลูกค้า"/>
                <field name="sales_contact_id" string="Sales ที่ติดต่อ"/>
            </xpath>
        </field>
    </record>

    <!-- Add fields to Invoice Tree View -->
    <record id="view_move_tree_inherit_contact_type" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.contact.type</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="contact_type" string="การติดต่อของลูกค้า" optional="show"/>
                <field name="sales_contact_id" string="Sales ที่ติดต่อ" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
