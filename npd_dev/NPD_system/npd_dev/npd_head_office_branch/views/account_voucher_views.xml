<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เมนู การรับ (Purchase Receipts) -->
    <record id="view_purchase_receipt_form_head_office_branch" model="ir.ui.view">
        <field name="name">account.voucher.purchase.form.head.office.branch</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="account_voucher.view_purchase_receipt_form"/>
        <field name="arch" type="xml">
            <!-- branch_id มาจากโมดูล account_invoice_sale_purchase_receipt_branch -->
            <xpath expr="//field[@name='branch_id']" position="after">
                <field name="head_office_branch_id"
                       force_save="1"
                       options="{'no_open': True}"
                       attrs="{'invisible': [('check_type_show_selection', '=', 'true')]}"/>
            </xpath>
        </field>
    </record>

</odoo>
