<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เมนู Avance Clear -->
    <record id="view_advance_clear_form_head_office_branch" model="ir.ui.view">
        <field name="name">account.advance.clear.form.head.office.branch</field>
        <field name="model">account.advance.clear</field>
        <field name="inherit_id" ref="account_advance.account_advance_clear_form_view"/>
        <field name="arch" type="xml">
            <!-- branch_id มาจากโมดูล account_invoice_advance_system_branch -->
            <xpath expr="//field[@name='branch_id']" position="after">
                <field name="head_office_branch_id"
                       force_save="1"
                       options="{'no_open': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
