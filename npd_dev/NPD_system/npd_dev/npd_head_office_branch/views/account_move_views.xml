<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เมนู บิล ผู้ขาย -->
    <record id="view_move_form_head_office_branch" model="ir.ui.view">
        <field name="name">account.move.form.head.office.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- branch_div มาจากโมดูล branch (view_move_form_inherit_branch) -->
            <xpath expr="//div[@name='branch_div']" position="after">
                <label for="head_office_branch_id"
                       attrs="{'invisible': [('move_type', 'not in', ['in_invoice', 'in_refund'])]}"/>
                <div name="head_office_branch_div" class="d-flex"
                     attrs="{'invisible': [('move_type', 'not in', ['in_invoice', 'in_refund'])]}">
                    <field name="head_office_branch_id"
                           force_save="1"
                           options="{'no_open': True}"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
