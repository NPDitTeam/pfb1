<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Call Lead Tree View -->
    <record id="npd_call_lead_view_tree" model="ir.ui.view">
        <field name="name">npd.call.lead.tree</field>
        <field name="model">npd.call.lead</field>
        <field name="arch" type="xml">
            <tree string="โทรติดตาม Lead" decoration-danger="state=='draft'"
                  decoration-warning="state=='in_progress'"
                  decoration-success="state=='done'">
                <field name="tracking_date"/>
                <field name="lead_id"/>
                <field name="partner_name"/>
                <field name="partner_phone" widget="phone"/>
                <field name="partner_mobile" widget="phone"/>
                <field name="partner_email"/>
                <field name="lead_expected_revenue" sum="รวม"/>
                <field name="call_count"/>
                <field name="email_count"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Call Lead Form View -->
    <record id="npd_call_lead_view_form" model="ir.ui.view">
        <field name="name">npd.call.lead.form</field>
        <field name="model">npd.call.lead</field>
        <field name="arch" type="xml">
            <form string="โทรติดตาม Lead">
                <header>
                    <button name="action_call_mobile" type="object"
                            string="📞 โทรหาลูกค้า" class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button name="action_send_email" type="object"
                            string="📧 ส่งเมล" class="btn-info"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button name="action_done" type="object"
                            string="✓ จบงานวันนี้" class="btn-success"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_cancel" type="object"
                            string="ยกเลิก"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_reset_draft" type="object"
                            string="กลับไปรอดำเนินการ"
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lead" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lead_expected_revenue" widget="statinfo" string="รายได้ที่คาดหวัง"/>
                        </button>
                        <button name="action_view_call_logs" type="object"
                                class="oe_stat_button" icon="fa-phone">
                            <field name="call_count" widget="statinfo" string="ประวัติโทร"/>
                        </button>
                        <button name="action_view_email_logs" type="object"
                                class="oe_stat_button" icon="fa-envelope">
                            <field name="email_count" widget="statinfo" string="ประวัติเมล"/>
                        </button>
                    </div>
                    <group>
                        <group string="ข้อมูล Lead">
                            <field name="tracking_date"/>
                            <field name="lead_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="lead_stage_id" readonly="1"/>
                            <field name="lead_expected_revenue"/>
                            <field name="lead_probability"/>
                            <field name="lead_user_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="partner_id"/>
                            <field name="partner_name"/>
                            <field name="partner_email" widget="email"/>
                            <field name="partner_phone" widget="phone"/>
                            <field name="partner_mobile" widget="phone"/>
                        </group>
                    </group>
                    <group string="ที่อยู่ลูกค้า">
                        <group>
                            <field name="partner_street"/>
                            <field name="partner_street2"/>
                        </group>
                        <group>
                            <field name="partner_city"/>
                            <field name="partner_state_id"/>
                            <field name="partner_zip"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ประวัติการโทร" name="call_logs">
                            <field name="call_log_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="call_date"/>
                                    <field name="phone_number"/>
                                    <field name="user_id"/>
                                    <field name="call_result"/>
                                    <field name="duration"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ประวัติการส่งเมล" name="email_logs">
                            <field name="email_log_ids" nolabel="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="send_date"/>
                                    <field name="email_from"/>
                                    <field name="email_to"/>
                                    <field name="subject"/>
                                    <field name="user_id"/>
                                    <field name="state" decoration-success="state=='sent'"
                                           decoration-danger="state=='failed'" decoration-warning="state=='draft'" widget="badge"/>
                                    <field name="attachment_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="รายละเอียด Lead" name="lead_info">
                            <field name="lead_description" nolabel="1" readonly="1"/>
                        </page>
                        <page string="หมายเหตุ" name="notes">
                            <field name="note" placeholder="บันทึกหมายเหตุ..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="npd_call_lead_view_search" model="ir.ui.view">
        <field name="name">npd.call.lead.search</field>
        <field name="model">npd.call.lead</field>
        <field name="arch" type="xml">
            <search string="ค้นหา">
                <field name="lead_id"/>
                <field name="partner_id"/>
                <field name="partner_name"/>
                <field name="partner_phone"/>
                <field name="partner_mobile"/>
                <filter name="filter_today" string="วันนี้"
                        domain="[('tracking_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_draft" string="รอดำเนินการ" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress" string="กำลังติดตาม" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="เสร็จสิ้น" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="ลูกค้า" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="วันที่" context="{'group_by': 'tracking_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_npd_call_lead" model="ir.actions.act_window">
        <field name="name">Call Lead</field>
        <field name="res_model">npd.call.lead</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างรายการโทรติดตาม Lead ใหม่</p>
        </field>
    </record>

    <!-- Action for Call Log -->
    <record id="action_npd_call_lead_log" model="ir.actions.act_window">
        <field name="name">ประวัติการโทร</field>
        <field name="res_model">npd.call.lead.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีประวัติการโทร</p>
        </field>
    </record>

    <!-- Action for Email Log -->
    <record id="action_npd_call_lead_email_log" model="ir.actions.act_window">
        <field name="name">ประวัติการส่งเมล</field>
        <field name="res_model">npd.call.lead.email.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีประวัติการส่งเมล</p>
        </field>
    </record>

    <!-- Menu - sequence 15 เพื่อให้อยู่ก่อน Reporting (sequence 20) -->
    <menuitem id="menu_npd_call_lead_root" name="Call Lead" parent="crm.crm_menu_root"
              sequence="15"/>

    <!-- Sub Menu - Call Lead -->
    <menuitem id="menu_npd_call_lead" name="โทรติดตาม Lead" parent="menu_npd_call_lead_root"
              action="action_npd_call_lead" sequence="1"/>

    <!-- Sub Menu - Call Log History -->
    <menuitem id="menu_npd_call_lead_log" name="ประวัติการโทร" parent="menu_npd_call_lead_root"
              action="action_npd_call_lead_log" sequence="2"/>

    <!-- Sub Menu - Email Log History -->
    <menuitem id="menu_npd_call_lead_email_log" name="ประวัติการส่งเมล" parent="menu_npd_call_lead_root"
              action="action_npd_call_lead_email_log" sequence="3"/>

    <!-- Call Log Tree View -->
    <record id="npd_call_lead_log_view_tree" model="ir.ui.view">
        <field name="name">npd.call.lead.log.tree</field>
        <field name="model">npd.call.lead.log</field>
        <field name="arch" type="xml">
            <tree string="ประวัติการโทร">
                <field name="call_date"/>
                <field name="lead_id"/>
                <field name="partner_name"/>
                <field name="phone_number" widget="phone"/>
                <field name="user_id"/>
                <field name="call_result"/>
                <field name="duration" string="ระยะเวลา (นาที)"/>
                <field name="lead_expected_revenue"/>
                <field name="note"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Call Log Search View -->
    <record id="npd_call_lead_log_view_search" model="ir.ui.view">
        <field name="name">npd.call.lead.log.search</field>
        <field name="model">npd.call.lead.log</field>
        <field name="arch" type="xml">
            <search string="ค้นหาประวัติการโทร">
                <field name="lead_id"/>
                <field name="partner_name"/>
                <field name="phone_number"/>
                <field name="user_id"/>
                <filter name="filter_today" string="วันนี้"
                        domain="[('call_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('call_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter name="filter_this_week" string="สัปดาห์นี้"
                        domain="[('call_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_answered" string="รับสาย" domain="[('call_result', '=', 'answered')]"/>
                <filter name="filter_no_answer" string="ไม่รับสาย" domain="[('call_result', '=', 'no_answer')]"/>
                <filter name="filter_interested" string="สนใจ" domain="[('call_result', '=', 'interested')]"/>
                <filter name="filter_not_interested" string="ไม่สนใจ" domain="[('call_result', '=', 'not_interested')]"/>
                <filter name="filter_callback" string="นัดโทรกลับ" domain="[('call_result', '=', 'callback')]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_result" string="ผลการโทร" context="{'group_by': 'call_result'}"/>
                    <filter name="group_user" string="ผู้โทร" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="ลูกค้า" context="{'group_by': 'partner_name'}"/>
                    <filter name="group_date" string="วันที่โทร" context="{'group_by': 'call_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Call Log Form View - ดูประวัติ -->
    <record id="npd_call_lead_log_view_form" model="ir.ui.view">
        <field name="name">npd.call.lead.log.form</field>
        <field name="model">npd.call.lead.log</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="ประวัติการโทร" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_name" readonly="1"/></h1>
                        <h3><field name="phone_number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="tracking_id" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="lead_expected_revenue" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="ข้อมูลการโทร">
                            <field name="call_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="duration" readonly="1" string="ระยะเวลา (นาที)"/>
                        </group>
                    </group>
                    <group string="ผลการโทร">
                        <field name="call_result" readonly="1"/>
                    </group>
                    <group string="หมายเหตุ">
                        <field name="note" readonly="1" nolabel="1"/>
                    </group>
                    <field name="is_calling" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Call Log Form View - โทรหาลูกค้า (Popup) -->
    <record id="npd_call_lead_log_calling_form" model="ir.ui.view">
        <field name="name">npd.call.lead.log.calling.form</field>
        <field name="model">npd.call.lead.log</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="โทรหาลูกค้า">
                <field name="is_calling" invisible="1"/>
                <field name="clean_phone" invisible="1"/>
                <sheet>
                    <div class="alert alert-info text-center" role="alert" attrs="{'invisible': [('is_calling', '=', True)]}">
                        <h2>📞 โทรหาลูกค้า</h2>
                        <h3 class="mb-2"><field name="partner_name" readonly="1" nolabel="1"/></h3>
                        <h2 class="mt-3 mb-3"><field name="phone_number" readonly="1" nolabel="1"/></h2>
                        <div class="mb-3">
                            <span class="badge badge-warning" style="font-size: 1.2em;">
                                รายได้ที่คาดหวัง: <field name="lead_expected_revenue" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        <field name="currency_id" invisible="1"/>
                    </div>
                    <div class="alert alert-warning text-center" role="alert" attrs="{'invisible': [('is_calling', '=', False)]}">
                        <h2><i class="fa fa-phone"></i> กำลังโทร...</h2>
                        <h3 class="mb-2"><field name="partner_name" readonly="1" nolabel="1" force_save="1"/></h3>
                        <h2 class="mt-3 mb-3"><field name="phone_number" readonly="1" nolabel="1" force_save="1"/></h2>
                        <div class="mb-3">
                            <span class="badge badge-warning" style="font-size: 1.2em;">
                                รายได้ที่คาดหวัง: <field name="lead_expected_revenue" readonly="1" nolabel="1" force_save="1"/>
                            </span>
                        </div>
                        <div class="mt-3 p-2 bg-light rounded">
                            <span class="text-dark">
                                <i class="fa fa-clock-o"></i> <strong>เวลาเริ่มโทร:</strong>
                                <field name="call_start_time" readonly="1" nolabel="1" force_save="1"/>
                            </span>
                        </div>
                    </div>
                    <group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="tracking_id" invisible="1"/>
                            <field name="lead_id" readonly="1"/>
                        </group>
                        <group string="ข้อมูลการโทร">
                            <field name="call_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_dial_now" type="object" string="📞 กดโทร" class="btn-success btn-lg"/>
                    <button name="action_end_call" type="object" string="📴 จบการโทร" class="btn-danger btn-lg"/>
                    <button name="action_cancel_call" type="object" string="ยกเลิก" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Call Log Result Form (หลังจบการโทร) -->
    <record id="npd_call_lead_log_result_form" model="ir.ui.view">
        <field name="name">npd.call.lead.log.result.form</field>
        <field name="model">npd.call.lead.log</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <form string="บันทึกผลการโทร">
                <sheet>
                    <div class="alert alert-warning text-center" role="alert">
                        <h3>⚠️ กรุณาบันทึกผลการโทร</h3>
                        <p class="mb-0">กรุณาเลือก "ผลการโทร" ก่อนบันทึก (บังคับ)</p>
                    </div>
                    <group>
                        <group string="ข้อมูลการโทร">
                            <field name="tracking_id" invisible="1"/>
                            <field name="partner_name" readonly="1"/>
                            <field name="phone_number" readonly="1"/>
                            <field name="call_date" readonly="1"/>
                            <field name="call_start_time" readonly="1"/>
                            <field name="call_end_time" readonly="1"/>
                            <field name="duration" readonly="1" string="ระยะเวลา (นาที)"/>
                        </group>
                        <group string="ข้อมูล Lead">
                            <field name="lead_id" readonly="1"/>
                            <field name="lead_expected_revenue" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="📝 ผลการโทร (บังคับ)">
                        <field name="call_result" required="1" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="📋 หมายเหตุ (ไม่บังคับ)">
                        <field name="note" placeholder="บันทึกรายละเอียดการโทร..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="💾 บันทึกผลการโทร" type="object" name="action_save_and_close" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Email Log Tree View -->
    <record id="npd_call_lead_email_log_view_tree" model="ir.ui.view">
        <field name="name">npd.call.lead.email.log.tree</field>
        <field name="model">npd.call.lead.email.log</field>
        <field name="arch" type="xml">
            <tree string="ประวัติการส่งเมล" decoration-success="state=='sent'"
                  decoration-danger="state=='failed'" decoration-warning="state=='draft'">
                <field name="send_date"/>
                <field name="lead_id"/>
                <field name="partner_name"/>
                <field name="email_from"/>
                <field name="email_to"/>
                <field name="subject"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="attachment_count"/>
                <field name="lead_expected_revenue"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Email Log Search View -->
    <record id="npd_call_lead_email_log_view_search" model="ir.ui.view">
        <field name="name">npd.call.lead.email.log.search</field>
        <field name="model">npd.call.lead.email.log</field>
        <field name="arch" type="xml">
            <search string="ค้นหาประวัติการส่งเมล">
                <field name="lead_id"/>
                <field name="partner_name"/>
                <field name="email_to"/>
                <field name="subject"/>
                <field name="user_id"/>
                <filter name="filter_today" string="วันนี้"
                        domain="[('send_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('send_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter name="filter_this_week" string="สัปดาห์นี้"
                        domain="[('send_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_sent" string="ส่งสำเร็จ" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_failed" string="ส่งไม่สำเร็จ" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_draft" string="รอส่ง" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="ผู้ส่ง" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="ลูกค้า" context="{'group_by': 'partner_name'}"/>
                    <filter name="group_date" string="วันที่ส่ง" context="{'group_by': 'send_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Email Log Form View -->
    <record id="npd_call_lead_email_log_view_form" model="ir.ui.view">
        <field name="name">npd.call.lead.email.log.form</field>
        <field name="model">npd.call.lead.email.log</field>
        <field name="arch" type="xml">
            <form string="ประวัติการส่งเมล" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="ข้อมูลอีเมล">
                            <field name="email_from" readonly="1"/>
                            <field name="email_to" readonly="1"/>
                            <field name="send_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="ข้อมูลติดตาม Lead">
                            <field name="tracking_id" readonly="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="partner_name" readonly="1"/>
                            <field name="lead_expected_revenue" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="เนื้อหา">
                        <field name="body" readonly="1" nolabel="1"/>
                    </group>
                    <group string="ไฟล์แนบ">
                        <field name="attachment_ids" readonly="1" nolabel="1"/>
                    </group>
                    <group string="ข้อผิดพลาด" attrs="{'invisible': [('state', '!=', 'failed')]}">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Send Email Wizard Form -->
    <record id="npd_call_lead_send_email_wizard_form" model="ir.ui.view">
        <field name="name">npd.call.lead.send.email.wizard.form</field>
        <field name="model">npd.call.lead.send.email.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งเมลติดตาม Lead">
                <sheet>
                    <div class="alert alert-info text-center" role="alert">
                        <h3>📧 ส่งเมลติดตาม Lead</h3>
                        <p>ส่งเมลติดตาม Lead ไปยังลูกค้า</p>
                    </div>
                    <group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="tracking_id" invisible="1"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="partner_name" readonly="1"/>
                            <field name="partner_email" readonly="1"/>
                        </group>
                        <group string="ข้อมูลอีเมล">
                            <field name="email_from" required="1"/>
                            <field name="email_to" required="1"/>
                        </group>
                    </group>
                    <group string="หัวข้อ">
                        <field name="subject" required="1" nolabel="1" placeholder="หัวข้อเมล..."/>
                    </group>
                    <group string="เนื้อหา">
                        <field name="body" required="1" nolabel="1" placeholder="พิมพ์ข้อความติดตาม Lead..."/>
                    </group>
                    <group string="ไฟล์แนบ">
                        <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button string="📧 ส่งเมล" type="object" name="action_send_email" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
