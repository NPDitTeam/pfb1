<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_request_order_form_inherit_location_src" model="ir.ui.view">
        <field name="name">stock.request.order.form.inherit.location.src</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_form"/>
        <field name="arch" type="xml">
            <!-- เพิ่มฟิลด์ใน tree ของ stock_request_ids -->
            <xpath expr="//field[@name='stock_request_ids']/tree/field[@name='route_id']" position="after">
                <field name="location_src_id" context="{'trigger_on_route_change': True}"/>



            </xpath>
        </field>
    </record>
</odoo>
