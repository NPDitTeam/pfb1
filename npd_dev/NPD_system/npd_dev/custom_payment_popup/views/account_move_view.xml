<odoo>
  <record id="view_move_form_inherit_payment_popup" model="ir.ui.view">
    <field name="name">account.move.form.inherit.payment.popup</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <header position="inside">
            
            <button name="action_open_payment_popup"
        string="ชำระเงิน"
        type="object"
        class="btn-primary"
        attrs="{'invisible': ['|',('state', '!=', 'posted'), ('payment_state', '=', 'paid')]}"/>


        </header>
    </field>
</record>

</odoo>
