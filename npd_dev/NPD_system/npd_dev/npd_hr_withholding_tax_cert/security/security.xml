<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rule for HR WT Cert -->
        <record id="hr_withholding_tax_cert_rule" model="ir.rule">
            <field name="name">HR Withholding Tax Cert multi-company</field>
            <field name="model_id" ref="model_hr_withholding_tax_cert"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|',('company_id','=',False),('company_id','in',company_ids)]
            </field>
        </record>
        <record id="hr_withholding_tax_cert_line_rule" model="ir.rule">
            <field name="name">HR Withholding Tax Cert Line multi-company</field>
            <field name="model_id" ref="model_hr_withholding_tax_cert_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|',('cert_id.company_id','=',False),('cert_id.company_id','in',company_ids)]
            </field>
        </record>
    </data>
</odoo>
