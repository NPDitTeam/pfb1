<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_npd_line_partner" model="ir.ui.view">
        <field name="name">account.move.form.npd.line.partner</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="npd_require_line_partner" invisible="1"/>
            </xpath>
            <xpath expr="//page/field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="npd_line_partner_id"
                       domain="[('parent_id', '=', False)]"
                       options="{'no_create_edit': True}"
                       attrs="{'column_invisible': [('parent.move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))],
                               'required': [('parent.npd_require_line_partner', '=', True), ('display_type', '=', False)]}"/>
            </xpath>
            <xpath expr="//notebook//field[@name='line_ids']/tree/field[@name='date_maturity']" position="after">
                <field name="npd_line_partner_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- แท็บ Tax Invoice: แสดงช่อง Partner เสมอ และบังคับเมื่อผู้ขายต้องระบุ Partner รายบรรทัด -->
    <record id="view_move_form_npd_tax_invoice_partner" model="ir.ui.view">
        <field name="name">account.move.form.npd.tax.invoice.partner</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_th_tax_invoice.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_invoice_ids']/tree/field[@name='partner_id']" position="attributes">
                <attribute name="optional"/>
                <attribute name="domain">[('parent_id', '=', False)]</attribute>
                <attribute name="options">{'no_create_edit': True}</attribute>
                <attribute name="attrs">{'required': [('parent.npd_require_line_partner', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_npd_line_partner" model="ir.ui.view">
        <field name="name">res.partner.form.npd.line.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field name="npd_require_line_partner"/>
            </xpath>
        </field>
    </record>

</odoo>
