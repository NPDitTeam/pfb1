<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ========================================================================
         ใบกำกับการเช่าหนี้ค้างชำระ

         คัดลอกโครงสร้างจาก pfb_npd_sale_form_rent_invoice "ฉบับที่ติดตั้งจริง"
         (อ่านจาก ir_ui_view ไม่ใช่ไฟล์บนดิสก์ เพราะไฟล์บนดิสก์ใหม่กว่าที่ติดตั้ง
          และใช้ค่าคนละชุด) จุดที่ต้องเหมือนเดิมไม่งั้นเลย์เอาต์ทับกัน:
           - เรียก report_signature "นอก" div.header
             (ถ้าอยู่ใน header odoo จะแยกไปเป็น page header ของ wkhtmltopdf
              ทำให้ตารางในเนื้อหาไหลไปทับบล็อกลายเซ็น)
         ขอบล่าง 15 มม. (ใบเดิมตั้ง 110 มม. ซึ่งเป็นที่ว่างเปล่า เพราะรายงานนี้
         ไม่มี footer ที่มองเห็นได้ เหลือไว้เท่านั้นทำให้เสียพื้นที่ ~1 ใน 3 ของทุกหน้า)

         การแบ่งหน้า: ไม่บังคับตัดหน้าเอง ปล่อยให้ wkhtmltopdf จัดตามเนื้อหาจริง
         (วัดแล้ว 1 หน้าใส่ได้ ~26 บรรทัด และขึ้นหัวตารางใหม่ให้ทุกหน้าเพราะ
          หัวตารางอยู่ใน thead) ส่วนตารางสรุป/บล็อกท้ายใบใส่ page-break-inside: avoid
         กันถูกตัดครึ่งคาหน้า ถ้าที่ว่างไม่พอจะยกไปหน้าถัดไปทั้งบล็อก
         ======================================================================== -->
    <record id="paperformat_npd_rent_invoice_overdue" model="report.paperformat">
        <field name="name">A4 Sample (ใบกำกับการเช่าหนี้ค้างชำระ)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">60</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">60</field>
    </record>

    <!-- ชื่อเมนูตอน print = ใบกำกับการเช่าหนี้ค้างชำระ -->
    <report
            id="action_rent_invoice_overdue"
            string="ใบกำกับการเช่าหนี้ค้างชำระ"
            name="npd_rent_invoice_overdue.report_npd_rent_invoice_overdue"
            model="sale.order"
            report_type="qweb-pdf"
            print_report_name="'Sale - %s' %(object.name)"
            paperformat="npd_rent_invoice_overdue.paperformat_npd_rent_invoice_overdue"
    />

