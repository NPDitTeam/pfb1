    <template id="report_overdue_summary">
        <table width="100%" style="margin-top: 10px; page-break-inside: avoid;">
            <thead>
                <tr>
                    <th colspan="6" style="text-align: left; font-size: 13px; padding: 2px 0;">
                        <strong>สรุปยอดค้างชำระ</strong>
                    </th>
                </tr>
                <tr style="border-bottom: 1px solid black !important;">
                    <th width="17%" style="text-align: left; font-size: 13px;">เลขที่ใบสั่งเช่า</th>
                    <th width="20%" style="text-align: left; font-size: 13px;">เลขที่ใบแจ้งหนี้</th>
                    <th width="12%" style="text-align: center; font-size: 13px;">วันที่ใบแจ้งหนี้</th>
                    <th width="17%" style="text-align: left; font-size: 13px;">ประเภทค้างชำระ</th>
                    <th width="19%" style="text-align: left; font-size: 13px;">ประเภทการชำระ</th>
                    <th width="15%" style="text-align: right; font-size: 13px;">ยอดค้างชำระ</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="ov_summary" t-as="s">
                    <tr>
                        <td style="text-align: left; font-size: 13px; border-bottom: hidden;"><span t-esc="s['so_name']"/></td>
                        <td style="text-align: left; font-size: 13px; border-bottom: hidden;"><span t-esc="s['invoice_name']"/></td>
                        <td style="text-align: center; font-size: 13px; border-bottom: hidden;"><span t-esc="s['invoice_date']"/></td>
                        <td style="text-align: left; font-size: 13px; border-bottom: hidden;"><span t-esc="s['pay_type']"/></td>
                        <td style="text-align: left; font-size: 13px; border-bottom: hidden;"><span t-esc="s['doc_type']"/></td>
                        <td style="text-align: right; font-size: 13px; border-bottom: hidden;"><span t-esc="'{0:,.2f}'.format(s['amount'])"/></td>
                    </tr>
                </t>
                <tr>
                    <td colspan="5" style="text-align: right; font-size: 13px; border-top: 1px solid black; padding-top: 2px;">
                        <strong>รวมยอดค้างชำระ</strong></td>
                    <td style="text-align: right; font-size: 13px; border-top: 1px solid black; padding-top: 2px;">
                        <strong><span t-esc="'{0:,.2f}'.format(ov_total)"/></strong></td>
                </tr>
            </tbody>
        </table>
</template>

    <template id="report_table">
        <style>
            .page-break {
                page-break-before: always;
            }
        </style>

        <!-- ดึงข้อมูลครั้งเดียวต่อเอกสาร
             rows = รายการของตัวเอง + รายการที่ดึงมาจาก SO ที่ค้างชำระ
             ไม่บังคับตัดหน้าเอง ปล่อยให้ wkhtmltopdf จัดตามเนื้อหาจริง
             (หัวตารางอยู่ใน thead จึงขึ้นซ้ำให้ทุกหน้าอัตโนมัติ) -->
        <t t-set="ov" t-value="doc.get_overdue_rent_report_data()"/>
        <t t-set="ov_rows" t-value="ov['rows']"/>
        <t t-set="ov_summary" t-value="ov['summary']"/>
        <t t-set="ov_total" t-value="ov['total']"/>
        <!-- ลูกค้ารายนี้ไม่มีสินค้าที่ดึงมาเลย -> ซ่อนคอลัมน์อ้างอิง
             แล้วยกความกว้างไปให้ชื่อสินค้า -->
        <t t-set="ov_has_ref" t-value="ov['has_ref']"/>
        <t t-set="name_width" t-value="'18%' if ov_has_ref else '31%'"/>

        <table width="100%" style="mt-1">
            <thead>
                <tr style="border-bottom: 1px solid black !important; font-size: 13px;">
                    <th width="3%" class="text-center border_report" style="font-size: 13px;">ลำดับ</th>
                    <th t-att-width="name_width" class="text-center border_report" style="font-size: 13px;">รายการสินค้า</th>
                    <th t-if="ov_has_ref" width="13%" class="text-center border_report" style="padding: 0 4px;font-size: 13px;">อ้างอิง<br/>เลขเอกสาร</th>
                    <th width="7%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">น้ำหนักสินค้า</th>
                    <th width="6%" class="text-right border_report" style="font-size: 13px;">จำนวน</th>
                    <th width="11%" class="text-right border_report" style="padding: 0 6px;font-size: 13px;">ค่าปรับเงินประกัน<br/>หลังหักค่าเสื่อมแล้ว</th>
                    <th width="8%" class="text-right border_report" style="padding: 0 6px;font-size: 13px;">ค่าซ่อมแซม<br/>(B/ชิ้น)</th>
                    <th width="8%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">ค่าเช่า<br/>ต่อหน่วย</th>
                    <th width="10%" class="text-right border_report" style="padding: 0 4px;font-size: 13px;">รวมเป็นเงิน</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="ov_rows" t-as="l">
                    <tr>
                        <td class="text-center" style="font-size: 13px;border-bottom:hidden;"><span t-esc="l_index + 1"/></td>
                        <td class="text-left" style="font-size: 13px;border-bottom:hidden;">
                            <span t-esc="l['name']"/></td>
                        <!-- รายการของตัวเองเว้นว่าง / รายการที่ดึงมาแสดงเลขเอกสาร -->
                        <td t-if="ov_has_ref" class="text-center" style="font-size: 12px;border-bottom:hidden;">
                            <t t-if="not l['is_own']"><span t-esc="l['ref_doc']"/></t>
                        </td>
                        <td class="text-right" style="font-size: 13px; border-bottom: hidden;">
                            <t t-if="l['is_own']"><span t-esc="'{0:,.2f}'.format(l['weight'])"/></t>
                            <t t-else="">&#160;</t>
                        </td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;"><span t-esc="'{0:,.0f}'.format(l['qty'])"/></td>
                        <!-- แถวที่ดึงมาจากเอกสารอื่นแสดงแค่ ชื่อสินค้า/เลขอ้างอิง/จำนวน
                             ที่เหลือเว้นว่าง เพราะไม่ได้คิดเงินในใบนี้ ใส่ตัวเลขไว้จะเข้าใจผิด -->
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;">
                            <t t-if="l['is_own']"><span t-esc="'{0:,.2f}'.format(l['insurance'])"/></t>
                            <t t-else="">&#160;</t>
                        </td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;">
                            <t t-if="l['is_own']">ตามจริง</t>
                            <t t-else="">&#160;</t>
                        </td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;">
                            <t t-if="l['is_own']"><span t-esc="'{0:,.2f}'.format(l['price_unit'])"/></t>
                            <t t-else="">&#160;</t>
                        </td>
                        <td class="text-right" style="font-size: 13px;border-bottom:hidden;">
                            <t t-if="l['is_own']"><span t-esc="'{0:,.2f}'.format(l['subtotal'])"/></t>
                            <t t-else="">&#160;</t>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

        <!-- ตารางสรุปยอดค้างชำระ ต่อท้ายตารางสินค้า
             ถ้าที่ว่างท้ายหน้าไม่พอ page-break-inside: avoid จะยกทั้งตารางไปหน้าถัดไป -->
        <t t-if="ov_summary">
            <t t-call="npd_rent_invoice_overdue.report_overdue_summary"/>
        </t>
</template>

