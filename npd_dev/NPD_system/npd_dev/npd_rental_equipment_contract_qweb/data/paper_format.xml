<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A4 ขอบกระดาษแคบ เพื่อบีบเนื้อหาให้อยู่หน้าเดียว -->
    <record id="paperformat_rental_contract" model="report.paperformat">
        <field name="name">สัญญาเช่าอุปกรณ์ก่อสร้าง A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">6</field>
        <field name="dpi">90</field>
    </record>

    <!-- A4 สำหรับสัญญาเช่า 3 หน้า: ขอบบนกว้างขึ้น ไม่ให้ข้อความชิดขอบบน -->
    <record id="paperformat_rental_contract_3p" model="report.paperformat">
        <field name="name">สัญญาเช่าอุปกรณ์ก่อสร้าง 3 หน้า A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">13</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>
</odoo>
