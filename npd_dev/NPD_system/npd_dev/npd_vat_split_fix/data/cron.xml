<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- เซิร์ฟเวอร์และ Odoo เก็บเวลาเป็น UTC: 20:00 UTC = 03:00 เวลาไทย (UTC+7) ของวันถัดไป
             ยิงทุกวัน แต่โค้ดทำงานเฉพาะวันที่ 1 (เวลาไทย) = คืนหลังวันสุดท้ายของเดือน แก้ทั้งเดือนก่อนหน้า
             ส่วนต่างขั้นต่ำปรับได้ที่ System Parameter npd_vat_split_fix.cron_min_diff (ค่าเริ่มต้น 0.01) -->
        <record id="ir_cron_npd_vat_split_fix_month_end" model="ir.cron">
            <field name="name">แก้ฐาน/VAT ไม่ตรงยอดรวม (สิ้นเดือน 03:00 เวลาไทย)</field>
            <field name="model_id" ref="model_npd_vat_split_fix"/>
            <field name="state">code</field>
            <field name="code">model._cron_fix_previous_month()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.utcnow() + (timedelta(days=1) if DateTime.utcnow().hour >= 20 else timedelta(days=0))).strftime('%Y-%m-%d 20:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
