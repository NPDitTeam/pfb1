<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== popup ตรวจและแก้ ===================== -->
    <record id="view_npd_vat_split_fix_wizard_form" model="ir.ui.view">
        <field name="name">npd.vat.split.fix.wizard.form</field>
        <field name="model">npd.vat.split.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="ตรวจและแก้ฐาน/VAT ไม่ตรงยอดรวม">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'draft')]}">
                    ค้นหาใบแจ้งหนี้/ใบลดหนี้ที่ <b>ยอดก่อน VAT ไม่เท่ากับ ยอดรวม ÷ 1.07</b> (แบบที่ iTAX คำนวณ)
                    แล้วแก้ฐานและ VAT ให้ถูก <b>ยอดรวมไม่เปลี่ยน</b> และย้อนกลับได้จากเมนู ประวัติการแก้
                </div>
                <group attrs="{'invisible': [('state', '!=', 'draft')]}">
                    <group>
                        <field name="scope" widget="radio"/>
                        <field name="numbers" placeholder="เช่น CN-1019260004, INV-1007260010"
                               attrs="{'invisible': [('scope', '!=', 'numbers')], 'required': [('scope', '=', 'numbers')]}"/>
                    </group>
                    <group>
                        <field name="period" widget="radio"/>
                        <field name="month" attrs="{'invisible': [('period', '!=', 'month')], 'required': [('period', '=', 'month')]}"/>
                        <field name="year" attrs="{'invisible': [('period', '!=', 'month')], 'required': [('period', '=', 'month')]}"
                               options="{'format': false}"/>
                    </group>
                    <group>
                        <field name="include_invoice"/>
                        <field name="include_refund"/>
                        <field name="min_diff"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('state', '=', 'draft')]}">
                    <field name="summary" nolabel="1"/>
                    <field name="count_fix"/>
                    <field name="count_skip"/>
                </group>
                <field name="line_ids" attrs="{'invisible': [('state', '=', 'draft')]}">
                    <tree editable="bottom" create="0" delete="0"
                          decoration-muted="status == 'skip'" decoration-success="status == 'done'"
                          decoration-danger="status == 'error'">
                        <field name="selected" attrs="{'readonly': [('status', '!=', 'fix')]}"/>
                        <field name="move_id"/>
                        <field name="move_type"/>
                        <field name="move_date"/>
                        <field name="partner_id" optional="show"/>
                        <field name="total"/>
                        <field name="old_base"/>
                        <field name="new_base"/>
                        <field name="old_tax"/>
                        <field name="new_tax"/>
                        <field name="diff"/>
                        <field name="status"/>
                        <field name="reason"/>
                        <field name="log_id" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_search" string="ค้นหา" type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_apply" string="แก้รายการที่เลือก" type="object" class="btn-primary"
                            confirm="ยืนยันแก้ยอดก่อน VAT และ VAT ของรายการที่เลือก? (ยอดรวมไม่เปลี่ยน ย้อนกลับได้)"
                            attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button name="action_select_all" string="เลือกทั้งหมด" type="object"
                            attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button name="action_select_none" string="ไม่เลือกเลย" type="object"
                            attrs="{'invisible': [('state', '!=', 'preview')]}"/>
                    <button name="action_open_log" string="ดูประวัติที่แก้" type="object"
                            attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <button name="action_back" string="ค้นหาใหม่" type="object"
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button string="ปิด" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_npd_vat_split_fix_wizard" model="ir.actions.act_window">
        <field name="name">ตรวจและแก้ฐาน/VAT ไม่ตรงยอดรวม</field>
        <field name="res_model">npd.vat.split.fix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===================== ประวัติการแก้ ===================== -->
    <record id="view_npd_vat_split_fix_log_tree" model="ir.ui.view">
        <field name="name">npd.vat.split.fix.log.tree</field>
        <field name="model">npd.vat.split.fix.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" decoration-muted="state == 'undone'">
                <field name="create_date" string="วันที่แก้"/>
                <field name="move_name"/>
                <field name="move_type"/>
                <field name="move_date"/>
                <field name="partner_id" optional="show"/>
                <field name="total" sum="รวม"/>
                <field name="old_base"/>
                <field name="new_base"/>
                <field name="old_tax" sum="รวม"/>
                <field name="new_tax" sum="รวม"/>
                <field name="diff" sum="รวม"/>
                <field name="source"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_undo" type="object" string="ย้อนกลับ" icon="fa-undo"
                        confirm="ย้อนกลับเป็นยอดเดิมของเอกสารนี้?"
                        attrs="{'invisible': [('state', '!=', 'done')]}"/>
            </tree>
        </field>
    </record>

    <record id="view_npd_vat_split_fix_log_form" model="ir.ui.view">
        <field name="name">npd.vat.split.fix.log.form</field>
        <field name="model">npd.vat.split.fix.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_undo" type="object" string="ย้อนกลับเป็นยอดเดิม" class="btn-secondary"
                            confirm="ย้อนกลับเป็นยอดเดิมของเอกสารนี้?"
                            attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <button name="action_open_move" type="object" string="เปิดเอกสาร"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="move_id"/>
                            <field name="move_date"/>
                            <field name="partner_id"/>
                            <field name="source"/>
                            <field name="user_id"/>
                            <field name="create_date" string="วันที่แก้"/>
                        </group>
                        <group>
                            <field name="total"/>
                            <field name="old_base"/>
                            <field name="new_base"/>
                            <field name="old_tax"/>
                            <field name="new_tax"/>
                            <field name="undo_user_id" attrs="{'invisible': [('state', '!=', 'undone')]}"/>
                            <field name="undo_date" attrs="{'invisible': [('state', '!=', 'undone')]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_npd_vat_split_fix_log_search" model="ir.ui.view">
        <field name="name">npd.vat.split.fix.log.search</field>
        <field name="model">npd.vat.split.fix.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_name"/>
                <field name="partner_id"/>
                <filter name="done" string="แก้แล้ว" domain="[('state', '=', 'done')]"/>
                <filter name="undone" string="ย้อนกลับแล้ว" domain="[('state', '=', 'undone')]"/>
                <separator/>
                <filter name="cron" string="ระบบแก้อัตโนมัติ" domain="[('source', '=', 'cron')]"/>
                <filter name="manual" string="แก้จากเมนู" domain="[('source', '=', 'manual')]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_month" string="เดือนเอกสาร" context="{'group_by': 'move_date:month'}"/>
                    <filter name="group_source" string="ที่มา" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_npd_vat_split_fix_log" model="ir.actions.act_window">
        <field name="name">ประวัติการแก้ฐาน/VAT</field>
        <field name="res_model">npd.vat.split.fix.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===================== เมนู ===================== -->
    <menuitem id="menu_npd_vat_split_fix_root" name="แก้ฐาน/VAT" parent="account.menu_finance"
              sequence="90" groups="account.group_account_manager"/>
    <menuitem id="menu_npd_vat_split_fix_wizard" name="ตรวจและแก้ฐาน/VAT ไม่ตรงยอดรวม"
              parent="menu_npd_vat_split_fix_root" action="action_npd_vat_split_fix_wizard" sequence="10"/>
    <menuitem id="menu_npd_vat_split_fix_log" name="ประวัติการแก้"
              parent="menu_npd_vat_split_fix_root" action="action_npd_vat_split_fix_log" sequence="20"/>

</odoo>
