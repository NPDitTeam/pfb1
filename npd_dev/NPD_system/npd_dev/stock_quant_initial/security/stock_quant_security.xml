<odoo>
    <data noupdate="1">
        <!-- ให้กลุ่ม Inventory Manager สามารถจัดการ stock.quant ได้ -->
        <record id="access_stock_quant_inventory_manager" model="ir.model.access">
            <field name="name">stock.quant access for inventory manager</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="group_id" ref="stock.group_stock_manager"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
