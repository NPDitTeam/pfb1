<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_inherit_tree" model="ir.ui.view">
        <field name="name">stock.quant.inherit.tree</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='quantity']" position="after">
                <field name="stock_initial"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_inherit_form" model="ir.ui.view">
    <field name="name">stock.quant.inherit.form</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='quantity']" position="after">
            <field name="stock_initial"/>
        </xpath>
    </field>
</record>

</odoo>
