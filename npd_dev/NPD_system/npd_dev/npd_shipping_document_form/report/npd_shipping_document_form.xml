            padding: 10px;
            font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
            }
            .box {
            border: 1px solid black;
            padding: 10px;
            vertical-align: top;
            font-size: 12px;
            }
            .text-left {
            text-align: left;
            }
            .text-right {
            text-align: right;
            }
            .text-center {
            text-align: center;
            }
            .bold {
            font-weight: bold;
            }
            .table-container {
            width: 100%;
            border-collapse: collapse;
            }
            .inner-table {
            width: 100%;
            }

        </style>

        <div class="">
            <table class="table-container">
                <tr>
                    <!-- ผู้ส่ง -->
                    <td class="box" style="width: 50%;">
                        <h4>
                            <strong>ผู้ส่ง</strong>
                        </h4>

                        <t t-if="doc.sale_id.delivery_type == 'customer' ">
                            ต้นทาง:
                        <span>
<!--                            <span t-esc="doc.sale_id.delivery_employee_id.address_id.name"/>-->
                            <span t-esc="doc.sale_id.pickup_location"/>
                        </span>
                        <br/>

                            ชื่อผู้ส่ง:

                            <span>
                                <span t-esc="doc.sale_id.delivery_employee_id.name"/>
                            </span>

                            <br/>
                            ที่อยู่ผู้ส่ง:
                            <span>
                                <span t-esc="doc.sale_id.delivery_employee_id.work_location"/>
                            </span>
                        </t>
                        <t t-else="">
                            ต้นทาง:
                        <span>
<!--                            <span t-esc="doc.sale_id.delivery_employee_id.address_id.name"/>-->
                            <span t-esc="doc.sale_id.pickup_location"/>
                        </span>
                        <br/>
                            ชื่อผู้ส่ง:
                            <span>
                                <span t-esc="doc.sale_id.partner_id.name"/>
                            </span>
                            <br/>
                            ที่อยู่ผู้ส่ง:
                            <span>
                                <span t-esc="doc.sale_id.partner_shipping_id.street"/>
                            </span>
                                    </t>

                    </td>

                    <!-- ค่าขนส่งสินค้า -->
                    <td class="box text-center" style="width: 25%;">
                        <h4>
                            <strong>ค่าขนส่งสินค้า</strong>
                        </h4>

<!--                        <span class="bold" style="font-size: 14px;">-->
<!--                            <span t-esc="doc.sale_id.shipping_cost"/>-->
<!--                        </span>-->
                        <span class="bold" style="font-size: 14px;">
<!--    <span t-if="doc.sale_id.shipping_cost_m" t-esc="doc.sale_id.shipping_cost_m"/>-->
<!--    <span t-else="" t-esc="doc.sale_id.shipping_cost"/>-->
                            <!-- แสดงค่าขนส่งตามเงื่อนไข -->
                        <t t-if="doc.sale_id.use_special_delivery_zero and doc.sale_id.shipping_cost_m == 0">
                            <span t-esc="doc.sale_id.shipping_cost_m"/>
                        </t>
                        <t t-elif="not doc.sale_id.use_special_delivery_zero and doc.sale_id.shipping_cost_m > 0">
                            <span t-esc="doc.sale_id.shipping_cost_m"/>
                        </t>
                        <t t-elif="not doc.sale_id.use_special_delivery_zero and doc.sale_id.shipping_cost_m == 0">
                            <span t-esc="doc.sale_id.shipping_cost"/>
                        </t>
                        <t t-else="">
                            <span t-esc="doc.sale_id.shipping_cost"/>
                        </t>

                        </span>
                    </td>
                </tr>

                <tr>
                    <!-- ผู้รับ -->
                    <td class="box">
                        <h4>
                            <strong>ผู้รับ</strong>
                        </h4>



                        <t t-if="doc.sale_id.delivery_type == 'customer' ">
                            ปลายทาง:
                        <span>
                            <span t-esc="doc.sale_id.destination"/>
                        </span>
                        <br/>

                            ชื่อผู้รับ:
                            <span>
                                <span t-esc="doc.sale_id.partner_id.name"/>
                            </span>
                            <br/>
                            ที่อยู่ผู้รับ:
                            <span>
                                <span t-esc="doc.sale_id.partner_shipping_id.street"/>
                            </span>

                        </t>
                        <t t-else="">
                        ปลายทาง:
                        <span>
                            <span t-esc="doc.sale_id.destination"/>
                        </span>
                        <br/>
                             ชื่อผู้รับ:

                            <span>
                                <span t-esc="doc.sale_id.delivery_employee_id.name"/>
                            </span>

                            <br/>
                            ที่อยู่ผู้รับ:
                            <span>
                                <span t-esc="doc.sale_id.delivery_employee_id.work_location"/>
                            </span>

                        </t>
                    </td>

                    <!-- ระยะทาง -->
                    <td class="box text-center">
                        <h4>
                            <strong>ระยะทาง (กิโลเมตร)</strong>
                        </h4>

                        <span class="bold" style="font-size: 14px;">
                            <span t-esc="doc.sale_id.distance_km"/>
                        </span>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="so_form_detail_top">

        <table>
            <thead>
                <tr>
                    <th width="1%" class="text-center line-distance small-font number-col border_report">ลำดับ</th>

                </tr>
            </thead>


        </table>
    </template>

    <template id="so_form_footer">
        <style>
            .doc-footer {
            margin-top: 10px; /* เพิ่มระยะห่างด้านบน */
            <!--        padding-bottom: 90px; /* เพิ่มระยะห่างด้านล่าง */-->
            }
        </style>


        <t t-set="total_weight"
           t-value="sum((l.total_weight or 0.0) for l in (doc.sale_id.order_line or []) if l.price_subtotal >= 0)"/>
        <div class="footer">
            <div class="row">
                <div class="col-6">
                </div>
                <div class="col-6 text-right" style="padding-right: 40px; font-size: 13px;">
                    <div>
