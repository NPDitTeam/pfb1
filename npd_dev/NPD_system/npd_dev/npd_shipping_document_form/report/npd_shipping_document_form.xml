<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="assets_common" name="l10n_ch_isr_report" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css"
                  href="npd_shipping_document_form/static/report.css"/>
        </xpath>
    </template>

    <record id="paperformat_stock_form_test" model="report.paperformat">
        <field name="name">A4 Custom</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">75</field>
        <field name="margin_bottom">85</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">75</field>
        <field name="dpi">90</field>
    </record>

    <report
            id="action_pfb_npd_inventory_overview_rental_return_form"
            string="ใบขนส่งสินค้า"
            name="npd_shipping_document_form.form_stock_npd_npd"
            model="stock.picking"
            report_type="qweb-pdf"
            print_report_name="'ใบขนส่งสินค้า - %s' % (object.name)"
            paperformat="npd_shipping_document_form.paperformat_stock_form_test"

    />

    <template id="so_form_header">
        <style>
            h2 {
            font-size: 18px;
            }
            h4 {
            font-size: 14px;
            margin-top: 0;
            margin-bottom: 4px;
            }
            .font_weight {
            font-weight: 800;
            }
            .address-line {
            font-size: 10px;
            margin-top: 5px;
            }
            .tax-id {
            font-size: 10px;
            margin-top: -10px;
            display: block;
            }
            .header-container {
            display: flex;
            align-items: flex-start;
            }
            .company-info {
            margin-left: 40px;
            margin-top: 30px;
            }
            .document-info {
            margin-top: 15px;
            <!--                margin-left: -20px;-->
            }
            .text-rent {
            font-size: 7px;
            margin-top: -10px
            }
            .date-info {
            margin-top: -10px;
            }
            .doc-post {
            font-size: 8px;
            }
        </style>
        <div class="row">
            <div class="col-1" style="margin-top: 30px;">
                <img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-1"/>
            <div class="col-6 company-info line-distance">
                <h2 class="font_weight">
                    <strong>
                        <span t-esc="user.branch_id.company_id.name if user.branch_id and user.branch_id.company_id else 'สำนักงานใหญ่'"/>
                    </strong>
                </h2>
                <p t-if="user.branch_id and user.branch_id.address" style="white-space: pre-line; font-size: 13px;">
                    <t t-raw="user.branch_id.address"/>
                </p>
                <p t-else="" style="font-size: 13px;">
                    ไม่มีที่อยู่
                </p>


            </div>
            <div class="col-4" style="margin-top: 30px;">
                <table width="100%">
                    <tr style="">
                        <td style="display:block;width: 260px;text-align: center;padding-top: 5px; padding-right: -70px;">
                            <p class="text-center document-info">
                                <h4>
                                    <strong>ใบขนส่งสินค้า</strong>
                                </h4>
                            </p>
                            <p class="text-center">
                                <strong>เลขที่:
                                    <span t-esc="doc.name"/>
                                </strong>
                            </p>
                            <p class="text-center">
                                <strong>วันที่ส่งคืนสินค้า:
                                    <span t-esc="doc._get_formatted_commitment_date()"/>
                                </strong>
                            </p>
                            <!--                            <p class="text-center text-rent"><strong>ใบกำกับการเช่า</strong></p>-->
                            <!--                            <p class="text-center text-rent"><span t-esc="doc.sale_id.name"/></p>-->
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row" style="margin-bottom: 10px;"/>
    </template>


    <template id="so_form_title">
