                    </td>
                </tr>
            </table>

        </div>

    </template>


    <template id="form_stock_npd_npd">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!--  เพิ่มการคำนวณค่า total_weight ก่อนเรียก so_form_footer -->
                <t t-set="total_weight" t-value="sum((l.total_weight or 0.0) for l in (doc.sale_id.order_line or []))"/>

                <t t-call="web.basic_layout">
                    <div class="header">
                        <table width="100%" border="1">
                            <tr>
                                <td>
                                    <t t-call="npd_shipping_document_form.so_form_header"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <t t-call="npd_shipping_document_form.so_form_title"/>
                                </td>
                            </tr>

                        </table>

                    </div>
                    <t t-set="lines" t-value="doc.sale_id.order_line.filtered(lambda l: l.price_subtotal &gt;= 0)"/>
                    <t t-set="rows_per_page" t-value="18"/>
                    <t t-foreach="range(0, len(lines), rows_per_page)" t-as="page_start">
                        <table width="100%" style="font-size: 13px;">
                            <thead>
                                <tr style="border-bottom: 1px solid black !important;">
                                    <th width="5%" class="text-center line-distance small-font number-col border_report" style="padding: 10px;">ลำดับ</th>
                                    <th width="50%" class="text-left line-distance small-font list-col border_report">รายการสินค้า</th>
                                    <th width="9%" class="text-right line-distance small-font weight-col border_report">จำนวน</th>
                                    <th width="9%" class="text-right line-distance small-font adjusted-col border_report">น้ำหนัก/หน่วย</th>
                                    <th width="11%" class="text-right line-distance small-font repair-col border_report">น้ำหนักรวม</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="lines[page_start:page_start + rows_per_page]" t-as="l">
                                    <tr>
                                        <td class="text-center line-distance number-col" style="padding: 5px;">
                                            <span t-esc="page_start + l_index + 1"/>
                                        </td>
                                        <td class="text-left line-distance list-col">
                                            <span t-esc="l.name"/>
                                        </td>
                                        <td class="text-right line-distance weight-col">
                                            <span t-esc="'{0:,.2f}'.format(l.pfb_quantity)"/>
                                        </td>
                                        <td class="text-right line-distance weight-col">
                                            <span t-esc="'{0:,.2f}'.format(l.second_uom_qty)"/>
                                        </td>
                                        <td class="text-right line-distance weight-col">
                                            <span t-esc="'{0:,.2f}'.format(l.total_weight)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div t-if="page_start + rows_per_page &lt; len(lines)" style="page-break-after: always;"/>
                    </t>
                    <t t-call="npd_shipping_document_form.so_form_footer"/>

                </t>
            </t>
        </t>
    </template>


</odoo>