                    </td>
                    <td>
                        <span class="signature-title"></span><br/>
                        <span class="">________________________</span><br/>
                        <span class="signature-subtitle" style="font-size: 12px;">(เจ้าหน้าที่ใบสินค้า)</span>

                    </td>
                    <td>
                        <span class="signature-title">
                            <span t-esc="doc.sale_id.license_plate_id.name"/>
                            :
                            <span t-esc="doc.sale_id.delivery_employee_id.name"/>
                        </span><br/>
                        <span class="">________________________</span><br/>
                        <span class="signature-subtitle" style="font-size: 12px;">(ทะเบียนรถ / ชื่อผู้ขับ)</span>

                    </td>
                    <td>
                        <span class="signature-title"></span><br/>
                       <span class="">________________________</span><br/>
