<odoo>
    <!-- ฟอร์ม Wizard -->
    <record id="view_request_picking_approval_wizard" model="ir.ui.view">
        <field name="name">stock.picking.request.approval.wizard.form</field>
        <field name="model">stock.picking.request.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งอนุมัติ">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="approver_id"/>
                    <field name="request_note"/>
                </group>
                <footer>
                    <button string="ยืนยัน" type="object" name="action_send_approval" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action ที่ปุ่มใน stock.picking จะอ้างถึง -->
    <record id="request_picking_approval_wizard_action" model="ir.actions.act_window">
    <field name="name">ส่งอนุมัติ</field>
    <field name="res_model">stock.picking.request.approval.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{'default_picking_id': active_id}</field>
</record>

</odoo>
