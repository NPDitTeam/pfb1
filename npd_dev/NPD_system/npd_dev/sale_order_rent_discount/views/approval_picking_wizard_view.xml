<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_approval_wizard" model="ir.ui.view">
        <field name="name">stock.picking.approval.wizard.form</field>
        <field name="model">stock.picking.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="พิจารณาอนุมัติ">
                <separator string="ข้อมูลการขออนุมัติ"/>
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="request_note" readonly="1" style="background-color:#fff8c6; color:#8a6d3b;"/>
                    <field name="rent_discount" readonly="1" string="ยอดส่วนลด"/>
                </group>

                <separator string="การพิจารณา"/>
                <group>
                    <field name="action" widget="radio"/>
                    <field name="approval_note" placeholder="ระบุเหตุผลในการพิจารณา..." required="1"/>
                </group>

                <footer>
                    <button string="ยืนยัน" type="object" name="action_process" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="approval_picking_wizard_action" model="ir.actions.act_window">
        <field name="name">พิจารณาอนุมัติ</field>
        <field name="res_model">stock.picking.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_picking_id': active_id}</field>
    </record>
</odoo>