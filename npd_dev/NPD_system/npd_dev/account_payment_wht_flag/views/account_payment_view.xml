<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inherit ฟอร์มชำระเงิน เพื่อเพิ่มช่องติ๊ก -->
  <record id="view_account_payment_form_wht_flag_inherit" model="ir.ui.view">
    <field name="name">account.payment.form.wht.flag.inherit</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">
      <!-- วางหลังช่องอ้างอิง (communication/ref) ของฟอร์ม -->
      <xpath expr="//field[@name='rental_difference_status']" position="after">
        <field name="wht_has_slip"/>
        <field name="received_payment"/>
        <field name="pfb_date_of_rent"/>
      </xpath>
    </field>
  </record>
</odoo>
