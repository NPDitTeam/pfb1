<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_discount" model="ir.ui.view">
        <field name="name">purchase.order.form.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_tax']" position="before">
                <field name="purchase_order_discount"  widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>