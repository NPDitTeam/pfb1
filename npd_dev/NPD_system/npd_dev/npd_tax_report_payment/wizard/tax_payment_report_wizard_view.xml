<odoo>
    <record id="tax_payment_report_wizard_form" model="ir.ui.view">
        <field name="name">tax.payment.report.wizard.form</field>
        <field name="model">tax.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <!-- Tax Group / Tax มีค่าเริ่มต้นเป็น VAT 7% / ภาษีขาย Vat 7% ให้แล้ว
                     (ดู _default_tax_group / _default_tax_ids ใน wizard) -->
                <div class="alert alert-info" role="alert" style="margin-bottom: 8px;">
                    รายงานนี้ดึงยอดจาก <b>ใบรับชำระ (การชำระ)</b> ที่สถานะลงบันทึกแล้ว
                    ตามช่วงวันที่ที่เลือก โดยใช้ยอด Payment Amount ถอด VAT เป็น Base Amount
                </div>
                <group name="criteria">
                    <group>
                        <field
                            name="company_id"
                            options="{'no_create_edit': True, 'no_open': True}"
                            groups="base.group_multi_company"
                        />
                        <field name="tax_group_id"
                         options="{'no_create_edit': True, 'no_open': True}"/>
                        <field
                            name="tax_id"
                            widget="many2many_tags"
                            options="{'no_create_edit': True, 'no_open': True}"
                        />
                    </group>
                    <group>
                        <field
                            name="date_range_id"
                            options="{'no_create_edit': True, 'no_open': True}"
                        />
                                                </group>
                </group>
                <group invisible="1">
                    <field name="report_file" filename="report_file_name"/>
                    <field name="report_file_name"/>
                </group>
                <footer>
                    <button
                        name="button_export_html"
                        string="View"
                        type="object"
                        default_focus="1"
                        class="oe_highlight"
                    />
                    or
                    <button
                        name="button_export_pdf"
                        string="Export PDF"
                        type="object"
                    />
                    or
                    <!-- ของเดิมผูกไว้กับ button_export_test_xlsx ทำให้หัวเรื่อง
                         และชื่อชีตขึ้นคำว่า Test นำหน้า -->
                    <button
                        name="button_export_xlsx"
                        string="Export Excel"
                        type="object"
                    />
                    or
<!--                    <button-->
<!--                        name="button_export_xlsx"-->
<!--                        string="Export XLSX"-->
<!--                        type="object"-->
<!--                    />-->
<!--                    or-->
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_tax_payment_report" model="ir.actions.act_window">
        <field name="name">Thai Tax Reports Payment</field>
        <field name="res_model">tax.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_tax_payment_report"
        parent="account.menu_finance_reports"
        action="action_tax_payment_report"
        name="Thai Tax Report Payment"
        groups="account.group_account_manager,account.group_account_user"
    />
</odoo>