    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
<!--                <button name="%(sale.action_view_sale_advance_payment_inv)d" string="รับเงินประกัน"-->
<!--                        type="action" class="btn-primary"-->
<!--                        attrs="{'invisible': [('invoice_status', '!=', 'to invoice')]}"/>-->
                <button name="%(pfb_npd_all_customs.action_view_sale_rent_inv)d" string="รับเงินประกัน"
                        type="action" context="{'default_advance_payment_method': 'fixed'}"
                        attrs="{'invisible': [('state', '!=', 'sale')]}"/>
            </xpath>
            <xpath expr="//sheet//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_rent"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('rent_count', '=', 0)]}">
                            <field name="rent_count" widget="statinfo" string="รับเงินประกัน"/>
                        </button>
            </xpath>

            <field name="partner_shipping_id" position="after">
                <field name="pfb_so_type" widget="radio"/>

                <field name="pfb_objective_id" attrs="{'invisible': [('pfb_so_type', '=', 'sale')]}"/>
                <field name="pfb_date_of_rent" context="{'pfb_date_of_rent':pfb_date_of_rent}"
                       attrs="{'invisible': [('pfb_so_type', '=', 'sale')]}"/>
                <field name="note_approver" widget="html" invisible="1"/>

            </field>
  <!-- เพิ่ม total_rental_discount หลัง amount_untaxed -->
        <xpath expr="//field[@name='amount_untaxed']" position="after">
            <field name="total_rental_discount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
        </xpath>


            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="after">
                <field name="pfb_so_rent_ok" invisible="1"/>
                <field name="pfb_date_of_rent" force_save="1"
                       attrs="{'pfb_so_rent_ok': [('pfb_so_rent_ok', '=', 0)]}"/>
<!--                <field name="pfb_quantity" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}"/>-->

                <field name="pfb_quantity_readonly" invisible="1"/>
                <field name="product_uom_qty_readonly" invisible="1"/>

                <field name="pfb_quantity"
       attrs="{'invisible': [('pfb_so_rent_ok', '=', 0)],
               'readonly': [('pfb_quantity_readonly', '=', True)]}"/>




<!--                <field name="discount_npd" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}"/>-->
                <field name="product_uom_qty_npd" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="replace">
                 <field name="product_uom_qty"
       attrs="{'invisible': [('pfb_so_rent_ok', '=', 0)],
               'readonly': [('product_uom_qty_readonly', '=', True)]}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="before">
                  <field name="discount_type_selection"/>
            </xpath>


            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom']" position="after">
                <field name="pfb_insurance_price" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}"/>
            </xpath>

            <xpath expr="//tree/field[@name='product_template_id']" position="attributes">
                <attribute name="domain">[
                    ('pfb_rent_ok', '=', pfb_so_rent_ok),
                    '|', ('sale_ok', '=', True),
                    '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]
                </attribute>
            </xpath>

<xpath expr="//group[hasclass('oe_subtotal_footer')]" position="after" attrs="{'invisible': [('pfb_so_rent_ok', '=', 0)]}">
    <group>
        <div style="margin-top: 15px; border-top: 1px solid #ddd; padding-top: 15px;">
            <table style="width: 100%; border-collapse: collapse;">
                <!-- ค่าประกันสินค้า -->
                <tr>
                    <td style="text-align: left; padding-right: 10px; font-weight: bold; width: 70%; color: #333;">ค่าประกันสินค้า:</td>
                    <td style="text-align: right; width: 30%; color: #555;">
                        <field name="pfb_amount_insurance" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </td>
                </tr>
                <!-- ส่วนลดค่าประกันสินค้า -->
                <tr>
                    <td style="text-align: left; padding-right: 8px; font-weight: bold; color: #333;">ส่วนลดค่าประกันสินค้า:</td>
                    <td style="text-align: right; width: 30%; color: #555;">
                        <field name="pfb_dis_amount_insurance" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </td>
                </tr>
                <!-- ค่าประกันต่ำสุดไม่เกิน -->
                <tr>
                    <td style="text-align: left; padding-right: 10px; font-weight: bold; color: red;">ค่าประกันต่ำสุดไม่เกิน:</td>
                    <td style="text-align: right; width: 30%; color: red;">
                        <field name="pfb_insurance_min" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>

                    </td>
                </tr>

                <tr>
                    <td style="text-align: left; padding-right: 8px; font-weight: bold; color: #333;">กรอกจำนวนค่าประกันที่ต้องการ:</td>
                    <td style="text-align: right; width: 30%; color: #555;">
                        <field name="pfb_required_insurance_premium" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </td>
                </tr>

                <!-- ค่าประกันสุทธิ -->
                <tr style="border-top: 1px solid #ddd;">
                    <td style="text-align: left; padding-right: 10px; font-weight: bold; font-size: 16px; color: #000;">ค่าประกันสุทธิ:</td>
                    <td style="text-align: right; width: 30%; font-weight: bold; font-size: 16px; color: #000;">
                        <field name="pfb_amount" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </td>
                </tr>

            </table>
        </div>
    </group>
</xpath>






