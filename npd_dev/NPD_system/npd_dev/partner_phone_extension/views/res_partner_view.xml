<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit_extension" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.extension</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- วางปุ่มไว้ในตำแหน่งที่เหมาะสมภายใน sheet -->
            <xpath expr="//sheet" position="inside">
                <button name="update_phone_extension" type="object" string="Update Phone Extension" class="oe_highlight"/>
            </xpath>

        </field>
    </record>
</odoo>
