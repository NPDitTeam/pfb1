<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_branch_address_wizard_form" model="ir.ui.view">
        <field name="name">branch.address.wizard.form</field>
        <field name="model">branch.address.wizard</field>
        <field name="arch" type="xml">
            <form string="จัดการที่อยู่">
                <group>
                    <group>
                        <field name="branch_id" invisible="1"/>
                        <field name="branch_name" string="สาขา"/>
                    </group>
                </group>
                <group>
                    <field name="address_selection" widget="radio"/>
                </group>
                <footer>
                    <button name="action_save" string="บันทึก" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_branch_address_wizard" model="ir.actions.act_window">
        <field name="name">จัดการที่อยู่</field>
        <field name="res_model">branch.address.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_branch_address_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
