<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action: อัปเดตสถานะคืนเงินประกัน -->
        <record id="ir_cron_deposit_return_status_update" model="ir.cron">
            <field name="name">อัปเดตสถานะคืนเงินประกัน</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.run_deposit_return_status_update()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
