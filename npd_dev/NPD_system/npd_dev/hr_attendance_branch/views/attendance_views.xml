<odoo>
    <record id="view_hr_attendance_branch_form" model="ir.ui.view">
        <field name="name">hr.attendance.branch.form</field>
        <field name="model">hr.attendance.branch</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <group>
                    <field name="user_id" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="username"/>
                    <field name="date_requested"/>
                    <field name="branch" invisible="1"/>
                    <field name="branch_id"/>
                    <field name="department" invisible="1"/>
                    <field name="position" invisible="1"/>
                    <field name="department_id"/>
                    <field name="position_id"/>
                    <field name="check_type"/>
                    <field name="company"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                    <field name="address"/>
                    <field name="accuracy"/>
                    <field name="checked_at"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_hr_attendance_branch_tree" model="ir.ui.view">
        <field name="name">hr.attendance.branch.tree</field>
        <field name="model">hr.attendance.branch</field>
        <field name="arch" type="xml">
            <tree string="Attendance List">
                <field name="user_id" invisible="1"/>
                <field name="employee_id"/>
                <field name="username"/>
                <field name="date_requested"/>
                <field name="branch" invisible="1"/>
                <field name="branch_id"/>
                <field name="department" invisible="1"/>
                <field name="position" invisible="1"/>
                <field name="department_id"/>
                <field name="position_id"/>
                <field name="check_type"/>
                <field name="company"/>
                <field name="checked_at"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="address"/>
                <field name="accuracy"/>
            </tree>
        </field>
    </record>

    <record id="action_hr_attendance_branch" model="ir.actions.act_window">
        <field name="name">เข้างาน/ออกงาน</field>
        <field name="res_model">hr.attendance.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': True, 'edit': True, 'delete': True}</field>
    </record>

    <menuitem id="menu_hr_attendance_root" name="ลงเวลาพนักงาน" sequence="10"/>
    <menuitem id="menu_hr_attendance_branch" name="เข้างาน/ออกงาน" parent="menu_hr_attendance_root" action="action_hr_attendance_branch"/>
</odoo>
