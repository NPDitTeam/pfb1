<odoo>
  <!-- ROOT MENU -->
  <menuitem id="menu_hr_attendance_root" name="ลงเวลาพนักงาน" sequence="10"/>

  <!-- MENU: การลา -->
  <menuitem id="menu_hr_attendance_leave" name="การลา" parent="menu_hr_attendance_root" action="action_leave_request" sequence="30"/>

  <!-- VIEW: Leave Form -->
  <record id="view_leave_request_form" model="ir.ui.view">
    <field name="name">leave.request.form</field>
    <field name="model">hr.attendance.branch.leave</field>
    <field name="arch" type="xml">
      <form string="Leave Form">
        <group>
          <field name="hr_id_attendance_branch_leave" invisible="1"/>
          <field name="employee_id"/>
          <field name="username"/>
          <field name="branch" invisible="1"/>
          <field name="branch_id"/>
          <field name="department" invisible="1"/>
          <field name="position" invisible="1"/>
          <field name="department_id"/>
          <field name="position_id"/>
          <field name="leave_start_date"/>
          <field name="start_time"/>
          <field name="leave_end_date"/>
          <field name="end_time"/>
          <field name="leave_type"/>
          <field name="state"/>
          <field name="company"/>
          <field name="note"/>
          <field name="created_at"/>
          <field name="file_path"/>
          <field name="file_link" invisible="1"/>
          <field name="filename" invisible="1"/>
          <field name="attachment" filename="filename" widget="binary"/>
          <field name="date_requested"/>
        </group>
      </form>
    </field>
  </record>

  <!-- VIEW: Leave Tree -->
  <record id="view_leave_request_tree" model="ir.ui.view">
    <field name="name">leave.request.tree</field>
    <field name="model">hr.attendance.branch.leave</field>
    <field name="arch" type="xml">
      <tree string="Leave List">
        <field name="username"/>
        <field name="branch" invisible="1"/>
        <field name="branch_id"/>
        <field name="department" invisible="1"/>
        <field name="position" invisible="1"/>
        <field name="department_id"/>
        <field name="position_id"/>
        <field name="leave_start_date"/>
        <field name="start_time"/>
        <field name="leave_end_date"/>
        <field name="end_time"/>
        <field name="leave_type"/>
        <field name="state"/>
        <field name="company"/>
        <field name="created_at"/>
        <field name="note"/>
        <field name="attachment" filename="filename" widget="binary"/>
        <field name="date_requested"/>
      </tree>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_leave_request" model="ir.actions.act_window">
    <field name="name">การลา</field>
    <field name="res_model">hr.attendance.branch.leave</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'create': True, 'edit': True, 'delete': True}</field>
  </record>
</odoo>
