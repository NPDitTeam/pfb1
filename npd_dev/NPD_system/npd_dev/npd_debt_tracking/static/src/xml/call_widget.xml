<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="CallPhoneButton">
        <div class="o_call_phone_widget">
            <!-- ก่อนกดโทร -->
            <div class="call-status-before text-center p-3">
                <button type="button" class="btn btn-primary btn-lg btn-dial-phone">
                    <i class="fa fa-phone"></i> กดโทรเลย
                </button>
            </div>
            <!-- กำลังโทร -->
            <div class="call-status-calling text-center p-3" style="display: none;">
                <div class="alert alert-warning mb-3">
                    <h4><i class="fa fa-phone fa-spin"></i> กำลังโทร...</h4>
                    <p class="mb-0">เวลาเริ่มโทรถูกบันทึกแล้ว</p>
                </div>
                <button type="button" class="btn btn-danger btn-lg btn-end-call">
                    <i class="fa fa-phone-slash"></i> จบการโทร
                </button>
            </div>
        </div>
    </t>

</templates>
