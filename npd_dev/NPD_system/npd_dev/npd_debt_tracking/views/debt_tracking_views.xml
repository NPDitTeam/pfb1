<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Debt Tracking Tree View -->
    <record id="npd_debt_tracking_view_tree" model="ir.ui.view">
        <field name="name">npd.debt.tracking.tree</field>
        <field name="model">npd.debt.tracking</field>
        <field name="arch" type="xml">
            <tree string="ติดตามหนี้" decoration-danger="state=='draft'"
                  decoration-warning="state=='in_progress'"
                  decoration-success="state=='done'">
                <field name="name" string="เลขที่เอกสาร"/>
                <field name="create_date" string="วันที่บันทึก"/>
<!--                <field name="debt_type"/>-->
                <field name="sale_id"/>
                <field name="partner_name"/>
                <field name="partner_phone" widget="phone"/>
                <field name="partner_mobile" widget="phone"/>
                <field name="partner_email"/>
                <field name="amount_total" sum="รวม"/>
                <field name="amount_residual" sum="รวมค้างชำระ"/>
                <field name="call_count"/>
                <field name="email_count"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Debt Tracking Form View -->
    <record id="npd_debt_tracking_view_form" model="ir.ui.view">
        <field name="name">npd.debt.tracking.form</field>
        <field name="model">npd.debt.tracking</field>
        <field name="arch" type="xml">
            <form string="ติดตามหนี้">
                <header>
                    <button name="action_call_mobile" type="object" 
                            string="📞 โทรหาลูกค้า" class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button name="action_send_email" type="object" 
                            string="📧 ส่งเมล" class="btn-info"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button name="action_done" type="object" 
                            string="✓ จบงานวันนี้" class="btn-success"
                            attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_cancel" type="object" 
                            string="ยกเลิก" 
                            attrs="{'invisible': [('state', 'in', ['done', 'cancel'])]}"/>
                    <button name="action_reset_draft" type="object" 
                            string="กลับไปรอดำเนินการ" 
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_call_logs" type="object"
                                class="oe_stat_button" icon="fa-phone">
                            <field name="call_count" widget="statinfo" string="ประวัติโทร"/>
                        </button>
                        <button name="action_view_email_logs" type="object"
                                class="oe_stat_button" icon="fa-envelope">
                            <field name="email_count" widget="statinfo" string="ประวัติเมล"/>
                        </button>
                    </div>
                    <group>
                        <group string="ข้อมูลติดตามหนี้">
                            <field name="create_date" string="วันที่บันทึก"/>
                            <field name="customer_id" options="{'no_create': True, 'no_open': True}"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="customer_amount_residual" string="ยอดค้างชำระใบแจ้งหนี้" readonly="1"/>
                            <field name="customer_penalty_residual" string="ค้างชำระค่าปรับหาย" readonly="1"/>
                            <field name="customer_damage_residual" string="ค้างชำระค่าปรับชำรุด" readonly="1"/>
                            <field name="customer_tax_residual" string="ค้างชำระค่า Tax" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="partner_id" invisible="1"/>
                            <field name="partner_name" invisible="1"/>
                            <field name="partner_email" widget="email"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="partner_phone" widget="phone"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="partner_mobile" widget="phone"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                        </group>
                    </group>
                    <group string="ที่อยู่ลูกค้า">
                        <group>
                            <field name="partner_street"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="partner_street2"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                        </group>
                        <group>
                            <field name="partner_city"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="partner_state_id"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="partner_zip"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                            <field name="partner_vat"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="ใบแจ้งหนี้ค้างชำระ" name="invoices">
                            <field name="customer_invoice_line_ids" nolabel="1">
                                <tree string="ใบแจ้งหนี้ค้างชำระทั้งหมด" create="0" edit="0" delete="0">
                                    <field name="invoice_name" string="เลขที่ใบแจ้งหนี้"/>
                                    <field name="invoice_origin" string="อ้างอิง SO"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total" sum="รวมทั้งหมด"/>
                                    <field name="amount_residual" sum="รวมค้างชำระ"/>
                                    <field name="days_overdue" string="จำนวนวันที่เกิน"/>
                                    <field name="payment_state_label" string="สถานะการชำระเงิน"/>
                                    <button name="action_view_invoice" type="object"
                                            string="ดูสินค้า" icon="fa-eye"
                                            class="btn-link"/>
                                    <field name="invoice_id" invisible="1"/>
                                    <field name="payment_state" invisible="1"/>
                                    <field name="product_info_html" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ค่าปรับหาย" name="penalties">
                            <field name="customer_penalty_line_ids" nolabel="1">
                                <tree string="ค่าปรับหายทั้งหมด" create="0" edit="0" delete="0">
                                    <field name="invoice_name" string="เลขเอกสาร"/>
                                    <field name="branch_name"/>
                                    <field name="sales_contact_name" string="เซลล์"/>
                                    <field name="rental_start_date" string="เริ่มเช่า"/>
                                    <field name="rental_end_date" string="วันคืน"/>
                                    <field name="penalty_amount" sum="รวมค่าปรับหาย"/>
                                    <field name="discount_amount" sum="รวมส่วนลด"/>
                                    <field name="net_penalty" sum="รวมปรับหายสุทธิ"/>
                                    <field name="amount_paid" sum="รวมรับชำระ"/>
                                    <field name="amount_residual" sum="รวมคงเหลือ"/>
                                    <button name="action_view_invoice" type="object"
                                            string="ดูสินค้า" icon="fa-eye"
                                            class="btn-link"/>
                                    <field name="invoice_id" invisible="1"/>
                                    <field name="product_info_html" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ค่าปรับชำรุด" name="damages">
                            <field name="customer_damage_line_ids" nolabel="1">
                                <tree string="ค่าปรับชำรุดทั้งหมด" create="0" edit="0" delete="0">
                                    <field name="invoice_name" string="เลขเอกสาร"/>
                                    <field name="branch_name"/>
                                    <field name="sales_contact_name" string="เซลล์"/>
                                    <field name="rental_start_date" string="เริ่มเช่า"/>
                                    <field name="rental_end_date" string="วันคืน"/>
                                    <field name="damage_amount" sum="รวมค่าปรับชำรุด"/>
                                    <field name="discount_amount" sum="รวมส่วนลด"/>
                                    <field name="net_damage" sum="รวมปรับชำรุดสุทธิ"/>
                                    <field name="amount_paid" sum="รวมรับชำระ"/>
                                    <field name="amount_residual" sum="รวมคงเหลือ"/>
                                    <button name="action_view_invoice" type="object"
                                            string="ดูสินค้า" icon="fa-eye"
                                            class="btn-link"/>
                                    <field name="invoice_id" invisible="1"/>
                                    <field name="product_info_html" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ค่า Tax" name="taxes">
                            <field name="customer_tax_line_ids" nolabel="1">
                                <tree string="ค่า Tax ทั้งหมด" create="0" edit="0" delete="0">
                                    <field name="invoice_name" string="เลขที่ใบแจ้งหนี้"/>
                                    <field name="invoice_origin" string="อ้างอิง SO"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total" string="ยอดรวมใบแจ้งหนี้"/>
                                    <field name="payment_name" string="เลขที่รับชำระ"/>
                                    <field name="tax_amount" sum="รวมยอด Tax"/>
                                    <button name="action_view_invoice" type="object"
                                            string="ดูสินค้า" icon="fa-eye"
                                            class="btn-link"/>
                                    <field name="invoice_id" invisible="1"/>
                                    <field name="payment_id" invisible="1"/>
                                    <field name="product_info_html" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ประวัติการโทร" name="call_logs">
                            <field name="call_log_ids" nolabel="1"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}">
                                <tree editable="bottom">
                                    <field name="call_date"/>
                                    <field name="phone_number"/>
                                    <field name="user_id"/>
                                    <field name="call_result"/>
                                    <field name="duration"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ประวัติการส่งเมล" name="email_logs">
                            <field name="email_log_ids" nolabel="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="send_date"/>
                                    <field name="email_from"/>
                                    <field name="email_to"/>
                                    <field name="subject"/>
                                    <field name="user_id"/>
                                    <field name="state" decoration-success="state=='sent'" 
                                           decoration-danger="state=='failed'" decoration-warning="state=='draft'" widget="badge"/>
                                    <field name="attachment_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="หมายเหตุ" name="notes">
                            <field name="note" placeholder="บันทึกหมายเหตุ..."
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancel'])]}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="npd_debt_tracking_view_search" model="ir.ui.view">
        <field name="name">npd.debt.tracking.search</field>
        <field name="model">npd.debt.tracking</field>
        <field name="arch" type="xml">
            <search string="ค้นหา">
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="partner_name"/>
                <field name="partner_phone"/>
                <field name="partner_mobile"/>
<!--                <field name="debt_type"/>-->
                <filter name="filter_today" string="วันนี้" 
                        domain="[('create_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
<!--                <filter name="filter_debt_odoo" string="ลูกหนี้ Odoo" domain="[('debt_type', '=', 'odoo')]"/>-->
<!--                <filter name="filter_debt_baankhiew" string="ลูกหนี้บ้านเขียว" domain="[('debt_type', '=', 'baankhiew')]"/>-->
                <separator/>
                <filter name="filter_draft" string="รอดำเนินการ" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress" string="กำลังติดตาม" domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_done" string="เสร็จสิ้น" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="จัดกลุ่มตาม">
<!--                    <filter name="group_debt_type" string="ประเภทลูกหนี้" context="{'group_by': 'debt_type'}"/>-->
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="ลูกค้า" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="วันที่" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_npd_debt_tracking" model="ir.actions.act_window">
        <field name="name">ติดตามหนี้</field>
        <field name="res_model">npd.debt.tracking</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างรายการติดตามหนี้ใหม่</p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_npd_debt_tracking" name="ติดตามหนี้" parent="sale.sale_menu_root"
              action="action_npd_debt_tracking" sequence="15"/>

    <!-- Call Log Tree View -->
    <record id="npd_debt_tracking_call_log_view_tree" model="ir.ui.view">
        <field name="name">npd.debt.tracking.call.log.tree</field>
        <field name="model">npd.debt.tracking.call.log</field>
        <field name="arch" type="xml">
            <tree string="ประวัติการโทร">
                <field name="call_date"/>
                <field name="sale_id"/>
                <field name="partner_name"/>
                <field name="phone_number" widget="phone"/>
                <field name="user_id"/>
                <field name="call_result"/>
                <field name="duration" string="ระยะเวลา (นาที)"/>
                <field name="amount_residual"/>
                <field name="note"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Call Log Form View - ดูประวัติ -->
    <record id="npd_debt_tracking_call_log_view_form" model="ir.ui.view">
        <field name="name">npd.debt.tracking.call.log.form</field>
        <field name="model">npd.debt.tracking.call.log</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="ประวัติการโทร" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_name" readonly="1"/></h1>
                        <h3><field name="phone_number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="tracking_id" readonly="1"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="amount_residual" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="ข้อมูลการโทร">
                            <field name="call_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="duration" readonly="1" string="ระยะเวลา (นาที)"/>
                        </group>
                    </group>
                    <group string="ผลการโทร">
                        <field name="call_result" readonly="1"/>
                    </group>
                    <group string="หมายเหตุ">
                        <field name="note" readonly="1" nolabel="1"/>
                    </group>
                    <field name="is_calling" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Call Log Form View - โทรหาลูกค้า (Popup) -->
    <record id="npd_debt_tracking_call_log_calling_form" model="ir.ui.view">
        <field name="name">npd.debt.tracking.call.log.calling.form</field>
        <field name="model">npd.debt.tracking.call.log</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="โทรหาลูกค้า">
                <field name="is_calling" invisible="1"/>
                <field name="clean_phone" invisible="1"/>
                <sheet>
                    <div class="alert alert-info text-center" role="alert" attrs="{'invisible': [('is_calling', '=', True)]}">
                        <h2>📞 โทรหาลูกค้า</h2>
                        <h3 class="mb-2"><field name="partner_name" readonly="1" nolabel="1"/></h3>
                        <h2 class="mt-3 mb-3"><field name="phone_number" readonly="1" nolabel="1"/></h2>
                        <div class="mb-3">
                            <table class="mx-auto" style="font-size: 1.1em;">
                                <tr>
                                    <td class="text-right pr-2">ยอดค้างชำระใบแจ้งหนี้:</td>
                                    <td class="text-left"><strong><field name="customer_amount_residual" readonly="1" nolabel="1"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-right pr-2">ค้างชำระค่าปรับหาย:</td>
                                    <td class="text-left"><strong><field name="customer_penalty_residual" readonly="1" nolabel="1"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-right pr-2">ค้างชำระค่าปรับชำรุด:</td>
                                    <td class="text-left"><strong><field name="customer_damage_residual" readonly="1" nolabel="1"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-right pr-2">ค้างชำระค่า Tax:</td>
                                    <td class="text-left"><strong><field name="customer_tax_residual" readonly="1" nolabel="1"/></strong></td>
                                </tr>
                            </table>
                        </div>
                        <field name="currency_id" invisible="1"/>
                    </div>
                    <div class="alert alert-warning text-center" role="alert" attrs="{'invisible': [('is_calling', '=', False)]}">
                        <h2><i class="fa fa-phone"></i> กำลังโทร...</h2>
                        <h3 class="mb-2"><field name="partner_name" readonly="1" nolabel="1" force_save="1"/></h3>
                        <h2 class="mt-3 mb-3"><field name="phone_number" readonly="1" nolabel="1" force_save="1"/></h2>
                        <div class="mb-3">
                            <table class="mx-auto" style="font-size: 1.1em;">
                                <tr>
                                    <td class="text-right pr-2">ยอดค้างชำระใบแจ้งหนี้:</td>
                                    <td class="text-left"><strong><field name="customer_amount_residual" readonly="1" nolabel="1" force_save="1"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-right pr-2">ค้างชำระค่าปรับหาย:</td>
                                    <td class="text-left"><strong><field name="customer_penalty_residual" readonly="1" nolabel="1" force_save="1"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-right pr-2">ค้างชำระค่าปรับชำรุด:</td>
                                    <td class="text-left"><strong><field name="customer_damage_residual" readonly="1" nolabel="1" force_save="1"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-right pr-2">ค้างชำระค่า Tax:</td>
                                    <td class="text-left"><strong><field name="customer_tax_residual" readonly="1" nolabel="1" force_save="1"/></strong></td>
                                </tr>
                            </table>
                        </div>
                        <div class="mt-3 p-2 bg-light rounded">
                            <span class="text-dark">
                                <i class="fa fa-clock-o"></i> <strong>เวลาเริ่มโทร:</strong> 
                                <field name="call_start_time" readonly="1" nolabel="1" force_save="1"/>
                            </span>
                        </div>
                    </div>
                    <group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="tracking_id" invisible="1"/>
                            <field name="sale_id" readonly="1"/>
                        </group>
                        <group string="ข้อมูลการโทร">
                            <field name="call_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_dial_now" type="object" string="📞 กดโทร" class="btn-success btn-lg"/>
                    <button name="action_end_call" type="object" string="📴 จบการโทร" class="btn-danger btn-lg"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Call Log Result Form (หลังจบการโทร) -->
    <record id="npd_debt_tracking_call_log_result_form" model="ir.ui.view">
        <field name="name">npd.debt.tracking.call.log.result.form</field>
        <field name="model">npd.debt.tracking.call.log</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <form string="บันทึกผลการโทร">
                <sheet>
                    <div class="alert alert-warning text-center" role="alert">
                        <h3>⚠️ กรุณาบันทึกผลการโทร</h3>
                        <p class="mb-0">กรุณาเลือก "ผลการโทร" ก่อนบันทึก (บังคับ)</p>
                    </div>
                    <group>
                        <group string="ข้อมูลการโทร">
                            <field name="tracking_id" invisible="1"/>
                            <field name="partner_name" readonly="1"/>
                            <field name="phone_number" readonly="1"/>
                            <field name="call_date" readonly="1"/>
                            <field name="call_start_time" readonly="1"/>
                            <field name="call_end_time" readonly="1"/>
                            <field name="duration" readonly="1" string="ระยะเวลา (นาที)"/>
                        </group>
                        <group string="ยอดค้างชำระ">
                            <field name="sale_id" readonly="1"/>
                            <field name="customer_amount_residual" readonly="1"/>
                            <field name="customer_penalty_residual" readonly="1"/>
                            <field name="customer_damage_residual" readonly="1"/>
                            <field name="customer_tax_residual" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="📝 ผลการโทร (บังคับ)">
                        <field name="call_result" required="1" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="📋 หมายเหตุ (ไม่บังคับ)">
                        <field name="note" placeholder="บันทึกรายละเอียดการโทร..." nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="💾 บันทึกผลการโทร" type="object" name="action_save_and_close" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Email Log Tree View -->
    <record id="npd_debt_tracking_email_log_view_tree" model="ir.ui.view">
        <field name="name">npd.debt.tracking.email.log.tree</field>
        <field name="model">npd.debt.tracking.email.log</field>
        <field name="arch" type="xml">
            <tree string="ประวัติการส่งเมล" decoration-success="state=='sent'" 
                  decoration-danger="state=='failed'" decoration-warning="state=='draft'">
                <field name="send_date"/>
                <field name="sale_id"/>
                <field name="partner_name"/>
                <field name="email_from"/>
                <field name="email_to"/>
                <field name="subject"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="attachment_count"/>
                <field name="amount_residual"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Email Log Form View -->
    <record id="npd_debt_tracking_email_log_view_form" model="ir.ui.view">
        <field name="name">npd.debt.tracking.email.log.form</field>
        <field name="model">npd.debt.tracking.email.log</field>
        <field name="arch" type="xml">
            <form string="ประวัติการส่งเมล" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="ข้อมูลอีเมล">
                            <field name="email_from" readonly="1"/>
                            <field name="email_to" readonly="1"/>
                            <field name="send_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="ข้อมูลติดตามหนี้">
                            <field name="tracking_id" readonly="1"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="partner_name" readonly="1"/>
                            <field name="amount_residual" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="เนื้อหา">
                        <field name="body" readonly="1" nolabel="1"/>
                    </group>
                    <group string="ไฟล์แนบ">
                        <field name="attachment_ids" readonly="1" nolabel="1"/>
                    </group>
                    <group string="ข้อผิดพลาด" attrs="{'invisible': [('state', '!=', 'failed')]}">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Send Email Wizard Form -->
    <record id="npd_debt_tracking_send_email_wizard_form" model="ir.ui.view">
        <field name="name">npd.debt.tracking.send.email.wizard.form</field>
        <field name="model">npd.debt.tracking.send.email.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งเมลติดตามหนี้">
                <sheet>
                    <div class="alert alert-info text-center" role="alert">
                        <h3>📧 ส่งเมลติดตามหนี้</h3>
                        <p>ส่งเมลติดตามหนี้ไปยังลูกค้า</p>
                    </div>
                    <group>
                        <group string="ข้อมูลลูกค้า">
                            <field name="tracking_id" invisible="1"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="partner_name" invisible="1"/>
                            <field name="partner_email" readonly="1"/>
                        </group>
                        <group string="ข้อมูลอีเมล">
                            <field name="email_from" required="1"/>
                            <field name="email_to" required="1"/>
                        </group>
                    </group>
                    <group string="หัวข้อ">
                        <field name="subject" required="1" nolabel="1" placeholder="หัวข้อเมล..."/>
                    </group>
                    <group string="เนื้อหา">
                        <field name="body" required="1" nolabel="1" placeholder="พิมพ์ข้อความติดตามหนี้..."/>
                    </group>
                    <group string="ไฟล์แนบ">
                        <field name="attachment_ids" nolabel="1" widget="many2many_binary"/>
                    </group>
                </sheet>
                <footer>
                    <button string="📧 ส่งเมล" type="object" name="action_send_email" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

