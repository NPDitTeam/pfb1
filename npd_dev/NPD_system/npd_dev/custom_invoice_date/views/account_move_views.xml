<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Account Move Form View -->
    <record id="view_move_form_inherit_invoice_date" model="ir.ui.view">
        <field name="name">account.move.form.inherit.invoice.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- เพิ่มฟิลด์ที่ซ่อนไว้สำหรับใช้ในการคำนวณ -->
            <xpath expr="//sheet" position="before">
                <field name="can_edit_invoice_date" invisible="1"/>
                <field name="is_from_reservation" invisible="1"/>
            </xpath>

            <!-- แสดงข้อความเตือนด้านบนของฟอร์ม -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning text-center"
                     attrs="{'invisible': ['|', ('is_from_reservation', '=', False), ('invoice_date', '!=', False)]}"
                     style="margin: 10px;">
                    <strong>⚠️ คำเตือน:</strong> เอกสารนี้มาจากใบเสนอราคาแบบจอง ส่วนกลางต้องระบุวันที่ Invoice ก่อนจึงจะสามารถยืนยันเอกสารได้
                </div>
            </xpath>

            <!-- ปรับปรุงฟิลด์ invoice_date -->
            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="attrs">{'readonly': ['&amp;', ('can_edit_invoice_date', '=', False), ('invoice_origin', '!=', False)], 'required': [('is_from_reservation', '=', True)]}</attribute>
            </xpath>

            <!-- แสดงสถานะใบเสนอราคาแบบจอง (แบบ readonly เสมอ ไม่ให้แก้ไข) -->
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="is_from_reservation"
                       string="มาจากใบเสนอราคาแบบจอง"
                       readonly="1"
                       force_save="1"
                       attrs="{'invisible': [('is_from_reservation', '=', False)]}"
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Account Move Tree View -->
    <record id="view_invoice_tree_inherit_reservation" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.reservation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_signed']" position="after">
                <field name="is_from_reservation" optional="show" string="จากใบจอง" widget="boolean"/>
            </xpath>
        </field>
    </record>
</odoo>