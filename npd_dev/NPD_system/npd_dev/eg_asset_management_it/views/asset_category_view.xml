<odoo>
    <record id="asset_category_tree_view" model="ir.ui.view">
        <field name="name">ประเภททรัพย์สิน</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">ประเภททรัพย์สิน</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="main_menu_assets" name="ทรัพย์สิน IT" />

<!--    <menuitem id="main_menu_assets" name="Asset IT" web_icon="eg_asset_management,static/description/oi_account_asset.png"/>-->
    <menuitem id="menu_asset_configuration" name="การตั้งค่า" parent="main_menu_assets" sequence="2"/>
    <menuitem id="menu_asset_category" action="action_asset_category" parent="menu_asset_configuration"/>
</odoo>