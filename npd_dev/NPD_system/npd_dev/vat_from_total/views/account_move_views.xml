<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vat_method" model="ir.ui.view">
        <field name="name">account.move.form.vat.method</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="partner_bank_id" position="after">
                <field
                    name="vat_calculation_method"
                    attrs="{'invisible': [('move_type', 'not in', ['out_invoice','out_refund','in_invoice','in_refund'])]}"
                />
            </field>
        </field>
    </record>
</odoo>
