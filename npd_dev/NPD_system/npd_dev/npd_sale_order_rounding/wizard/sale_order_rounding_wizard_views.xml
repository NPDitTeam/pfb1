<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_rounding_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.rounding.wizard.form</field>
        <field name="model">sale.order.rounding.wizard</field>
        <field name="arch" type="xml">
            <form string="ปัดเศษยอดรวม">
                <field name="order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="current_total"/>
                        <field name="preview_total"/>
                    </group>
                    <group>
                        <field name="method"/>
                        <field name="step_preset"/>
                        <field name="custom_step"
                               attrs="{'invisible': [('step_preset', '!=', 'custom')],
                                       'required': [('step_preset', '=', 'custom')]}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="ปัดเศษ" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
