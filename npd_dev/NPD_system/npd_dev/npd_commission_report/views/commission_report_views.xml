<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Form View - Wizard -->
        <record id="view_npd_commission_report_form" model="ir.ui.view">
            <field name="name">npd.commission.report.form</field>
            <field name="model">npd.commission.report</field>
            <field name="arch" type="xml">
                <form string="รายงานค่าคอมมิชชั่น">
                    <group>
                        <group>
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="branch_id" placeholder="เว้นว่างเพื่อแสดงทุกสาขา"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate_report" string="ดูรายงาน" type="object" class="btn-primary"/>
                        <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_npd_commission_report_line_tree" model="ir.ui.view">
            <field name="name">npd.commission.report.line.tree</field>
            <field name="model">npd.commission.report.line</field>
            <field name="arch" type="xml">
                <tree string="รายงานค่าคอมมิชชั่น" create="false" edit="false">
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="branch_id"/>
                    <field name="rental_amount" sum="รวมยอดเช่า"/>
                    <field name="payment_received" sum="รวมรับชำระหนี้"/>
                    <field name="outstanding_debt" sum="รวมหนี้ค้างชำระ"/>
                    <field name="total_expense" sum="รวมรายจ่าย"/>
                    <field name="net_rental" sum="รวมยอดเช่าสุทธิ"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_npd_commission_report_line_search" model="ir.ui.view">
            <field name="name">npd.commission.report.line.search</field>
            <field name="model">npd.commission.report.line</field>
            <field name="arch" type="xml">
                <search string="ค้นหา">
                    <field name="branch_id"/>
                    <group expand="0" string="จัดกลุ่มตาม">
                        <filter string="สาขา" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_npd_commission_report" model="ir.actions.act_window">
            <field name="name">รายงานค่าคอมสาขา</field>
            <field name="res_model">npd.commission.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_npd_commission_report"
                  name="รายงานค่าคอมสาขา"
                  action="action_npd_commission_report"
                  parent="account.menu_finance_reports"
                  sequence="999"/>

    </data>
</odoo>
