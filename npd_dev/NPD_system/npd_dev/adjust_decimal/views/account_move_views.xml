<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_adjust_decimal" model="ir.ui.view">
        <field name="name">account.move.form.inherit.adjust.decimal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_decimal_adjustment"
                        string="แก้ไขทศนิยม"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
