<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="sh_overtime_config_weekday_tree" model="ir.ui.view">
        <field name="name">sh.overtime.config.weekday.view.tree</field>
        <field name="model">sh.overtime.config.weekday</field>
        <field name="arch" type="xml">
            <tree editable = "bottom">
                <field name = "from_hour"/>
                <field name = "to_hour"/>
                <field name = "hours_rate_multiplication"/>
            </tree>
        </field>
    </record>

    <record id="sh_overtime_config_weekday_action" model="ir.actions.act_window">
        <field name="name">Overtime Config Weekday</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.overtime.config.weekday</field>
        <field name="view_mode">tree</field>
    </record>
    
</odoo>