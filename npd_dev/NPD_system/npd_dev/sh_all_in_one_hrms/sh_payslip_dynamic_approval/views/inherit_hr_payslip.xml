<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_payslip_inherit_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.inherit.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="sh_hr_payroll.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_boolean" invisible="1"/>
                <field name="approval_level_id" groups="sh_all_in_one_hrms.group_enable_sh_payslip_dynamic_approval" />
                <field name="user_id" invisible="1" />
                <field name="net_amount" invisible="1" />
            </field>

            <xpath expr="//header" position="inside">
                <button
                    class="oe_highlight"
                    groups="sh_all_in_one_hrms.group_enable_sh_payslip_dynamic_approval"
                    string="Approve"
                    type="object"
                    name="action_approve_payslip"
                    attrs="{'invisible':['|',('state','not in',['waiting_for_approval']),('is_boolean','=',False)]}"
                />
                <button
                    string="Reject"
                    groups="sh_all_in_one_hrms.group_enable_sh_payslip_dynamic_approval"
                    type="action"
                    name="%(sh_all_in_one_hrms.sh_rejection_reason_action)d"
                    attrs="{'invisible':['|',('state','not in',['waiting_for_approval']),('is_boolean','=',False)]}"
                />
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Approval Info" name="approval_info" groups="sh_all_in_one_hrms.group_enable_sh_payslip_dynamic_approval">
                    <group>
                        <group string="Next Approval">
                            <field name="level" />
                            <field name="user_ids" widget="many2many_tags" />
                            <field name="group_ids" widget="many2many_tags" />
                        </group>

                        <group string="Reject Payslip Report Info">
                            <field name="rejection_date" />
                            <field name="reject_by" />
                            <field name="reject_reason" />
                        </group>

                        <field name="approval_info_line" nolabel="1" context="{'form_view_ref': 'sh_all_in_one_hrms.sh_approval_info_view_form'}">
                            <tree>
                                <field name="level" />
                                <field name="user_ids" widget="many2many_tags" />
                                <field name="group_ids" widget="many2many_tags" />
                                <field name="status" widget="boolean_toggle" readonly="1" />
                                <field name="approval_date" />
                                <field name="approved_by" />
                                <field name="hr_payslip_id" invisible="1" />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sh_hr_payslip_my_approval_action" model="ir.actions.act_window">
        <field name="name">My Approval</field>
        <field name="res_model">hr.payslip</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_id" ref="sh_hr_payroll.view_hr_payslip_tree" />
        <field name="domain">[('is_boolean','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

    <menuitem id="employee_payslips_main_menu" name="Employee Payslips" parent="sh_hr_payroll.menu_hr_payroll_root" sequence="1" />

    <menuitem action="sh_hr_payroll.action_view_hr_payslip_form" id="sh_hr_payroll.menu_department_tree" parent="employee_payslips_main_menu" groups="sh_hr_payroll.group_hr_payroll_user" sequence="1" />

    <menuitem id="sh_hr_payslip_my_approval_action_menu" name="My Approval" groups="sh_all_in_one_hrms.group_enable_sh_payslip_dynamic_approval" action="sh_hr_payslip_my_approval_action" parent="employee_payslips_main_menu" sequence="2" />
</odoo>
