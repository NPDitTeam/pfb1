<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_overtime" model="ir.module.category">
        <field name="name">Overtime</field>
        <field name="description">Helps you manage the Employee Overtime</field>
        <field name="sequence">5</field>
    </record>

    <record model="ir.rule" id="sh_hr_overtime_comp_rule">
        <field name="name">Hr Overtime multi-company</field>
        <field name="model_id" ref="model_sh_hr_overtime" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="sh_ot_type_comp_rule">
        <field name="name">OT Type multi-company</field>
        <field name="model_id" ref="model_sh_ot_types" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="group_overtime_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="sh_all_in_one_hrms.module_category_hr_overtime" />
    </record>

    <record id="group_overtime_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="sh_all_in_one_hrms.module_category_hr_overtime" />
        <field name="implied_ids" eval="[(4, ref('sh_all_in_one_hrms.group_overtime_user'))]" />
    </record>

    <record id="ir_rule_hr_overtime_employee_user" model="ir.rule">
        <field name="name">Employee Overtime User</field>
        <field name="model_id" ref="model_sh_hr_overtime" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sh_all_in_one_hrms.group_overtime_user'))]" />
    </record>

    <record id="ir_rule_hr_overtime_employee_manager" model="ir.rule">
        <field name="name">Employee Overtime Manager can see own employees overtime</field>
        <field name="model_id" ref="model_sh_hr_overtime" />
        <field name="domain_force">['|',('employee_id.user_id', '=', user.id),('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sh_all_in_one_hrms.group_overtime_manager'))]" />
    </record>

    <record id="ir_rule_hr_overtime_employee_admin" model="ir.rule">
        <field name="name">Admin can see all records</field>
        <field name="model_id" ref="model_sh_hr_overtime" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
