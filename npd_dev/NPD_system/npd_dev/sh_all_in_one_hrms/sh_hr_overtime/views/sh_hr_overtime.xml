<?xml version="1.0"?>
<odoo>
    <!--Sh Hr Overtime Object views and action -->
    <record id="sh_hr_overtime_form_view" model="ir.ui.view">
        <field name="name">sh.hr.overtime.form</field>
        <field name="model">sh.hr.overtime</field>
        <field name="arch" type="xml">
            <form string="Overtime">
                <header>
                    <button name="confirm_button" type="object" states="new" string="Confirm" class="oe_highlight" />
                    <button name="approve_button" string="Approve" type="object" class="oe_highlight" groups="sh_all_in_one_hrms.group_overtime_manager" attrs="{'invisible':['|',('is_approve','=',True),('state','!=', 'request')]}" />
                    <button name="reject_button" string="Reject" type="object" class="oe_highlight" groups="sh_all_in_one_hrms.group_overtime_manager" attrs="{'invisible':['|',('is_approve','=',True),('state','!=', 'request')]}" />
                    <field name="state" widget="statusbar" statusbar_visible="new,request,approve,reject" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1" />
                            <field name="from_hrs" required="True" attrs="{'readonly':[('state','!=','new')]}" />
                            <field name="to_hrs" required="True" attrs="{'readonly':[('state','!=','new')]}" />
                            <field name="total_hours" readonly="1" widget="float_time" attrs="{'readonly':[('state','!=','new')]}" />
                            <field name="ot_type_id" required="True" attrs="{'readonly':[('state','!=','new')]}" options="{'no_create': True, 'no_open':True,'no_create_edit':True}" />
                            <field name="is_approve" invisible="1" />
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" attrs="{'readonly':[('state','!=','new')]}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Reject Comment" name="reject_page" attrs="{'invisible':[('state','not in',['reject'])]}">
                            <group>
                                <group>
                                    <field name="reject_comment" readonly="1" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="o_attachment_preview" />
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="sh_hr_overtime_tree_view" model="ir.ui.view">
        <field name="name">sh.hr.overtime.tree</field>
        <field name="model">sh.hr.overtime</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="employee_id" groups="sh_all_in_one_hrms.group_overtime_manager" />
                <field name="from_hrs" />
                <field name="to_hrs" />
                <field name="total_hours" widget="float_time" />
                <field name="ot_type_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="sh_hr_overtime_search_views" model="ir.ui.view">
        <field name="name">sh.hr.overtime.search</field>
        <field name="model">sh.hr.overtime</field>
        <field name="arch" type="xml">
            <search string="Overtime">
                <field name="name" />
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'request')]" />
                <filter string="Approved " name="approved_ot" domain="[('state','=','approve')]" />
                <filter string="Rejected " name="rejected_ot" domain="[('state','=','reject')]" />
                <separator />
                <group expand="0" string="Group by...">
                    <filter string="Employee" name="employee_id" context="{'group_by': 'employee_id'}" />
                    <filter string="From Hours" name="from_hrs" context="{'group_by': 'from_hrs'}" />
                    <filter string="To Hours" name="to_hrs" context="{'group_by': 'to_hrs'}" />
                    <filter string="Ot Type" name="ot_type_id" context="{'group_by': 'ot_type_id'}" />
                    <filter string="State" name="state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="sh_hr_overtime_request_view_actions" model="ir.actions.act_window">
        <field name="name">Overtime Request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.hr.overtime</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('employee_id.user_id','=',uid)]</field>
    </record>

    <record id="sh_hr_overtime_approve_view_actions" model="ir.actions.act_window">
        <field name="name">Overtime Approve</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.hr.overtime</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_to_approve':1}</field>
    </record>
</odoo>
