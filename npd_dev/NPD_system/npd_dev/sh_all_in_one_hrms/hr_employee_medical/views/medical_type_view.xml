<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_type_form_view" model="ir.ui.view">
        <field name="name">medical.type.form.view</field>
        <field name="model">sh.medical.type</field>
        <field name="arch" type="xml">
            <form string="Medical Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="medical_type_tree_view" model="ir.ui.view">
        <field name="name">medical.type.form.view</field>
        <field name="model">sh.medical.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="action_medical_type" model="ir.actions.act_window">
        <field name="name">Medical Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.medical.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_medical_type" groups="sh_all_in_one_hrms.group_hide_menu_emp_medical" name="Medical Type" parent="hr.menu_human_resources_configuration" action="action_medical_type"/>
</odoo>
