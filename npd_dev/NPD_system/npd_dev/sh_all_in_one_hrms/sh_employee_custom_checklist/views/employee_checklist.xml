<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_hr_employee_custom_checklist_tree_view_inherit" model="ir.ui.view">
        <field name="name">hr.employee.custom.checklist.tree</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree" />
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="entry_custom_checklist" widget="progressbar" string="Entry Checklist" groups="sh_all_in_one_hrms.group_enable_custom_check_list"/>
                <field name="exit_custom_checklist" widget="progressbar" string="Exit Checklist" groups="sh_all_in_one_hrms.group_enable_custom_check_list"/>
            </field>
        </field>
    </record>

    <record id="sh_hr_employee_custom_checklist_kanban_view_inherit" model="ir.ui.view">
        <field name="name">hr.employee.custom.checklist.kanban</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_kanban_details')]" position="inside">
                <div groups="sh_all_in_one_hrms.group_enable_custom_check_list">
                    <field name="entry_custom_checklist" string="Entry" widget="percentpie" style="background: Blue;" />
                    <field name="exit_custom_checklist" string="Exit" widget="percentpie" style="background: Blue;" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="sh_employee_entry_custom_checklist_form_view" model="ir.ui.view">
        <field name="name">employee.entry.custom.checklist.form</field>
        <field name="model">employee.entry.custom.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" invisible="1" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sh_employee_entry_custom_checklist_tree_view" model="ir.ui.view">
        <field name="name">employee.entry.custom.checklist.tree</field>
        <field name="model">employee.entry.custom.checklist</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="sh_entry_custom_checklist_search_view" model="ir.ui.view">
        <field name="name">employee.entry.custom.checklist.view.search</field>
        <field name="model">employee.entry.custom.checklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_menu_employee_entry_custom_checklist">
        <field name="name">Employee Entry Custom Checklist</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.entry.custom.checklist</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="sh_employee_exit_custom_checklist_form_view" model="ir.ui.view">
        <field name="name">employee.exit.custom.checklist.form</field>
        <field name="model">employee.exit.custom.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" invisible="1" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sh_employee_exit_custom_checklist_tree_view" model="ir.ui.view">
        <field name="name">employee.exit.custom.checklist.tree</field>
        <field name="model">employee.exit.custom.checklist</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="sh_exit_custom_checklist_search_view" model="ir.ui.view">
        <field name="name">employee.exit.custom.checklist.view.search</field>
        <field name="model">employee.exit.custom.checklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_menu_employee_exit_custom_checklist">
        <field name="name">Employee Exit Custom Checklist</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.exit.custom.checklist</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_employee_entry_custom_checklist" sequence="25" groups="sh_all_in_one_hrms.group_enable_custom_check_list" name="Employee Entry Custom Checklist" action="action_menu_employee_entry_custom_checklist" parent="hr.menu_human_resources_configuration" />
    <menuitem id="menu_employee_exit_custom_checklist" sequence="26" groups="sh_all_in_one_hrms.group_enable_custom_check_list" name="Employee Exit Custom Checklist" action="action_menu_employee_exit_custom_checklist" parent="hr.menu_human_resources_configuration" />
    
    <menuitem id="menu_import_employee_entry_custom_checklist" groups="sh_all_in_one_hrms.group_enable_custom_check_list" sequence="27" name="Import Employee Entry Custom Checklist" action="sh_all_in_one_hrms.sh_import_entry_custom_cl_action" parent="hr.menu_human_resources_configuration" />
    <menuitem id="menu_import_employee_exit_custom_checklist" groups="sh_all_in_one_hrms.group_enable_custom_check_list" sequence="28" name="Import Employee Exit Custom Checklist" action="sh_all_in_one_hrms.sh_import_exit_custom_cl_action" parent="hr.menu_human_resources_configuration" />

    <record id="sh_hr_employee_custom_checklist_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.employee.custom.checklist.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="entry_custom_checklist" string="Entry Checklist" groups="sh_all_in_one_hrms.group_enable_custom_check_list">
                    <button name="%(action_menu_employee_entry_custom_checklist)d" type="action" class="oe_stat_button" style="height: 40px; background: White;">
                        <field name="entry_custom_checklist" string="Checklist Completed" widget="percentpie" style="height: 30px; background: White;" />
                    </button>
                    <span style="padding-left:50px;">Entry Checklist Template </span>
                    <field name="custom_checklist_entry_template_ids" widget="many2many_tags" />
                    <field name="entry_custom_checklist_ids">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="description" />
                            <field name="updated_date" />
                            <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-danger="state=='cancelled'" decoration-mute="state == 'new'" />
                            <button string="Complete" name="btn_check" type="object" icon="fa-check" attrs="{'invisible':[('state','=','completed')]}" />
                            <button string="Cancel" name="btn_close" type="object" icon="fa-close" attrs="{'invisible':[('state','=','cancelled')]}" />
                        </tree>
                    </field>
                </page>
                <page name="exit_custom_checklist" string="Exit Checklist" groups="sh_all_in_one_hrms.group_enable_custom_check_list">
                    <button name="%(action_menu_employee_exit_custom_checklist)d" type="action" class="oe_stat_button" style="height: 40px; background: White;">
                        <field name="exit_custom_checklist" string="Checklist Completed" widget="percentpie" style="height: 30px; background: White;" />
                    </button>
                    <span style="padding-left:50px;">Exit Checklist Template </span>
                    <field name="custom_checklist_exit_template_ids" widget="many2many_tags" />
                    <field name="exit_custom_checklist_ids">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="description" />
                            <field name="updated_date" />
                            <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-danger="state=='cancelled'" decoration-mute="state == 'new'" />
                            <button string="Complete" name="btn_check" type="object" icon="fa-check" attrs="{'invisible':[('state','=','completed')]}" />
                            <button string="Cancel" name="btn_close" type="object" icon="fa-close" attrs="{'invisible':[('state','=','cancelled')]}" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
