<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Department Policy Wizard and action -->
    <record id="sh_department_policy_wizard_form_view" model="ir.ui.view">
        <field name="name">sh.department.policy.wizard.form</field>
        <field name="model">sh.department.policy.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="department_id" invisible="1" />
                <field name="sh_policy" widget="html" />
                <footer />
            </form>
        </field>
    </record>
    <record id="sh_department_policy_wizard_actions" model="ir.actions.act_window">
        <field name="name">Department Policy</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.department.policy.wizard</field>
        <field name="view_mode">form</field>
    </record>
</odoo>