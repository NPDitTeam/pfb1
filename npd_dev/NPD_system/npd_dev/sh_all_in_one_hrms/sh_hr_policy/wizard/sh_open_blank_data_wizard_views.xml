<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Blank Data Policy Wizard and action -->
    <record id="sh_no_data_policy_wizard_form_view" model="ir.ui.view">
        <field name="name">sh.blank.data.wizard.form</field>
        <field name="model">sh.blank.data.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_title">
                    <h1>
                        There is no data to Display
                    </h1>
                </div>
                <footer />
            </form>
        </field>
    </record>
    <record id="sh_no_data_policy_wizard_actions" model="ir.actions.act_window">
        <field name="name">Blank Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.blank.data.wizard</field>
        <field name="view_mode">form</field>
    </record>
</odoo>