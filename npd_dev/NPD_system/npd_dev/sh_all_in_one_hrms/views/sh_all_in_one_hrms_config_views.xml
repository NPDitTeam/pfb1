                            <field name="group_hide_menu_emp_medical" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_hide_menu_emp_medical" />
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="group_hide_menu_emp_passport" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_hide_menu_emp_passport" />
