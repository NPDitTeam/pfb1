<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 	New Resignation notification for responsible person -->
    <record id="send_new_resignation_notification_responsible_user" model="mail.template">
        <field name="name">New Resignation Notification To Responsible Persons </field>
        <field name="model_id" ref="model_sh_hr_resignation" />
        <field name="partner_to"></field>
        <field name="subject">${object.created_by.name} - Resignation ${object.name}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;"> Hello There, <br />
                <br /> Resignation <b> </b>
                - <b>
                    <t t-out="object.name or ''" />
                </b> submitted by <b>
                    <t t-out="object.created_by.partner_id.name or ''" />
                </b> . <br />
                <div
                    style="display: inline-block; margin: 15px 0px; text-align: center;">
                    <a href="/mail/view?model=sh.hr.resignation&amp;res_id=${object.id}"
                        target="_blank"
                        style="padding: 5px 10px; color: #ffffff; text-decoration: none; background-color: #875a7b; border: 1px solid #875a7b; border-radius: 3px;">
                Click here to view
                    </a>
                </div>
                <br />
                Thank you. </div>
        </field>
        <field name="lang">${object.created_by.partner_id.lang}</field>
        <field name="auto_delete" eval="True" />
    </record>
    <!-- 	Resignation Approved notification for resignation created user	 -->
    <record id="send_resignation_approved_notification_created_user" model="mail.template">
        <field name="name">Resignation Approved Notification to Created User </field>
        <field name="model_id" ref="model_sh_hr_resignation" />
        <field name="partner_to">${object.created_by.partner_id.id}</field>
        <field name="subject">${object.created_by.name} -Resignation ${object.name} - Approved</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;"> Hello There, <br />
                <br /> Your Resignation <b> </b>
                - <b>
                    <t t-out="object.name or ''" />
                </b> Approved by <b>
                    <t t-out="object.approved_by.name or ''" />
                </b> Successfully. <br />
                <div
                    style="display: inline-block; margin: 15px 0px; text-align: center;">
                    <a
                        href="/mail/view?model=sh.hr.resignation&amp;res_id=${object.id}"
                        target="_blank"
                        style="padding: 5px 10px; color: #ffffff; text-decoration: none; background-color: #875a7b; border: 1px solid #875a7b; border-radius: 3px;"
                    >
                Click here to view
                    </a>
                </div>
                <br />
                Thank you. </div>
        </field>
        <field name="lang">${object.created_by.partner_id.lang}</field>
        <field name="auto_delete" eval="True" />
    </record>
    <!-- Resignation Refused notification for resignation created user	 -->
    <record id="send_resignation_refused_notification_created_user" model="mail.template">
        <field name="name">Resignation Refused Notification to Created User </field>
        <field name="model_id" ref="model_sh_hr_resignation" />
        <field name="partner_to">${object.created_by.partner_id.id}</field>
        <field name="subject">${object.created_by.name} -Resignation ${object.name} - Refused</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;"> Hello There, <br />
                <br /> Your Resignation <b> </b>
                - <b>
                    <t t-out="object.name or ''" />
                </b> Refused by <b>
                    <t t-out="object.refused_by.name or ''" />
                </b> . <br />
                <div
                    style="display: inline-block; margin: 15px 0px; text-align: center;">
                    <a
                        href="/mail/view?model=sh.hr.resignation&amp;res_id=${object.id}"
                        target="_blank"
                        style="padding: 5px 10px; color: #ffffff; text-decoration: none; background-color: #875a7b; border: 1px solid #875a7b; border-radius: 3px;"
                    >
                Click here to view
                    </a>
                </div>
                <br />
                Thank you. </div>
        </field>
        <field name="lang">${object.created_by.partner_id.lang}</field>
        <field name="auto_delete" eval="True" />
    </record>
</odoo>