<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rule for assigned user -->
    <record model="ir.rule" id="resignation_user_see_assigned">
        <field name="name">Resignation
            Responsible Persons</field>
        <field name="model_id" ref="model_sh_hr_resignation" />
        <field name="domain_force">['|',('sh_employee_id.user_id', '=', user.id),
            ('sh_responsible_person', '=', user.id)]</field>
        <field name="groups"
            eval="[(4,
        ref('base.group_user'))]" />
    </record>

    <record model="ir.rule" id="emp_resignation_comp_rule">
        <field name="name">Resignation
            multi-company</field>
        <field name="model_id" ref="model_sh_hr_resignation" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in',
            company_ids)]</field>
    </record>
    <record id="sh_all_resignation_rule_manager" model="ir.rule">
        <field name="name">All Resignation</field>
        <field name="model_id" ref="model_sh_hr_resignation" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups"
            eval="[(4, ref('hr_contract.group_hr_contract_manager'))]" />
    </record>

    <record id="group_enable_emp_hr_resignation" model="res.groups">
        <field name="name">Enable Employee Resignation</field>
    </record>
</odoo>