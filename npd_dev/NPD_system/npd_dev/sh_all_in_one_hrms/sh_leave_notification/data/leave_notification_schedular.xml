<?xml version ="1.0" encoding="utf-8" ?>

<odoo>
    <data noupdate="1">
        <record id="leave_notification_generator" model="ir.cron">
            <field name="name">Leave: Generate Employee Leave Notification</field>
            <field name="model_id" ref="model_hr_leave" />
            <field name="state">code</field>
            <field name="code">model.scheduler_leave_notification()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=5, minute=30) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="numbercall">-1</field>
            <field eval="False" name="doall" />
        </record>
    </data>
</odoo>
