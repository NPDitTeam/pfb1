							<tr>
								<th align="center">Employee Name</th>
								<th align="center">Department</th>
								<th align="center">Description</th>
								<th align="center">Type</th>
								<th align="center">From</th>
								<th align="center">To</th>
								<th align="center">Days</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td><span style="margin-left:5px">${object.employee_id.name}</span></td>
								<td><span style="margin-left:5px">${object.department_id.name}</span></td>
								% if object.name :
								<td><span style="margin-left:5px">${object.name}</span></td>
								% else:
								<td><span style="margin-left:5px"></span></td>
								% endif
								<td><span style="margin-left:5px">${object.holiday_status_id.name}</span></td>
								<td><span style="margin-left:5px">${object.date_from}</span></td>
								<td><span style="margin-left:5px">${object.date_to}</span></td>
								<td><span style="margin-left:5px">${object.number_of_days_display}</span></td>
							</tr>
						</tbody>
					</table>

				</html>	
			<br/>
			
			<p>Thank You</p> 
			]]>
        </field>
    </record>

    <record id="sh_template_hr_manager_leave_respond_email" model="mail.template">
