        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field name="body_html">
            <![CDATA[ 
            <br/>
           	<br/>
            <p>Dear ${object.employee_id.name},</p>
            <p>
            	${object.employee_id.parent_id.name} have 
            	% if object.state =='validate':
            		approved 
            	% endif
				% if object.state =='refuse': 
