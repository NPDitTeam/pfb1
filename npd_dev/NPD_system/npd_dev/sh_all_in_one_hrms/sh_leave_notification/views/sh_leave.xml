<?xml version="1.0"?>
<odoo>
    <!--Sh Idea Object views and action -->
    <record id="sh_leave_summary_form_view" model="ir.ui.view">
        <field name="name">sh.leave.summary.form</field>
        <field name="model">sh.leave.summary</field>
        <field name="arch" type="xml">
            <form string="Idea">
                <sheet>
                    <group>
                        <group>
                            <field name="leave_ids" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="employee_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
