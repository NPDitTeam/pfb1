<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sh_employee_promotion_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="row">
                            <div class="col-12">
                                <h4>
                                    <center><span t-field="o.name" /></center>
                                </h4>
                            </div>
                        </div>
                        <br />
                        <br />
                        <div class="row">
                            <div class="col-5" />
                            <div class="col-7 text-right">
                                <strong>Promotion Date: </strong>
                                <span t-field="o.sh_promotion_date" t-options='{"format": "dd-MM-YYYY"}' />
                            </div>
                        </div>

                        <br />
                        <br />
                        <div class="row">
                            <div class="col-7 text-left">
                                <strong>Promotion Details</strong>
                            </div>
                            <div class="col-5" />
                        </div>
                        <br />
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Employee</th>
                                    <th class="text-right">Previous Designation</th>
                                    <th class="text-right">Previous Salary</th>
                                    <th class="text-right">New Designation</th>
                                    <th class="text-right">New Salary</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span t-field="o.employee_id" />
                                    </td>

                                    <td class="text-right">
                                        <span t-field="o.sh_previous_designation" />
                                    </td>

                                    <td class="text-right">
                                        <span t-field="o.sh_previous_salary" />
                                    </td>

                                    <td class="text-right">
                                        <span t-field="o.sh_new_designation" />
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.sh_new_salary" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-7 text-left">
                                <strong>Promotion Descriptions</strong>
                            </div>
                            <div class="col-5" />
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-12">
                                <span t-field="o.sh_description" />
                            </div>
                        </div>
                        <br />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_employee_promotion_receipt" model="ir.actions.report">
        <field name="name">Employee Report</field>
        <field name="model">sh.hr.promotion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sh_all_in_one_hrms.sh_employee_promotion_report</field>
        <field name="report_file">sh_all_in_one_hrms.sh_employee_promotion_report</field>
        <field name="binding_model_id" ref="model_sh_hr_promotion" />
        <field name="binding_type">report</field>
    </record>
</odoo>
