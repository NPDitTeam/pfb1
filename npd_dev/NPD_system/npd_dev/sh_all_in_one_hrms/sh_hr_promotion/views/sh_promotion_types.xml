<?xml version="1.0"?>
<odoo>
    <!-- Promotion Types views and action -->
    <record id="sh_promotion_type_form_view" model="ir.ui.view">
        <field name="name">sh.promotion.types.form</field>
        <field name="model">sh.promotion.types</field>
        <field name="arch" type="xml">
            <form string="Promotion Types">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_promotion_type_tree_view" model="ir.ui.view">
        <field name="name">sh.promotion.types.tree</field>
        <field name="model">sh.promotion.types</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Promotion Types" />
            </tree>
        </field>
    </record>

    <record id="sh_promotion_type_search_view" model="ir.ui.view">
        <field name="name">sh.promotion.types.search</field>
        <field name="model">sh.promotion.types</field>
        <field name="arch" type="xml">
            <search string="Promotion Types">
                <field name="name" />
                <group expand="0" string="Group by...">
                    <filter string="Promotion Types" name="name" context="{'group_by': 'name'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="sh_promotion_type_view_actions" model="ir.actions.act_window">
        <field name="name">Promotion Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.promotion.types</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="sh_hr_promotion_menu"
        groups="sh_all_in_one_hrms.group_enable_emp_hr_promotion"
        name="Employee Promotion"
        parent="hr.menu_human_resources_configuration"
        action="sh_all_in_one_hrms.sh_hr_promotion_request_view_actions"
        sequence="100"
    />
</odoo>
