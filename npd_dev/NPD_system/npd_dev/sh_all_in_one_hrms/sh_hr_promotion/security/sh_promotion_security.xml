<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="sh_hr_promotion_comp_rule">
        <field name="name">Hr Promotion multi-company</field>
        <field name="model_id" ref="model_sh_hr_promotion" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="sh_promotion_types_comp_rule">
        <field name="name">OT Type multi-company</field>
        <field name="model_id" ref="model_sh_promotion_types" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ir_rule_model_sh_hr_promotion_employee_user" model="ir.rule">
        <field name="name">Employee Promotion User</field>
        <field name="model_id" ref="model_sh_hr_promotion" />
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
    </record>

    <record id="ir_rule_hr_promotion_employee_admin" model="ir.rule">
        <field name="name">Admin can see all records</field>
        <field name="model_id" ref="model_sh_hr_promotion" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
    
    <record id="group_enable_emp_hr_promotion" model="res.groups">
        <field name="name">Enable Employee Promotion</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>
</odoo>
