#. module: sh_all_in_one_hrms
#: model:mail.template,body_html:sh_all_in_one_hrms.email_template_for_confirm_hr_payslip
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <h2>\n"
"                            <b>Payslip Confirmed: ${object.name}</b>\n"
"                        </h2>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Dear User!!,\n"
"                        <br/>\n"
"                        <br/>\n"
"                        This is inform you that your payslip is confirmed.<br/>\n"
"                        You can use the following link to access the payslip.<br/><br/>\n"
"                        <div style=\"display: inline-block; margin: 15px; text-align: center\">\n"
"                            <a href=\"/mail/view?model=hr.payslip&amp;res_id=${object.id}\" target=\"_blank\" style=\"padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">Payslip Ref: #${object.number}</a>\n"
"                        </div><br/>\n"
"                        Thanks.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sh_all_in_one_hrms
#: model:mail.template,body_html:sh_all_in_one_hrms.email_template_for_reject_hr_payslip
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <h2>\n"
"                            <b>Payslip Rejected: ${object.name}</b>\n"
"                        </h2>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Dear User!!,\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Rejected Payslip Information.<br/>\n"
"                        <table class=\"table table-bordered\">\n"
"                            <thead>\n"
"                                <tr>\n"
"                                    <th scope=\"col\">Date</th>\n"
"                                    <th scope=\"col\">Reject By</th>\n"
"                                    <th scope=\"col\">Reason</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            <tbody>\n"
"                                <td>${object.rejection_date}</td>\n"
"                                <td>${object.reject_by.name}</td>\n"
"                                <td>${object.reject_reason}</td>\n"
"                            </tbody>\n"
"                        </table><br/><br/>\n"
"                        You can use the following link to access the Payslip.<br/><br/>\n"
"                        <div style=\"display: inline-block; margin: 15px; text-align: center\">\n"
"                            <a href=\"/mail/view?model=hr.payslip&amp;res_id=${object.id}\" target=\"_blank\" style=\"padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">Payslip Ref: #${object.number}</a>\n"
"                        </div><br/>\n"
"                        Thanks.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sh_all_in_one_hrms
#: model:mail.template,body_html:sh_all_in_one_hrms.email_template_for_approve_hr_payslip
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <h2>\n"
"                            <b>Submit for Approval: ${object.name}</b>\n"
"                        </h2>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <p>\n"
"                            Dear Approver,\n"
"                            <br/>\n"
"                            <br/>\n"
"                            This is inform you that payslip is submitted for approval.\n"
"                            <br/>\n"
"                            <b>User:</b>\n"
"                            ${object.user_id.name}\n"
"                            <br/>\n"
"                            <b>Total Payslip Amount:</b>\n"
"                            ${format_amount(object.net_amount, object.contract_id.currency_id)}\n"
"                            <br/>\n"
"                            <b>Approval Level:</b>\n"
"                            ${object.approval_level_id.name}\n"
"                            <br/>\n"
"                            <b>Minimum Amount:</b>\n"
"                            ${format_amount(object.approval_level_id.min_amount, object.contract_id.currency_id)}\n"
"                            <br/>\n"
"                            <br/>\n"
"                            Payslip Approval information as below\n"
"                        </p>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        \n"
"                        <table class=\"table table-bordered\">\n"
"                            <thead>\n"
"                                <tr>\n"
"                                    <th scope=\"col\">Level</th>\n"
"                                    <th scope=\"col\">Approvers</th>\n"
"                                    <th scope=\"col\">Approved Date</th>\n"
"                                    <th scope=\"col\">Approved By</th>\n"
"                                    <th scope=\"col\">Status</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"                            % for line in object.approval_info_line:\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <th>${line.level}</th>\n"
"                                        <td>\n"
"                                            % if line.user_ids:\n"
"                                                % for user in line.user_ids:\n"
"                                                    <i>${user.name},</i>\n"
"                                                % endfor\n"
"\n"
"                                            % else:\n"
"                                                % for group in line.group_ids:\n"
"                                                    <i>${group.name},</i>\n"
"                                                % endfor\n"
"                                                \n"
"                                            % endif\n"
"                                        </td>\n"
"                                        <td>${line.approval_date}</td>\n"
"                                        <td>${line.approved_by.name}</td>\n"
"                                        <td>${line.status}</td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            % endfor\n"
"                        </table>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        if you are authorize approver as per approval level.<br/>\n"
"                        You can use the following link and approve the payslip<br/><br/>\n"
"\n"
"                        <div style=\"display: inline-block; margin: 15px; text-align: center\">\n"
"                            <a href=\"/mail/view?model=hr.payslip&amp;res_id = ${object.id}\" target=\"_blank\" style=\"padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">Payslip Ref: #${object.number}</a>\n"
"                        </div><br/>\n"
"                        Thanks.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: sh_all_in_one_hrms
#: model:mail.template,body_html:sh_all_in_one_hrms.sh_expired_medical_email_template
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <strong>Notification to expire Employee Medical Examination</strong>\n"
"                    <br/>\n"
"                    <br/>\n"
"                </p>\n"
"                <table style=\"font-family: 'Trebuchet MS', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%;\">\n"
"                    <tr>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">Employee Name</th>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">Description</th>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">Medical Type</th>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">Issued Date</th>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">\n"
"                            Expire Time in (Month)\n"
"                        </th>\n"
"                        <th style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left; background-color: #875a7b; color: white;\">\n"
"                            Expiry Date\n"
"                        </th>\n"
"                    </tr>\n"
"                    % for line in object.sh_expired_medical_type_ids:\n"
"                    <tr>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\"><span>${line.employee_id.name}</span></td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_description}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_medical_type_id.name}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_issue_date}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_expiry_month}</span>\n"
"                        </td>\n"
"                        <td style=\"border: 1px solid #ddd; padding: 8px; padding-top: 12px; padding-bottom: 12px; text-align: left;\">\n"
"                            <span>${line.sh_expiry_date}</span>\n"
"                        </td>\n"
"                    </tr>\n"
"                    % endfor\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

