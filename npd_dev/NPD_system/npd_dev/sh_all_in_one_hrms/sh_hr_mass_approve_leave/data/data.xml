<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.actions.server" id="sh_first_approve_multi_action">
        <field name="name">First Approval</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave" />
        <field name="groups_id" eval="[(4, ref('sh_all_in_one_hrms.group_enable_mass_approve_leave'))]" />
        <field name="state">code</field>
        <field name="code">records.action_first_approval()</field>
    </record>
    <record model="ir.actions.server" id="sh_second_approve_multi_action">
        <field name="name">Second Approval</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave" />
        <field name="groups_id" eval="[(4, ref('hr_holidays.group_hr_holidays_manager'))]" />
        <field name="state">code</field>
        <field name="code">records.action_second_approval()</field>
    </record>
</odoo>
