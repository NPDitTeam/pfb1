<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="entry_checklist_comp_rule">
        <field name="name">Entry Chacklist multi-company</field>
        <field name="model_id" ref="model_employee_entry_checklist" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record model="ir.rule" id="exit_checklist_comp_rule">
        <field name="name">Exit Chacklist multi-company</field>
        <field name="model_id" ref="model_employee_exit_checklist" />
        <field name="global" eval="True" />
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record id="group_enable_check_list" model="res.groups">
        <field name="name">Enable Employee Checklist</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>
</odoo>
