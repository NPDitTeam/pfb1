<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="paperformat_npd_debt_tracking_baankhiew_lost_qweb" model="report.paperformat">
        <field name="name">A4 Lost Invoice</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <report
            id="action_lost_invoice"
            string="ใบแจ้งหนี้/ใบวางบิลค่าปรับหาย"
            name="npd_debt_tracking_baankhiew_qweb.report_npd_debt_tracking_baankhiew_lost_qweb"
            model="npd.debt.tracking.baankhiew"
            report_type="qweb-pdf"
            print_report_name="'Lost Billing Note - %s' %(object.name)"
            paperformat="npd_debt_tracking_baankhiew_qweb.paperformat_npd_debt_tracking_baankhiew_lost_qweb"
    />


    <!-- Main Template for Lost Invoice -->
    <template id="report_npd_debt_tracking_baankhiew_lost_qweb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        .page {
                            position: relative;
                            min-height: 1030px;
                        }
                        .content-area {
                            padding-bottom: 280px;
                        }
                        .footer-area {
                            position: absolute;
                            bottom: 110px;
                            left: 0;
                            right: 0;
                            height: 1px;
                        }
                        .mt-1 { margin-top: 1rem; }
                        .mb-1 { margin-bottom: 1rem; }
                        .ml-45 { margin-left: 40px; }
                        .text-left { text-align: left; }
                        .text-right { text-align: right; }
                        .text-center { text-align: center; }
                        .text_bold { font-weight: 600; }
                        .table tbody tr td {
                            padding: 2px 4px !important;
                            line-height: 1.2 !important;
                        }
                        .table thead tr th {
                            padding: 4px !important;
                        }
                    </style>
                    
                    <div class="page">
                        <div class="content-area">
                            <t t-call="npd_debt_tracking_baankhiew_qweb.report_lost_header"/>
                        </div>
                        <div class="footer-area">
                            <t t-call="npd_debt_tracking_baankhiew_qweb.report_lost_footer"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>


    <!-- Header Template for Lost Invoice -->
    <template id="report_lost_header">
        <div class="row">
            <div class="col-2">
                <img src="web/binary/company_logo" class="img-responsive"/>
            </div>
            <div class="col-7">
                <table width="100%" class="ml-45">
                    <tr>
                        <td><strong class="a" style="font-size: 18px;"><span t-esc="doc.company_id.name"/></strong></td>
                    </tr>
                    <tr>
                        <td>
                            <span class="b" t-field="user.branch_id.address" style="line-height: 1.5;font-size: 13px;"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="b" style="font-size: 13px;">
                            <span t-if="user.branch_id.telephone == '00000'">(สำนักงานใหญ่)</span>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="col-3">
                <table width="100%">
                    <tr><td class="text-center"><strong class="a" style="font-size: 18px;">ใบแจ้งหนี้/ใบวางบิล</strong></td></tr>
                    <tr><td class="text-center"><strong class="a" style="font-size: 15px;">ค่าปรับหาย</strong></td></tr>
                    <tr><td class="text-center"><strong class="c" style="font-size: 14px;">INVOICE / BILLING NOTE</strong></td></tr>
                </table>
            </div>
        </div>
        <p style="font-size: 7px; color: white;">.</p>

        <!-- ข้อมูลลูกค้า -->
        <div class="row">
            <div class="col-6">
                <table width="100%">
                    <tr>
                        <td class="text_bold b" style="font-size: 13px; width: 110px;">ชื่อลูกค้า :</td>
                        <td class="b" style="font-size: 13px;"><span t-esc="doc.partner_name"/></td>
                    </tr>
                    <tr>
                        <td class="text_bold b" style="font-size: 13px;">ที่อยู่ :</td>
                        <td class="b" style="font-size: 13px;">
                            <span t-esc="doc.partner_street"/>
                            <span t-esc="doc.partner_street2"/>
                            <span t-esc="doc.partner_city"/>
                            <span t-esc="doc.partner_state_id.name"/>
                            <span t-esc="doc.partner_zip"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="text_bold b" style="font-size: 13px;">เบอร์โทรศัพท์ :</td>
                        <td class="b" style="font-size: 13px;"><span t-esc="doc.partner_phone or doc.partner_mobile"/></td>
                    </tr>
                    <tr>
                        <td class="text_bold b" style="font-size: 13px;">เลขที่ผู้เสียภาษี :</td>
                        <td class="b" style="font-size: 13px;"><span t-esc="doc.partner_vat"/></td>
                    </tr>
                </table>
            </div>
            <div class="col-6">
                <table width="100%">
                    <tr>
                        <td class="text-right text_bold b" style="font-size: 13px;">เลขที่ :</td>
                        <td class="text-right b" style="font-size: 13px; width: 110px;"><span t-esc="doc.name"/></td>
                    </tr>
                    <tr>
                        <td class="text-right text_bold b" style="font-size: 13px;">วันที่ :</td>
                        <td class="text-right b" style="font-size: 13px;"><span t-esc="doc.create_date.strftime('%d-%m-%Y')"/></td>
                    </tr>
                </table>
            </div>
        </div>

        <p style="font-size: 4px; color: white;">.</p>
        
        <!-- ตารางรายการค่าปรับหาย -->
        <table width="100%" class="table">
            <thead>
                <tr class="b" style="border-bottom: 1px solid black !important;">
                    <th width="5%" class="text-center" style="font-size: 13px;">ลำดับ</th>
                    <th width="15%" class="text-center" style="font-size: 13px;">เลขบิลคืน</th>
                    <th width="35%" class="text-left" style="font-size: 13px;">รายการสินค้า</th>
                    <th width="10%" class="text-right" style="font-size: 13px;">จำนวนปรับหาย</th>
                    <th width="12%" class="text-right" style="font-size: 13px;">ราคาต่อชิ้น</th>
                    <th width="13%" class="text-right" style="font-size: 13px;">ปรับหายรวม</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="line_no" t-value="0"/>
                <t t-foreach="doc.lost_line_ids" t-as="line">
                    <!-- วนลูปแสดงรายการสินค้าแต่ละชิ้น -->
                    <t t-set="detail_index" t-value="0"/>
                    <t t-foreach="line.detail_ids" t-as="detail">
                        <t t-set="detail_index" t-value="detail_index + 1"/>
                        <!-- เพิ่ม line_no เฉพาะรายการแรกของแต่ละ line -->
                        <t t-if="detail_index == 1">
                            <t t-set="line_no" t-value="line_no + 1"/>
                        </t>
                        <tr class="b">
                            <td width="5%" class="text-center" style="font-size: 13px; border-bottom: hidden;" t-att-style="'font-size: 13px; border-bottom: hidden; padding-top: 8px !important;' if detail_index == 1 else 'font-size: 13px; border-bottom: hidden;'">
                                <!-- แสดงลำดับเฉพาะแถวแรกของแต่ละ line -->
                                <span t-if="detail_index == 1" t-esc="line_no"/>
                            </td>
                            <td width="15%" class="text-center" t-att-style="'font-size: 13px; border-bottom: hidden; padding-top: 8px !important;' if detail_index == 1 else 'font-size: 13px; border-bottom: hidden;'">
                                <!-- แสดงเลขบิลคืนเฉพาะแถวแรกของแต่ละ line -->
                                <span t-if="detail_index == 1" t-esc="line.doc_id"/>
                            </td>
                            <td width="35%" class="text-left" t-att-style="'font-size: 13px; border-bottom: hidden; padding-top: 8px !important;' if detail_index == 1 else 'font-size: 13px; border-bottom: hidden;'">
                                <span t-esc="detail.product_name"/>
                            </td>
                            <td width="10%" class="text-right" t-att-style="'font-size: 13px; border-bottom: hidden; padding-top: 8px !important;' if detail_index == 1 else 'font-size: 13px; border-bottom: hidden;'">
                                <span t-esc="'{0:,.0f}'.format(detail.lost_qty)"/>
                            </td>
                            <td width="12%" class="text-right" t-att-style="'font-size: 13px; border-bottom: hidden; padding-top: 8px !important;' if detail_index == 1 else 'font-size: 13px; border-bottom: hidden;'">
                                <span t-esc="'{0:,.2f}'.format(detail.price_per_unit)"/>
                            </td>
                            <td width="13%" class="text-right" t-att-style="'font-size: 13px; border-bottom: hidden; padding-top: 8px !important;' if detail_index == 1 else 'font-size: 13px; border-bottom: hidden;'">
                                <span t-esc="'{0:,.2f}'.format(detail.lost_amount)"/>
                            </td>
                        </tr>
                    </t>
                    <!-- ถ้าไม่มี detail แสดงแค่ยอดรวมของ line -->
                    <t t-if="not line.detail_ids">
                        <t t-set="line_no" t-value="line_no + 1"/>
                        <tr class="b">
                            <td width="5%" class="text-center" style="font-size: 13px; border-bottom: hidden; padding-top: 8px !important;">
                                <span t-esc="line_no"/>
                            </td>
                            <td width="15%" class="text-center" style="font-size: 13px; border-bottom: hidden; padding-top: 8px !important;">
                                <span t-esc="line.doc_id"/>
                            </td>
                            <td width="35%" class="text-left" style="font-size: 13px; border-bottom: hidden; padding-top: 8px !important;">
                                ค่าปรับหาย
                            </td>
                            <td width="10%" class="text-right" style="font-size: 13px; border-bottom: hidden; padding-top: 8px !important;">
                                -
                            </td>
                            <td width="12%" class="text-right" style="font-size: 13px; border-bottom: hidden; padding-top: 8px !important;">
                                -
                            </td>
                            <td width="13%" class="text-right" style="font-size: 13px; border-bottom: hidden; padding-top: 8px !important;">
                                <span t-esc="'{0:,.2f}'.format(line.remaining_balance)"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
    </template>


    <!-- Footer Template for Lost Invoice -->
    <template id="report_lost_footer">
        <div style="border-bottom: 1px solid black;" class="mb-1"/>
        <div class="row">
            <div class="col-7">
                <table width="100%">
                    <tr><td class="text-left b" style="font-size: 13px;"><span class="text_bold">หมายเหตุ :</span> <span t-esc="doc.note or ''"/></td></tr>
                    <tr><td style="font-size: 3px; color: white;">.</td></tr>
                    <tr><td class="text-left text_bold b" style="font-size: 13px;">จำนวนเงิน(ตัวอักษร)</td></tr>
                    <tr><td class="text-center d" style="font-size: 15px;"><strong>(<span t-esc="doc.get_lost_baht_text_sheet()"/>)</strong></td></tr>
                </table>
            </div>
            <div class="col-3">
                <table width="100%">
                    <tr><td class="text-right b" style="font-size: 13px;"></td></tr>
                    <tr><td style="font-size: 3px; color: white;">.</td></tr>
                    <tr><td class="text-right b" style="font-size: 15px;"><strong>จำนวนเงินทั้งสิ้น :</strong></td></tr>
                </table>
            </div>
            <div class="col-2">
                <table width="100%">
                    <tr><td class="text-right b" style="font-size: 13px;"></td></tr>
                    <tr><td style="font-size: 3px; color: white;">.</td></tr>
                    <tr><td class="text-right b" style="font-size: 15px;"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_lost_residual)"/></strong></td></tr>
                </table>
            </div>
        </div>
        <div style="border-bottom: 1px solid black;" class="mt-1 mb-1"/>

        <p class="d" style="font-size: 15px; margin-bottom: 3px;"><strong>การชำระเงิน :</strong></p>
        <div style="padding-left: 40px;">
            <t t-if="request.db == 'NPD_S_Group_New'">
                <p class="b" style="font-size: 13px; margin: 0;">โอนเงินเข้าบัญชี : บริษัท นภดล เอส กรุ๊ป จํากัด ธนาคารไทยพาณิชย์ เลขที่บัญชี 186-222160-2</p>
                <p class="b" style="font-size: 13px; margin: 0;">สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม :บริษัท นภดล เอส กรุ๊ป จํากัด</p>
            </t>
            <t t-if="request.db == 'NPD_S_Group_New_v2'">
                <p class="b" style="font-size: 13px; margin: 0;">โอนเงินเข้าบัญชี : บริษัท นภดล เอส กรุ๊ป จํากัด ธนาคารไทยพาณิชย์ เลขที่บัญชี 186-222160-2</p>
                <p class="b" style="font-size: 13px; margin: 0;">สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม :บริษัท นภดล เอส กรุ๊ป จํากัด</p>
            </t>
            <t t-if="request.db == 'NPD_Steeltech_New'">
                <p class="b" style="font-size: 13px; margin: 0;">โอนเงินเข้าบัญชี : บริษัท เอ็นพีดี สตีลเทค จำกัด ธนาคารไทยพาณิชย์ เลขที่บัญชี 408-582058-4</p>
                <p class="b" style="font-size: 13px; margin: 0;">สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม : บริษัท เอ็นพีดี สตีลเทค จำกัด</p>
            </t>
            <t t-if="request.db == 'NPD_Logistics_New'">
                <p class="b" style="font-size: 13px; margin: 0;">โอนเงินเข้าบัญชี : บริษัท เอ็นพีดี โลจิสติกส์ จำกัด ธนาคารไทยพาณิชย์ เลขที่บัญชี 439-044811-6</p>
                <p class="b" style="font-size: 13px; margin: 0;">สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม :บริษัท เอ็นพีดี โลจิสติกส์ จำกัด</p>
            </t>
            <t t-if="request.db == 'NPD_Intertrading_New'">
                <p class="b" style="font-size: 13px; margin: 0;">โอนเงินเข้าบัญชี : บริษัท นภดล อินเตอร์เทรดดิ้ง จำกัด ธนาคารไทยพาณิชย์ เลขที่บัญชี 408-546107-1</p>
                <p class="b" style="font-size: 13px; margin: 0;">สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม :บริษัท นภดล อินเตอร์เทรดดิ้ง จำกัด</p>
            </t>
            <t t-if="request.db == 'NPD_Bangkok_New'">
                <p class="b" style="font-size: 13px; margin: 0;">โอนเงินเข้าบัญชี : บริษัท นภดล กรุงเทพ จำกัด ธนาคารไทยพาณิชย์ เลขที่บัญชี 186-224773-9</p>
                <p class="b" style="font-size: 13px; margin: 0;">สั่งจ่ายด้วยเช็คกรุณาสั่งจ่ายในนาม :บริษัท นภดล กรุงเทพ จำกัด</p>
            </t>
            <p class="b" style="font-size: 13px; margin: 0;">ค่าธรรมเนียมธนาคาร ผู้ชำระเงินเป็นผู้รับผิดชอบ</p>
        </div>

        <!-- ผู้วางบิล -->
        <table width="100%" style="margin-top: 8px;">
            <tr>
                <td width="65%"></td>
                <td width="35%" class="text-center">
                    <span style="font-size: 14px;">......................................................</span><br/>
                    <span class="c" style="font-size: 14px;">ผู้วางบิล</span><br/>
                    <span class="b" style="font-size: 14px;" t-esc="user.name"/>
                </td>
            </tr>
        </table>
    </template>

</odoo>
