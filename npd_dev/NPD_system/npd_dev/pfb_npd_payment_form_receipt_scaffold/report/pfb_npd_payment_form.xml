            <!-- ดึงยอดจาก invoice จริง (per-line) แล้วคำนวณสัดส่วน รองรับชำระไม่เต็ม -->
            <t t-set="inv_untaxed" t-value="sum(abs(i.amount_untaxed_signed) for i in doc.reconciled_invoice_ids)"/>
            <t t-set="inv_total" t-value="sum(abs(i.amount_total_signed) for i in doc.reconciled_invoice_ids)"/>
            <t t-set="inv_tax" t-value="inv_total - inv_untaxed"/>
            <t t-if="inv_total">
                <t t-set="total_vat" t-value="round(doc.total_amount * inv_tax / inv_total, 2)"/>
                <t t-set="total_untaxed_amount" t-value="doc.total_amount - total_vat"/>
            </t>
            <t t-else="">
                <t t-set="total_untaxed_amount" t-value="doc.total_amount / 1.07"/>
                <t t-set="total_vat" t-value="doc.total_amount - total_untaxed_amount"/>
            </t>
            <!-- ภาษีหัก ณ ที่จ่าย 5% (ค่าเช่า) คิดตามสัดส่วนยอดชำระจริง ใช้ค่าเดียวกันทุกจุดในใบเสร็จ
                 ปัดฐานก่อน VAT ให้เป็น 2 ตำแหน่งก่อนคิด 5% (round-half-up) เพื่อให้ตรงกับยอดในระบบ (1,550.775 -> 1,550.78) -->
            <t t-set="wht_rent" t-value="doc.compute_wht_rent_5(total_untaxed_amount)"/>
