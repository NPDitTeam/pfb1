<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="inherited_res_users_form" model="ir.ui.view">
        <field name="name">inherited.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signature']" position="after">
                <group>
                    <field name="api_token" readonly="1"/>
                    <button name="generate_api_token" string="Generate API Token" type="object" class="btn-primary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
