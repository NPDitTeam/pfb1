<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!--
            เลขรันกลางของเลขทะเบียนทรัพย์สิน ใช้เมื่อหมวดสินทรัพย์ไม่ได้ตั้งเลขรันของตัวเอง
            ถ้าหมวดไหนตั้งไว้แล้ว ระบบจะใช้ของหมวดนั้นก่อนเสมอ
        -->
        <record id="seq_npd_asset_number" model="ir.sequence">
            <field name="name">เลขทะเบียนทรัพย์สิน</field>
            <field name="code">npd.asset.number</field>
            <field name="prefix">AST-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>

    <!-- ตั้งตัวย่อตามบริษัทของฐานข้อมูลนี้ รันทุกครั้งที่อัพเดทโมดูล -->
    <function model="account.asset" name="_npd_setup_asset_sequence_prefix"/>

</odoo>
