<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_sale_order_report_invoice_wizard" model="ir.ui.view">
            <field name="name">sale.order.report.invoice.wizard.form</field>
            <field name="model">sale.order.report.invoice.wizard</field>
            <field name="arch" type="xml">
                <form string="🔍 เงื่อนไขรายงานใบแจ้งหนี้ค้างชำระ(สาขา)">
                    <sheet>
                        <div class="oe_title">
                            <h2>กำหนดเงื่อนไขในการดึงข้อมูล</h2>
                        </div>
                        <group>
                            <group string="📅 ช่วงเวลา">
                                <field name="date_from" placeholder="เว้นว่างเพื่อดูทั้งหมด"/>
                                <field name="date_to" placeholder="เว้นว่างเพื่อดูทั้งหมด"/>
                            </group>
                            <group string="🏢 ตัวกรอง">
                                <field name="branch_ids"
                                       widget="many2many_tags"
                                       placeholder="เลือกสาขา (เว้นว่างเพื่อดูทุกสาขา)"
                                       options="{'no_create': True}"/>
                                <field name="show_only_due"/>
                            </group>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> <strong>หมายเหตุ:</strong>
                                <ul>
                                    <li>ระบบจะลบข้อมูลเก่าทั้งหมดก่อนสร้างใหม่</li>
                                    <li>หากมีข้อมูลจำนวนมาก อาจใช้เวลาในการประมวลผล</li>
                                    <li>เว้นว่างช่องวันที่เพื่อดูข้อมูลทั้งหมด</li>
                                    <li>เว้นว่างสาขาเพื่อดูข้อมูลทุกสาขา</li>
                                </ul>
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate_report"
                                type="object"
                                string="🔍 ค้นหารายงาน"
                                class="btn-primary"/>
                        <button string="ยกเลิก"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_sale_order_report_invoice_wizard" model="ir.actions.act_window">
            <field name="name">รายงานใบแจ้งหนี้ค้างชำระ(สาขา)</field>
            <field name="res_model">sale.order.report.invoice.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_sale_order_report_invoice_wizard"/>
        </record>

        <!-- เมนูสำหรับเรียก Wizard -->
        <menuitem id="menu_sale_order_report_invoice_wizard"
                  name="รายงานใบแจ้งหนี้ค้างชำระ(สาขา)"
                  parent="menu_stock_dashboard_root"
                  action="action_sale_order_report_invoice_wizard"
                  sequence="14"/>
    </data>
</odoo>