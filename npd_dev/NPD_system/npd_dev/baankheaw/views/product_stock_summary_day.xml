<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- ====== Action หลัก: เปิดรายการสรุปต่อสินค้า ====== -->
    <record id="action_product_stock_summary_day" model="ir.actions.act_window">
      <field name="name">สรุปสต๊อกต่อสินค้า (รวมทุกสาขา) ตามรอบวัน</field>
      <field name="res_model">baankheaw.product_stock_summary_day</field>
      <field name="view_mode">tree,form</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p>📦 สรุป ตั้งต้น/ถูกเช่า/ปรับหาย/คงเหลือ ระดับ "สินค้า" รวมทุกสาขา</p>
      </field>
    </record>

    <!-- ====== Menu: ผูกกับเมนูรากของคุณ ====== -->
    <menuitem id="menu_product_stock_summary_day"
              name="สรุปสต๊อกต่อสินค้า (รวมทุกสาขา) ตามรอบวัน"
              parent="baankheaw.baankheaw_menu_root"
              action="action_product_stock_summary_day"
              sequence="31"
              groups="base.group_user"/>

    <!-- ====== Tree View ====== -->
    <record id="view_product_stock_summary_day_tree" model="ir.ui.view">
      <field name="name">baankheaw.product_stock_summary_day.tree</field>
      <field name="model">baankheaw.product_stock_summary_day</field>
      <field name="arch" type="xml">
        <tree string="สรุปสต๊อกต่อสินค้า (รวมทุกสาขา)ตามรอบวัน">
          <field name="pdn_id"/>
          <field name="product_name"/>
          <field name="branch_list"/>
          <field name="stock_begin_total"/>
          <field name="stock_rented_total"/>
          <field name="stock_lost_total"/>
          <field name="stock_remain_total"/>
        </tree>
      </field>
    </record>

    <!-- ====== Form View ====== -->
    <record id="view_product_stock_summary_day_form" model="ir.ui.view">
      <field name="name">baankheaw.product_stock_summary_day.form</field>
      <field name="model">baankheaw.product_stock_summary_day</field>
      <field name="arch" type="xml">
        <form string="สรุปสต๊อกต่อสินค้า (รวมทุกสาขา)ตามรอบวัน">
          <header>
            <button name="action_update_product_summary_day"
                    type="object"
                    string="อัปเดตข้อมูล"
                    class="oe_highlight"/>
          </header>
          <sheet>
            <group>
              <group string="ข้อมูลสินค้า">
                <field name="pdn_id"/>
                <field name="product_name"/>
                <field name="branch_list"/>
              </group>
              <group string="ราคา/คุณสมบัติ">
                <field name="price_per_day"/>
                <field name="price_per_month"/>
                <field name="guarantee"/>
                <field name="lost_price"/>
                <field name="weight"/>
              </group>
            </group>
            <group string="ยอดรวมทุกสาขา">
              <group>
                <field name="stock_begin_total"/>
                <field name="stock_rented_total"/>
              </group>
              <group>
                <field name="stock_lost_total"/>
                <field name="stock_remain_total"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

  </data>
</odoo>