<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_realtime_quotations" model="ir.actions.act_window">
        <field name="name">ใบเสนอราคาเช่า</field>
        <field name="res_model">baankheaw.quotation_summary</field>
        <field name="view_mode">tree,form</field>
