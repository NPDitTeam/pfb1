<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            ซ่อน menu ที่ซ้ำซ้อนจากโมดูล npd_all_customs
            (ซ้ำกับโมดูล pfb_npd_all_customs ที่ติดตั้งอยู่ก่อนแล้ว)

            หมายเหตุ: การแก้ไขนี้ตั้งค่า active=False เท่านั้น ไม่ได้ลบ record
            หากต้องการเปิดใช้งานกลับ: ไปที่ Settings → Technical → Menu Items
            ค้นหา menu แล้วติ๊ก Active กลับ
        -->

        <!-- ใบเสนอราคาเช่า (ซ้ำ) -->
        <record id="npd_all_customs.menu_quotations_rent" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <!-- ใบกำกับการเช่า (ซ้ำ) -->
        <record id="npd_all_customs.menu_sale_order_rent" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
