<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="context">{'search_default_my_quotation': 1}</field>
        <field name="domain">[('pfb_so_type','=','sale'),('name', 'like', 'QT%')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
            </p>
            <p>
                Once the quotation is confirmed by the customer, it becomes a sales order.
                <br/>
                You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <record id="action_quotations_with_onboarding_rent" model="ir.actions.act_window">
        <field name="name">Quotations Rent</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="context">{'search_default_my_quotation': 1,'default_pfb_so_type':'rent'}</field>
        <field name="domain">[('pfb_so_type','=','rent'),('name', 'like', 'QT%')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
            </p>
            <p>
                Once the quotation is confirmed by the customer, it becomes a sales order.
                <br/>
                You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>


    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="context">{}</field>
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel')),('pfb_so_type','=','sale'),('name', 'like', 'SO%')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
            </p>
            <p>
                Once the quotation is confirmed, it becomes a sales order.
                <br/>
                You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <record id="action_orders_rent" model="ir.actions.act_window">
        <field name="name">Sales Orders Rent</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="context">{'default_pfb_so_type':'rent'}</field>
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel')),('pfb_so_type','=','rent'),('name', 'like', 'SO%')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
            </p>
            <p>
                Once the quotation is confirmed, it becomes a sales order.
                <br/>
                You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <menuitem id="sale_quotations"
              name="Quotations"
              parent="sale.sale_order_menu"
              sequence="1" groups="sales_team.group_sale_salesman"/>

    <menuitem id="sale.menu_sale_quotations"
              name="Quotations - Sale"
              action="sale.action_quotations_with_onboarding"
              parent="pfb_npd_all_customs.sale_quotations"
              sequence="1" groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_quotations_rent"
              name="Quotations - Rent"
              action="action_quotations_with_onboarding_rent"
              parent="pfb_npd_all_customs.sale_quotations"
              sequence="2" groups="sales_team.group_sale_salesman"/>

    <menuitem id="sale_order"
              name="Orders"
              parent="sale.sale_order_menu"
              sequence="2" groups="sales_team.group_sale_salesman"/>

    <menuitem id="sale.menu_sale_order"
              name="Order - Sale"
              action="sale.action_orders"
              parent="pfb_npd_all_customs.sale_order"
              sequence="1" groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_sale_order_rent"
              name="Order - Rent"
              action="action_orders_rent"
              parent="pfb_npd_all_customs.sale_order"
              sequence="2" groups="sales_team.group_sale_salesman"/>

    <menuitem
            id="sale_order_line_menu.sale_order_line_menu"
            name="Order Lines"
            action="sale_order_line_menu.action_orders_lines"
            parent="sale.sale_order_menu"
            sequence="3"
    />

    <menuitem
            action="sale_invoice_plan.action_sale_invoice_plan"
            id="sale_invoice_plan.menu_sale_invoice_plan"
            parent="sale.sale_order_menu"
            sequence="4"/>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
<!--                <button name="%(sale.action_view_sale_advance_payment_inv)d" string="รับเงินประกัน"-->
<!--                        type="action" class="btn-primary"-->
<!--                        attrs="{'invisible': [('invoice_status', '!=', 'to invoice')]}"/>-->
                <button name="%(pfb_npd_all_customs.action_view_sale_rent_inv)d" string="รับเงินประกัน"
                        type="action" context="{'default_advance_payment_method': 'percentage'}"
                        attrs="{'invisible': [('state', '!=', 'sale')]}"/>
            </xpath>
            <xpath expr="//sheet//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_rent"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                            attrs="{'invisible': [('rent_count', '=', 0)]}">
                            <field name="rent_count" widget="statinfo" string="รับเงินประกัน"/>
                        </button>
            </xpath>

            <field name="partner_shipping_id" position="after">
                <field name="pfb_so_type" widget="radio"/>

                <field name="pfb_objective_id" attrs="{'invisible': [('pfb_so_type', '=', 'sale')]}"/>
                <field name="pfb_date_of_rent" context="{'pfb_date_of_rent':pfb_date_of_rent}"
                       attrs="{'invisible': [('pfb_so_type', '=', 'sale')]}"/>

            </field>

            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="after">
                <field name="pfb_so_rent_ok" invisible="1"/>
                <field name="pfb_date_of_rent" force_save="1"
                       attrs="{'pfb_so_rent_ok': [('pfb_so_rent_ok', '=', 0)]}"/>
                <field name="pfb_quantity" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom']" position="after">
                <field name="pfb_insurance_price" attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}"/>
            </xpath>

            <xpath expr="//tree/field[@name='product_template_id']" position="attributes">
                <attribute name="domain">[
                    ('pfb_rent_ok', '=', pfb_so_rent_ok),
                    '|', ('sale_ok', '=', True),
                    '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]
                </attribute>
            </xpath>

            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="after"
                   attrs="{'invisible': [('pfb_so_rent_ok', '=',0)]}">
                <group>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="pfb_amount_insurance" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="pfb_dis_amount_insurance" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="pfb_amount"/>
                        </div>
                        <field name="pfb_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                    </group>
                </group>
            </xpath>

            <!--            <xpath expr="//tree/field[@name='product_template_id']" position="attributes">-->
            <!--                <attribute name="context">-->
            <!--                    {-->
            <!--                    'partner_id': parent.partner_id,-->
            <!--                    'quantity': product_uom_qty,-->
            <!--                    'pricelist': parent.pricelist_id,-->
            <!--                    'uom':product_uom,-->
            <!--                    'company_id': parent.company_id,-->
            <!--                    'default_list_price': price_unit,-->
            <!--                    'default_pfb_date_of_rent': pfb_date_of_rent,-->
            <!--                    'default_description_sale': name-->
            <!--                    }-->
            <!--                </attribute>-->
            <!--            </xpath>-->
        </field>
    </record>
</odoo>
