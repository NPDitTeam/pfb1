<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="assets_common" name="l10n_ch_isr_report" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css" href="pfb_npd_payment_form_receipt/static/report.css"/>
        </xpath>
    </template>

    <record id="paperformat_payment_form_test" model="report.paperformat">
        <field name="name">A5 Custom</field>
        <field name="default" eval="False" />
        <field name="format">A5</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <report
            id="action_pfb_npd_payment_form_receipt"
            string="PFB NPD Payment Form Receipt"
            name="pfb_npd_payment_form_receipt.form_payment_npd_pfb"
            model="account.payment"
            report_type="qweb-pdf"
            print_report_name="'PFB NPD Receipt - %s' % (object.name)"
            paperformat="pfb_npd_payment_form_receipt.paperformat_payment_form_test"
    />

    <template id="so_form_header">
        <style>
            .font_weight {
                font-weight: 800;
            }
            .address-line {
                font-size: 13px;
                margin-top: 5px;
            }
            .tax-id {
                font-size: 13px;
                margin-top: -10px;
                display: block;
            }
            .header-container {
                display: flex;
                align-items: flex-start;
            }
            .company-info {
                margin-left: 40px;
            }
            .document-info {
                margin-top: 15px;
<!--                margin-left: -20px;-->
            }
            .text-date {
                font-size: 15px;
                margin-top: -10px
            }
            .date-info {
                margin-top: -10px;
            }
        </style>
        <div class="row line-distance">
            <div class="col-1">
                <img src="web/binary/company_logo" class="img-responsive" />
            </div>
            <div class="col-1"/>
            <div class="col-7 company-info">
                <b>
                    <h5><strong><span t-esc="doc.company_id.name"/></strong></h5>
                </b>
                <p class="address-line">
                    <h>
                        <span t-esc="doc.company_id.street"/>
                        <span t-esc="doc.company_id.street2"/>
                        <span t-esc="doc.company_id.city"/>
                        จังหวัด<span t-esc="doc.company_id.state_id.name"/>
                        <span t-esc="doc.company_id.zip"/>
                    </h>

                </p>
                <p class="phone-info">
                    <h>โทรศัพท์ / แฟกซ์ <span t-esc="doc.company_id.fax"/> โทร. <span t-esc="doc.company_id.phone"/></h>
                </p>
                <p class="number-info">
                    <h>เลขประจำตัวผู้เสียภาษี <span t-esc="doc.company_id.vat"/> (สำนักงานใหญ๋)</h>
                </p>
            </div>
<!--            <div class="col-1"></div>-->
            <div class="col-4">
                <table width="100%">
                    <tr style="">
                        <td style="display:block;width: 150px;text-align: center;padding-top: 5px;">
                            <p class="text-center document-info"><h4><strong>ใบเสร็จรับเงิน</strong></h4></p>
                            <p class="text-center"><h5><strong>Receipt</strong></h5></p>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row" style="margin-bottom: 20px;"></div>
    </template>

    <template id="so_form_title">
        <style>
            .container-table {
                width: 19.5cm;
                height: 11.5cm;
<!--                border: 1px solid black;-->
                padding: 5px;
                box-sizing: border-box;
                font-size: 14px;
            }
            .invoice-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
                font-size: 14px;
            }
            .invoice-table, .invoice-table th, .invoice-table td {
                border: 1px solid black;
                font-size: 14px;
            }
            .invoice-table th, .invoice-table td {
                padding: 5px;
<!--                text-align: right;-->
                vertical-align: top;
                font-size: 14px;
            }
            .bold {
                font-weight: bold;
                font-size: 14px;
            }
            .text-right {
                text-align: right;
                font-size: 14px;
            }
            .text-center {
                text-align: center;
                font-size: 14px;
            }
            .preserve-whitespace {
                white-space: pre;
            }
        </style>

        <table class="container-table invoice-table line-distance">
            <tr>
                <div style="display: flex; justify-content: space-between;">
                    <td colspan="2">
                        <p>
                            <span class="text-left">ชื่อลูกค้า :</span>
                            <span class="text-left"><span t-esc="doc.partner_id.name"/></span>
                        </p>
                        <p>
                            <span class="preserve-whitespace">        ที่อยู่ :</span>
                            <span t-esc="doc.partner_id.street"/>
                            <span t-esc="doc.partner_id.street2"/>
                            <span t-esc="doc.partner_id.city"/>
                            <span t-esc="doc.partner_id.state_id.name"/>
                            <span t-esc="doc.partner_id.zip"/>
                        </p>
                        <p>
                            <span class="preserve-whitespace">                      เลขประจำตัวผู้เสียภาษี</span>
                            <span t-esc="doc.partner_id.vat"/> (สำนักงานใหญ่)
                        </p>
                    </td>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <td colspan="2">
                        <p>
                            <span class="text-left">เลขที่ / NO.</span>
                            <span t-esc="doc.name"/>
                        </p>
                        <p>
                            <span class="text-left">วันที่ / DATE</span>
                            <span t-esc="doc.date.strftime('%d') + ' ' + {1: 'ม.ก.', 2: 'ก.พ.', 3: 'มี.ค.', 4: 'เม.ย.', 5: 'พ.ค.', 6: 'มิ.ย.', 7: 'ก.ค.', 8: 'ส.ค.', 9: 'ก.ย.', 10: 'ต.ค.', 11: 'พ.ย.', 12: 'ธ.ค.'}[int(doc.date.strftime('%m'))] + ' ' + str(int(doc.date.strftime('%Y')) + 543)[-2:]"/>
                        </p>
                    </td>
                </div>
            </tr>
            <tr>
                <th class="text-center" width="10%">รหัสสินค้า<br>ITEM CODE</br></th>
                <th class="text-center" width="65%">รายการ<br>DESCRIPTION</br></th>
                <th colspan="2" class="text-center">จำนวนเงิน<br>AMOUNT</br></th>
            </tr>
            <tr t-foreach="doc.invoice_ids" t-as="l">
<!--                <td class="text-center"><span t-esc="l.product_id.default_code"/></td>-->
                <td class="text-center"><span t-esc="l_index + 1"/></td>
                <td><span t-esc="l.name"/></td>
                <td colspan="2" class="text-right"><span t-esc="'{0:,.2f}'.format(l.paid_total)"/></td>
            </tr>
            <tr>
                <td colspan="2" class="text-left">หมายเหตุ : ในการชำระเงินด้วยเช็คใบเสร็จรับเงินจะสมบูรณ์ต่อเมื่อบริษัทฯ ได้รับเงินตามเช็คเรียบร้อยแล้ว</td>
                <td colspan="2" class="text-right" style="border-bottom: hidden;"></td>
            </tr>
            <tr>
                <td class="text-center">ตัวอักษร :</td>
                <td colspan="1" class="text-center"><span t-esc="doc.get_baht_text_form_receipt()"/></td>
                <td style="border-top: hidden;" colspan="2">
                    <span style="float: left;">จำนวนเงินทั้งสิ้น</span>
                    <span style="float: right;" t-esc="'{0:,.2f}'.format(doc.total_amount)"></span>
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <p>
                        ชำระเงินโดย
                    </p>
                    <p>
                        <input type="checkbox" class="preserve-whitespace"/> เงินสด
                    </p>
                    <p>
                        <input type="checkbox" class="preserve-whitespace"/> โอนเงิน <span t-esc="doc.company_id.name"/> ธนาคารไทยพาณิชย์ เลขที่บัญชี 186-224773-9
                    </p>
                    <p>
                        <input type="checkbox" class="preserve-whitespace"/> เช็ค
                    </p>
                </td>
                <td colspan="2" style="border-left: hidden;">
                    <p>
                        <div class="row" style="margin-bottom: 100px;"></div>
                    </p>
                    <p class="text-center">
                        ..............................................................................
                    </p>
                    <p class="text-center">
                        <span>ผู้รับเงิน / COLLECTOR</span>
                    </p>
                </td>
            </tr>
        </table>
    </template>

    <template id="form_payment_npd_pfb">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <table width="100%" border="1">
                        <tr>
                            <td>
<!--                                Header-->
                                <t t-call="pfb_npd_payment_form_receipt.so_form_header"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
<!--                                Title-->
                                <t t-call="pfb_npd_payment_form_receipt.so_form_title"/>
                            </td>
                        </tr>
                    </table>
                </t>
            </t>
        </t>
    </template>

</odoo>