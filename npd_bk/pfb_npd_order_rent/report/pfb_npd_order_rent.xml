<!--    ตาราง-->
    <template id="report_table">
    <style>
<!--        .table-row {-->
<!--            height: 370px; /* Adjust the height as needed */-->
<!--        }-->
        .table td {
        padding: 18px; /* ลด padding เพื่อให้ความสูงลดลง */
    }
        .border_report {
    border-bottom: 1px solid black !important;
    border-top: 1px solid black !important
}
    </style>
    <table width="100%" class="table" style="mt-1">
        <thead>
            <tr style="border-bottom: 1px solid black !important;">
                <th width="5%" class="text-center border_report">ลำดับ</th>
                <th width="30%" class="text-left  border_report">รายการสินค้า</th>
                <th width="15%" class="text-right border_report">น้ำหนักสินค้า</th>
                <th width="15%" class="text-right border_report">ราคาต่อสินค้า</th>
                <th width="15%" class="text-right border_report">จำนวน</th>
                <th width="20%" class="text-right  border_report">รวมเป็นเงิน</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="doc.order_line" t-as="l">
                <t t-set="number" t-vatue="number + (l.price_unit * l.product_uom_qty)"/>
                <tr class="table">
                    <td class="text-center"><span t-esc="l_index + 1"/></td>
                    <td class="text-left"><span t-esc="l.product_id.name"/></td>
<!--                    หาไม่เจอ-->
                    <td class="text-right"><span t-esc="'{0:,.2f}'.format(l.product_uom_qty)"/></td>
                    <td class="text-right"><span t-esc="'{0:,.2f}'.format(l.price_unit)"/></td>
                    <td class="text-right"><span t-esc="'{0:,.0f}'.format(l.product_uom_qty)"/></td>
                    <td class="text-right"><span t-esc="'{0:,.2f}'.format(l.price_subtotal)"/></td>
                </tr>
            </t>
        </tbody>
    </table>
    <div class="row" style="margin-bottom: 550px;"></div>
    </template>

