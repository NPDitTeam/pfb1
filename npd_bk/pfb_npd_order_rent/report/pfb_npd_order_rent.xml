                    </tr>
                    <tr>
                        <td class="font-size: 20px;"><strong>[ติดต่อ : ศาลายา 084-7512304]</strong></td>
                    </tr>
                </table>
            </div>        <!-- โลโก้บริษัท -->
            <div class="col-3">
                <table style="width: 100%;">
                    <tr>
