<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<!--        กำหนดค่ากระดาษ-->
    <record id="paperformat_pfb_npd_order_rent" model="report.paperformat">
        <field name="name">A4 Sample</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field> <!-- ระยะขอบด้านบนตั้งค่าเป็น 1 หน่วย -->
        <field name="margin_bottom">10</field> <!-- ระยะขอบด้านล่างตั้งค่าเป็น 5 หน่วย -->
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">90</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <!-- กำหนดขนาดตัวอักษรเป็น 12 -->
<!--        <field name="font_size">12</field>-->
    </record>

    <report
            id="action_order_rent"
            string="Rental Returns"
            name="pfb_npd_order_rent.report_pfb_npd_order_rent"
            model="sale.order"
            report_type="qweb-pdf"
            print_report_name="'Sale - %s' %(object.name)"
            paperformat="pfb_npd_order_rent.paperformat_pfb_npd_order_rent"
    />

