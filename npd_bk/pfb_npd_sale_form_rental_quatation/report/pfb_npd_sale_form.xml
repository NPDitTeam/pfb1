            </div>
        </div>
        <div class="row" style="margin-bottom: 5px;"></div>
    </template>

    <template id="so_form_footer_top_solve">
        <style>
            .rounded-square {
                border: 1px solid #000;
                border-radius: 10px;
                padding: 20px;
                width: 100%;
                font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
            }
