                        </tr>
                        <tr>
                            <td>
<!--                                Footer-->
                                <t t-call="pfb_npd_sale_form_rental_quatation.so_form_footer_top_total"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
<!--                                Footer-->
                                <t t-call="pfb_npd_sale_form_rental_quatation.so_form_footer_top_solve"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
<!--                                Footer-->
                                <t t-call="pfb_npd_sale_form_rental_quatation.so_form_footer"/>
                            </td>
                        </tr>
                    </table>
