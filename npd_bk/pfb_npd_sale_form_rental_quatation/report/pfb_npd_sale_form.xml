            .inline-text {
                display: inline-block;
                vertical-align: middle;
                margin-right: 10px;
            }
        </style>
        <div class="row">
            <div class="col-7">
                <div>
                    <table width="100%" style="font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;">
