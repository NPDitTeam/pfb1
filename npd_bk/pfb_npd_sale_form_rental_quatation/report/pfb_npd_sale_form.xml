<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="assets_common" name="l10n_ch_isr_report" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css" href="pfb_npd_sale_form_rental_quatation/static/report.css"/>
        </xpath>
    </template>

    <record id="paperformat_sale_form_test" model="report.paperformat">
        <field name="name">A4 Custom</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <report
            id="action_pfb_npd_sale_form_rental_quatation"
            string="ใบเสนอราคาเช่าสินค้า"
            name="pfb_npd_sale_form_rental_quatation.form_sale_npd_pfb"
            model="sale.order"
            report_type="qweb-pdf"
            print_report_name="'ใบเสนอราคาเช่าสินค้า - %s' % (object.name)"
            paperformat="pfb_npd_sale_form_rental_quatation.paperformat_sale_form_test"
    />

    <template id="so_form_header">
        <style>
            .font_weight {
                font-weight: 800;
            }
            .address-line {
                font-size: 13px;
                margin-top: 5px;
            }
            .tax-id {
                font-size: 13px;
                margin-top: -10px;
                display: block;
            }
            .header-container {
                display: flex;
                align-items: flex-start;
            }
            .company-info {
                margin-left: 40px;
            }
            .document-info {
                margin-top: 15px;
<!--                margin-left: -20px;-->
            }
            .text-date {
                font-size: 15px;
                margin-top: -10px
            }
            .date-info {
                margin-top: -10px;
            }
        </style>
        <div class="row">
            <div class="col-1">
                <img src="web/binary/company_logo" class="img-responsive" />
            </div>
            <div class="col-1"/>
            <div class="col-7 company-info">
                <h1 class="font_weight"><strong>ใบเสนอราคาเช่าสินค้า</strong></h1>
                <h6><strong><span t-esc="doc.company_id.name"/></strong></h6>
                <p class="address-line">
                    <strong>ที่อยู่ :</strong>
                    <strong><span t-esc="doc.company_id.street"/></strong>
                    <strong><span t-esc="doc.company_id.street2"/></strong>
                    <strong><span t-esc="doc.company_id.city"/></strong>
                    <strong>จังหวัด<span t-esc="doc.company_id.state_id.name"/></strong>
<!--                    <span t-esc="doc.company_id.state_id.code"/>-->
                    <strong><span t-esc="doc.company_id.zip"/></strong>
                </p>
                <p class="tax-id">
                    <h7><strong>เลขที่ผู้เสียภาษี : <span t-esc="doc.company_id.vat"/> (สำนักงานใหญ่)</strong></h7>
                </p>
            </div>
            <div class="col-4">
                <table width="100%">
                    <tr style="">
                        <td style="display:block;width: 150px;text-align: center;padding-top: 5px;">
                            <p class="text-center document-info"><h4><strong>เลขที่เอกสาร</strong></h4></p>
                            <p class="text-center"><strong><span t-esc="doc.name"/></strong></p>
                            <p class="text-center text-date"><strong>วันที่ทำเอกสาร</strong></p>
                            <p class="text-center date-info">
                                <span t-esc="doc.date_order.strftime('%d') + '-' + {1: 'Jan', 2: 'Feb', 3: 'Mar', 4: 'Apr', 5: 'May', 6: 'Jun', 7: 'Jul', 8: 'Aug', 9: 'Sep', 10: 'Oct', 11: 'Nov', 12: 'Dec'}[int(doc.date_order.strftime('%m'))] + '-' + doc.date_order.strftime('%Y')"/>
                            </p>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="row" style="margin-bottom: -10px;"></div>
    </template>

    <template id="so_form_title">
        <style>
            .rounded-square {
                border: 1px solid #000;
                border-radius: 10px;
                padding: 20px;
                width: 1000px;
                font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
<!--                margin: auto; /* Center align */-->
            }
            .preserve-whitespace {
                white-space: pre;
            }

            .text-partner {
                font-size: 14px;
            }
        </style>
        <div class="rounded-square">
            <div class="row">
                <div class="col-7">
                    <table width="100%" style="font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;">
                        <tr>
                            <td class="text-left text-partner"><strong>ชื่อบริษัท</strong> : <span t-esc="doc.partner_id.name"/></td>
                        </tr>
                        <tr>
                            <td class="text-left text-partner"><strong>ชื่อลูกค้า</strong> : -</td>
                        </tr>
                        <tr>
                            <td class="text-left text-partner"><strong>Line ID</strong> : -</td>
                        </tr>
                        <tr>
                            <td class="text-left text-partner"><strong>หน้างาน</strong> :
                                <span t-esc="doc.partner_id.street"/>
                                <span t-esc="doc.partner_id.street2"/>
                                <span t-esc="doc.partner_id.city"/>
                                <span t-esc="doc.partner_id.state_id.name"/>
                                <span t-esc="doc.partner_id.zip"/>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col-4">
                    <table width="200%">
                        <tr>
                            <td class="text-right text-partner preserve-whitespace"><strong>เบอร์โทร/Fax</strong> : </td>
                            <td class="text-left text-partner preserve-whitespace"><span t-esc="doc.partner_id.fax"/></td>
                        </tr>
                        <tr>
                            <td class="text-right text-partner preserve-whitespace"><strong>เบอร์โทร</strong> : </td>
                            <td class="text-left text-partner preserve-whitespace"><span t-esc="doc.partner_id.phone"/></td>
                        </tr>
                        <tr>
                            <td class="text-right text-partner preserve-whitespace"><strong>Email</strong> : </td>
                            <td class="text-left text-partner preserve-whitespace"><span t-esc="doc.partner_id.email"/></td>
                        </tr>
                        <tr>
                            <td class="text-right text-partner preserve-whitespace"><strong>จำนวนวันเช่า</strong> : </td>
                            <td class="text-center text-partner preserve-whitespace"><span t-field="doc.pfb_date_of_rent"/> วัน</td>
                        </tr>
                        <tr>
                            <td class="text-right text-partner preserve-whitespace"><strong>กำหนดยืมราคา</strong> : </td>
                            <td class="text-center text-partner preserve-whitespace"><span t-field="doc.payment_term_id"/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-7"/>
    </template>

    <template id="so_form_detail_top">
        <style>
            .preserve-whitespace {
                white-space: pre;
            }
            .line-distance {
                line-height: 1;
                font-size: 14px !important;
            }
            .small-font {
                font-size: 14px !important;
            }
            .border_report {
                border-bottom: 1px solid black !important;
                border-top: 1px solid black !important
            }
        </style>
        <table width="100%" class="table mt-1 mb-3">
            <thead>
                <tr style="border-bottom: 1px solid black !important;">
                    <th width="1%" class="text-left small-font number-col border_report">No.</th>
                    <th width="15%" class="text-center small-font pass-col border_report">รหัส</th>
                    <th width="20%" class="text-left small-font list-col border_report preserve-whitespace">รายการสินค้า</th>
                    <th width="9%" class="text-right small-font weight-col border_report">น้ำหนัก [กิโลกรัม]</th>
                    <th width="9%" class="text-right small-font rent-col border_report">ค่าเช่า [ชุด,ชิ้น]</th>
                    <th width="9%" class="text-right small-font quantity-col border_report">จำนวน [ชุด,ชิ้น]</th>
                    <th width="13%" class="text-right small-font rent-total-col border_report"><strong>รวมค่าเช่า</strong></th>
                    <th width="10%" class="text-right small-font guarantee-col border_report">ค่าประกัน [ชุด,ชิ้น]</th>
                    <th width="14%" class="text-right small-font guarantee-total-col border_report"><strong>รวมประกัน</strong></th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="doc.order_line" t-as="l">
                    <t t-set="multi" t-value="multi+l.pfb_quantity"/>
                    <t t-set="ply" t-value="ply+l.product_uom_qty"/>
                    <t t-set="wei" t-value="wei+l.second_uom_qty"/>
                    <tr>
                        <td class="text-right line-distance number-col"><span t-esc="l_index + 1"/></td>
                        <td class="text-right line-distance pass-col"><span t-esc="l.name.split(' ')[0]"/></td>
                        <td class="text-left line-distance list-col"><span t-esc="l.name.split(' ', 1)[1]"/></td>
                        <td class="text-right line-distance weight-col"><span t-esc="'{0:,.2f}'.format(l.second_uom_qty)"/></td>
                        <td class="text-right line-distance rent-col"><span t-esc="'{0:,.2f}'.format(l.pfb_quantity)"/></td>
                        <td class="text-right line-distance quantity-col"><span t-esc="'{0:,.0f}'.format(l.product_uom_qty)"/></td>
                        <td class="text-right line-distance rent-total-col"><span t-esc="'{0:,.2f}'.format(l.price_subtotal)"/></td>
                        <td class="text-right line-distance guarantee-col"><span t-esc="'{0:,.2f}'.format(l.pfb_insurance_price)"/></td>
                        <td class="text-right line-distance guarantee-total-col"><span t-esc="'{0:,.2f}'.format(l.pfb_quantity*l.pfb_insurance_price)"/></td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="so_form_detail">
        <table class="table mt-1 mb-3">
            <tbody>

            </tbody>
        </table>
        <div class="row" style="margin-bottom: 10px;"></div>
        <div class="mt-1" style="border-bottom: 1px solid black"></div>
        <div class="row" style="margin-bottom: 5px;"></div>
    </template>

    <template id="so_form_footer_top">
        <style>
            .rounded-square {
                border: 1px solid #000;
                border-radius: 10px;
                padding: 20px;
                width: 100%;
                font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
                margin: auto;
            }

            .text-left {
                text-align: left;
            }

            .text-right {
                text-align: right;
            }

            .mt-1 {
                margin-top: 1rem;
            }

            .mb-1 {
                margin-bottom: 1rem;
            }

            .mr-1 {
                margin-right: 1rem;
            }

            table {
                width: 97%;
            }
            .small-font {
                font-size: 14px !important;
            }
        </style>
        <div class="row">
            <div class="col-7">
                <div class="rounded-square">
                    <div>
                        <table>
                            <tr>
                                <td class="text-left small-font"><span t-raw="doc.note.replace('&lt;p&gt;', '').replace('&lt;/p&gt;', '')"/></td>
                            </tr>
                            <tr>
                                <td><div class="row" style="margin-bottom: 40px;"></div></td>
                            </tr>
                            <tr>
                                <td><div class="mt-1" style="border-bottom: 1px solid black"></div></td>
                            </tr>
                            <tr>
                                <td class="text-left small-font"><strong>เงื่อนไขการเช่าสินค้า :</strong></td>
                            </tr>
                            <tr>
                                <td class="small-font">1. ชำระค่าเช่า/เงินประกันสินค้าก่อนวันรับสินค้า เพื่อจัดเตรียมสินค้าให้พร้อม</td>
                            </tr>
                            <tr>
                                <td class="small-font">2. วางเงินประกันด้วย(เงินสด/BG-หนังสือค้ำประกันของธนาคาร)</td>
                            </tr>
                            <tr>
                                <td class="small-font">3. การรับสินค้า(รับสินค้าที่สาขา ไม่รวมค่าขนย้ายสินค้า ขึ้น-ลง)</td>
                            </tr>
                            <tr>
                                <td class="small-font">4. ระยะเวลาในการเช่าสินค้าอย่างน้อยตามจำนวนวันตามใบเสนอราคา</td>
                            </tr>
                            <tr>
                                <td class="small-font">5. กรณีต่อสัญญาเช่าต้องกระทำภายใน7วันก่อนครบกำหนด</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-1"></div>
            <div class="col-4">
                <div>
                    <table>
                        <tr>
                            <td class="text-right" style="font-size: 20px"><strong>ค่าเช่า :</strong></td>
                            <td class="text-right" style="font-size: 20px"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_untaxed)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right">ภาษีมูลค่าเพิ่ม 7 % :</td>
                            <td class="text-right"><span t-esc="'{0:,.2f}'.format(doc.amount_tax)"/></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 20px"><strong>รวมค่าเช่าทั้งสิ้น :</strong></td>
                            <td class="text-right" style="font-size: 20px"><strong><span t-esc="'{0:,.2f}'.format(doc.amount_total)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 20px"><strong>ค่าประกัน :</strong></td>
                            <td class="text-right" style="font-size: 20px"><strong><span t-esc="'{0:,.2f}'.format(doc.pfb_amount_insurance)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 20px"><strong>ส่วนลดค่าประกัน :</strong></td>
                            <td class="text-right" style="font-size: 20px"><strong><span t-esc="'{0:,.2f}'.format(doc.pfb_dis_amount_insurance)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right" style="font-size: 20px"><strong>ประกันสุทธิ :</strong></td>
                            <td class="text-right" style="font-size: 20px"><strong><span t-esc="'{0:,.2f}'.format(doc.pfb_amount)"/></strong></td>
                        </tr>
                        <tr>
                            <td class="text-right">ค่าขนส่ง :</td>
                            <td class="text-right" style="font-size: 20px"><span t-esc="'{0:,.2f}'.format(doc.shipping_cost)"/></td>
                        </tr>
                        <tr>
                            <td class="text-right">ค่าเช่าต่อวัน :</td>
                            <t t-set="total" t-value="sum([l.pfb_quantity * l.product_uom_qty for l in doc.order_line])"/>
                            <td class="text-right"><span t-esc="'{0:,.2f}'.format(total)"/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="row" style="margin-bottom: 5px;"></div>
    </template>

    <template id="so_form_footer_top_total">
        <style>
            .rounded-square {
                border: 1px solid #000;
                border-radius: 10px;
                padding: 20px;
                width: 100%;
                font-family: 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
            }
            .row {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .text-left {
                text-align: left;
            }
            .amount-text {
                font-size: 25px;
                font-weight: bold;
            }
            .move-text {
                margin: 0 20px;
                font-size: 25px;
            }
        </style>
        <div class="rounded-square">
            <div class="row">
                <div class="col-2" style="margin-top: 6px;">
                    <strong>รวมสุทธิ :</strong>
                </div>
