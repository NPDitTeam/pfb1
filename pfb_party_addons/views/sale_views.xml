<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add quotation's header which in minimum compare to order's -->
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">

            <xpath expr="/form/header" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('order_sequence','=',False)]}</attribute>
            </xpath>
            <xpath expr="/form/header" position="after">
                <header
                    name="quotation"
                    attrs="{'invisible': [('order_sequence','=',True)]}"
                >


<!--                    <button-->
<!--                        name="action_convert_to_order"-->

<!--                        class="oe_highlight"-->
<!--                        type="object"-->
<!--                        string="Convert to Order"-->
<!--                        attrs="{'invisible': [('state_sale', '!=', 'approved'),('state', '=', 'draft')]}"/>-->

                    <button
                        name="action_convert_to_order"

                        class="oe_highlight"
                        type="object"
                        string="Convert to Order"
                        attrs="{'invisible': [('button_convert_visible', '=', False)]}"/>

                    <button
                        name="action_cancel"
                        states="draft"
                        type="object"
                        string="Cancel"
                    />
                    <field
                        name="quotation_state"
                        widget="statusbar"
                        statusbar_visible="draft,done"
                        invisible="context.get('order_sequence', False)"
                    />
<!--                    <xpath expr="//header" position="inside">-->
<!--                        <field name="quotation_state" widget="statusbar" statusbar_visible="draft,waiting_to_approve,approved,done"/>-->
<!--                    </xpath>-->
                   <button name="action_waiting_to_approve"
        type="object"
        string="Send for Approval"

        class="btn-primary"
        attrs="{'invisible': [('button_convert_visible_send', '=', False)]}"/>



<!--       <button name="action_open_approval_popup"-->
<!--                   type="object"-->
<!--                   class="btn-success"-->
<!--                   string="Approve"-->
<!--                   attrs="{'invisible': [('button_visible', '=', False)]}" />-->

<button name="action_open_approval_popup"
            type="object"
            class="btn-success"
            string="Approve"
            attrs="{'invisible': [('button_visible', '=', False)]}" />

        <button name="action_reject"
                type="object"
                class="btn-warning"
                string="Reject"
                attrs="{'invisible': [('button_visible_reject', '=', False)]}" />



                </header>
            </xpath>

            <field name="partner_shipping_id" position="after">
                <field name="order_sequence" invisible="1" />
                <field
                    name="quote_id"
                    attrs="{'invisible': [('order_sequence','=',False)]}"
                    context="{'order_sequence': False}"
                />


                <field
                    name="order_id"
                    attrs="{'invisible': [('order_sequence','=',True)]}"
                    context="{'order_sequence': True}"
                />
                <field name="approver_id" readonly="1" />
                <field name="state_sale" readonly="1"/>
                <field name="button_visible" invisible="1"/>
                <field name="button_convert_visible" invisible="1"/>
                <field name="button_convert_visible_send" invisible="1"/>
                <field name="button_visible_reject" invisible="1"/>
            </field>
            <xpath
                expr="/form/sheet/notebook/page/field[@name='order_line']"
                position="attributes"
            >
                <attribute name="context">{'order_sequence': order_sequence}</attribute>
            </xpath>
        </field>
    </record>
    <!-- Assign order_sequence to context -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field
            name="context"
        >{'default_order_sequence': False, 'order_sequence': False}</field>
        <field name="domain">[('order_sequence', '=', False)]</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field
            name="context"
        >{'default_order_sequence': True, 'order_sequence': True}</field>
        <field name="domain">[('order_sequence', '=', True)]</field>
    </record>
</odoo>
